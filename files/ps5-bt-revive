#!/bin/bash
# IW620: Bluetooth can hang after a warm reboot while Wi-Fi works; reload btusb once if it's down after ~30 s.
set -u
# Only for the IW620 (original PS5); elsewhere it would reload btusb under USB dongles too.
grep -qs 1286 /sys/bus/usb/devices/*/idVendor || exit 0
# Not powered without timeouts means the user switched Bluetooth off.
healthy() {
    H=$(for h in /sys/class/bluetooth/hci*; do u=$(readlink -f $h/device/..); [ "$(cat $u/idVendor 2>/dev/null)" = 1286 ] && basename $h && break; done)
    [ -n "$H" ] || return 1
    timeout 8 btmgmt --index ${H#hci} info 2>/dev/null | grep -q "current settings:.*powered" && return 0
    ! journalctl -k -b --no-pager 2>/dev/null | grep -q "$H: command 0x[0-9a-f]* tx timeout"
}
for _ in $(seq 6); do
    healthy && { echo "Bluetooth adapter OK"; exit 0; }
    sleep 5
done
echo "Bluetooth adapter not responding, reloading btusb"
modprobe -r btusb 2>/dev/null || { echo "btusb can't be unloaded (built in?)"; exit 0; }
sleep 2
modprobe btusb
for _ in $(seq 6); do
    sleep 5
    healthy && { echo "Bluetooth adapter back"; exit 0; }
done
echo "Bluetooth adapter still not responding; a cold start (power off, run the loader again) resets it"
exit 0
