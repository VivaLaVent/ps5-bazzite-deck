#!/bin/sh
# One DualSense for the PS5 system and Linux: Linux's own Bluetooth address, so the controller keeps one
# pairing for each (on separate profiles). On by default on every console (v1.8.9). MediaTek and PS5 Pro:
# set through the kernel; IW620: a vendor command to the Wi-Fi/Bluetooth combo chip at boot, which doesn't
# survive a warm restart, so on IW620 restarts go through the PS5 system while it's on.
#   ps5-bt-address on | off | status
OFF=/etc/ps5-bazzite-deck/bt-address-off
case "$1" in
    on)  sudo rm -f "$OFF" && echo "Linux-only Bluetooth address on from the next boot: pair your controllers with Linux once more afterwards"
         lsusb 2>/dev/null | grep -q 1286:2059 && echo "IW620: restarts go through the PS5 system while this is on (no warm restarts)." ;;
    off) sudo mkdir -p /etc/ps5-bazzite-deck && sudo touch "$OFF" && echo "Linux-only Bluetooth address off from the next boot: the controller keeps one pairing, shared with the PS5 system" ;;
    *)   if [ -e "$OFF" ]; then
             echo "Linux-only Bluetooth address: off (ps5-bt-address on to switch it on)"
         else
             echo "Linux-only Bluetooth address: on"
             cur=$(btmgmt --index 0 info 2>/dev/null | awk '$1 == "addr" { print toupper($2); exit }')
             [ -n "$cur" ] && echo "controller address now: $cur (the second character differs from the PS5 system's address when it's applied)"
         fi ;;
esac
