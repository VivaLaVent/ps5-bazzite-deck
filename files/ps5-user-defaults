#!/bin/bash
# Once per user: Desktop Mode as Steam's default login mode, and Steam's own startup and suspend videos instead of
# Bazzite's (custom videos stay).
set -u
S=${XDG_STATE_HOME:-$HOME/.local/state}/ps5-bazzite-deck
mkdir -p "$S"
if [ ! -e "$S/desktop-default" ] && command -v steamosctl >/dev/null; then
    for _ in $(seq 1 6); do
        timeout 5 steamosctl set-default-login-mode desktop >/dev/null 2>&1 && { touch "$S/desktop-default"; break; }
        sleep 2
    done
fi
if [ ! -e "$S/steam-videos" ]; then
    V=$HOME/.local/share/Steam/config/uioverrides/movies
    mkdir -p "$V"
    touch "$V/bazzite_novideo"
    for f in "$V"/*.webm; do
        [ -f "$f" ] || continue
        for b in /usr/share/ublue-os/bazzite/*.webm; do
            cmp -s "$f" "$b" && { rm -f "$f"; break; }
        done
    done
    touch "$S/steam-videos"
fi
