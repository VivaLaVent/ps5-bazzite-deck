#!/bin/bash
# Once per user: Desktop Mode as Steam's default login mode, and Steam's own startup and suspend videos in place of
# Bazzite's, as overrides: Steam plays an override when Game Mode starts (custom videos stay).
set -u
S=${XDG_STATE_HOME:-$HOME/.local/state}/ps5-bazzite-deck
mkdir -p "$S"
if [ ! -e "$S/desktop-default" ] && command -v steamosctl >/dev/null; then
    for _ in $(seq 1 6); do
        timeout 5 steamosctl set-default-login-mode desktop >/dev/null 2>&1 && { touch "$S/desktop-default"; break; }
        sleep 2
    done
fi
M=$HOME/.local/share/Steam/steamui/movies
if [ ! -e "$S/steam-videos-own" ] && [ -f "$M/deck_startup.webm" ]; then
    V=$HOME/.local/share/Steam/config/uioverrides/movies
    mkdir -p "$V"
    touch "$V/bazzite_novideo"
    for f in "$V"/*.webm; do
        [ -f "$f" ] || continue
        for b in /usr/share/ublue-os/bazzite/*.webm; do
            cmp -s "$f" "$b" && { rm -f "$f"; break; }
        done
    done
    for n in bigpicture_startup deck_startup oled_startup steam_os_startup; do
        [ -e "$V/$n.webm" ] || cp "$M/$n.webm" "$V/" 2>/dev/null || cp "$M/deck_startup.webm" "$V/$n.webm"
    done
    for n in deck-suspend-animation deck-suspend-animation-from-throbber oled-suspend-animation \
             oled-suspend-animation-from-throbber steam_os_suspend steam_os_suspend_from_throbber; do
        [ -e "$V/$n.webm" ] || [ ! -f "$M/$n.webm" ] || cp "$M/$n.webm" "$V/"
    done
    touch "$S/steam-videos-own"
fi
