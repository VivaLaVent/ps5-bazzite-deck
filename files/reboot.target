# Installed only while warm reboot is on: every reboot loads the boot partition's kernel first,
# and ps5-reboot.service kexecs into it.
[Unit]
Description=System Reboot
Documentation=man:systemd.special(7)
DefaultDependencies=no
Requires=ps5-kexec-prepare.service ps5-reboot.service
After=ps5-reboot.service
AllowIsolate=yes
JobTimeoutSec=30min
JobTimeoutAction=reboot-force

[Install]
Alias=ctrl-alt-del.target
