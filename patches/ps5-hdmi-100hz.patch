PS5 HDMI: 100 Hz modes behind hdmi.modes_100hz=1 (off by default)

FLAVA3 only, each offered only when the display goes to 100 Hz or more and its clock limit allows:
1440p100 (CVT reduced blanking, or a 148.5 kHz timing when the display's own 1440p100 is slower), 1080p100 (VIC 64), 4K100 (VIC 117) over FRL through the 4K120 guard
and fallback. As the v2.1.x test patch.
---
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 4c8e63a58..38712bd1a 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -5375,12 +5375,13 @@ static void dm_ps5_frl_fallback_work_func(struct work_struct *work)
 		    !connector->state->crtc->state->active)
 			continue;
 		cur = &connector->state->crtc->state->mode;
-		if (drm_match_cea_mode(cur) != 118)
+		if (drm_match_cea_mode(cur) != 118 && drm_match_cea_mode(cur) != 117)
 			continue;
 		changed = true;
 		list_for_each_entry(mode, &connector->modes, head) {
 			if (mode->hdisplay != cur->hdisplay || mode->vdisplay != cur->vdisplay ||
 			    mode->flags & DRM_MODE_FLAG_INTERLACE || drm_match_cea_mode(mode) == 118 ||
+			    drm_match_cea_mode(mode) == 117 ||
 			    !isHdmiModeValid(mode, amdgpu_force_1080p))
 				continue;
 			if (!best || drm_mode_vrefresh(mode) > drm_mode_vrefresh(best))
diff --git a/drivers/ps5/hdmi.c b/drivers/ps5/hdmi.c
index 8284b1d10..c5c2c7a1e 100755
--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -889,9 +889,15 @@ static bool frl_4k120 = true;
 module_param(frl_4k120, bool, 0644);
 MODULE_PARM_DESC(frl_4k120, "Offer 3840x2160 at 120 Hz over HDMI 2.1 FRL on FLAVA3 consoles (default on; 0 never offers it)");
 
+/* FLAVA3: 1080p100 (VIC 64), 1440p100 (CVT-RB) and 2160p100 over FRL (VIC 117, Sony's index 0x0a) */
+static bool modes_100hz;
+module_param(modes_100hz, bool, 0444);
+MODULE_PARM_DESC(modes_100hz, "Offer 100 Hz modes on FLAVA3 consoles where the display supports them (default off)");
+
 static bool ps5_mode_frl(u8 vic)
 {
-	return frl_4k120 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 && vic == 118;
+	return frl_4k120 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 &&
+	       (vic == 118 || (vic == 117 && modes_100hz));
 }
 
 /*
@@ -1097,7 +1103,7 @@ static void setHdmiBasicVideoConfigFlava3(const struct drm_display_mode *mode,
 	i2c_write(0x7009, 0x00);
 	i2c_write(0x7040, 0x42);
 	i2c_write(0x7225, 0x28);
-	if (vic == 16 || vic == 63) {
+	if (vic == 16 || vic == 63 || vic == 64) {
 		/* Set VIC and content type */
 		i2c_write_data(0x7227, (u8[]){vic, 0x00}, 2);
 		i2c_write_data(0x7070, (u8[]){vic, vic, 0x00, 0x00, 0x00, 0x00}, 6);
@@ -1914,7 +1920,9 @@ bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
 		if ((mode->clock == 241500 || mode->clock == 241700) && mode->vtotal == 1481)
 			return true;	/* 1440p60, VESA DMT reduced blanking */
 		return hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 &&
-		       mode->clock == 497750 && mode->vtotal == 1525;	/* 1440p120, CVT-RB */
+		       ((mode->clock == 497750 && mode->vtotal == 1525) ||	/* 1440p120, CVT-RB */
+			(modes_100hz && mode->clock == 410500 && mode->vtotal == 1510) ||	/* 1440p100 */
+			(modes_100hz && mode->clock == 403920 && mode->vtotal == 1485));	/* 1440p100, 148.5 kHz */
 	}
 
 	switch (vic) {
@@ -1922,6 +1930,10 @@ bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
 	case 63: /* 1080p120 */
 	case 97: /* 2160p60 */
 		return true;
+	case 64: /* 1080p100 */
+		return modes_100hz && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3;
+	case 117: /* 2160p100, FRL */
+		return ps5_mode_frl(vic) && frl_offer_ok() && mode->clock == 1188000;
 	case 118: /* 2160p120, FRL */
 		return ps5_mode_frl(vic) && frl_offer_ok();
 	}
@@ -1940,6 +1952,19 @@ static const struct drm_display_mode ps5_1440p60 = {
 		 DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NVSYNC)
 };
 
+static const struct drm_display_mode ps5_1440p100 = {
+	DRM_MODE("2560x1440", DRM_MODE_TYPE_DRIVER, 410500,
+		 2560, 2608, 2640, 2720, 0, 1440, 1443, 1448, 1510, 0,
+		 DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NVSYNC)
+};
+
+/* 1440p100 for displays whose own 100 Hz mode stays below 410.5 MHz (150 kHz line rate limit) */
+static const struct drm_display_mode ps5_1440p100_short = {
+	DRM_MODE("2560x1440", DRM_MODE_TYPE_DRIVER, 403920,
+		 2560, 2608, 2640, 2720, 0, 1440, 1443, 1448, 1485, 0,
+		 DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NVSYNC)
+};
+
 static const struct drm_display_mode ps5_1440p120 = {
 	DRM_MODE("2560x1440", DRM_MODE_TYPE_DRIVER, 497750,
 		 2560, 2608, 2640, 2720, 0, 1440, 1443, 1448, 1525, 0,
@@ -1976,6 +2001,7 @@ int ps5_hdmi_add_modes(struct drm_connector *connector)
 	int tmds = info->max_tmds_clock ? info->max_tmds_clock : 340000;
 	int max_hz = info->monitor_range.max_vfreq;
 	bool has_1440 = false, has_2160 = false;
+	int edid_1440p100 = 0;
 	struct drm_display_mode *m;
 	int added = 0;
 
@@ -1986,6 +2012,8 @@ int ps5_hdmi_add_modes(struct drm_connector *connector)
 		max_hz = max(max_hz, drm_mode_vrefresh(m));
 		if (m->vdisplay >= 1440 && m->hdisplay >= 2560)
 			has_1440 = true;
+		if (m->hdisplay == 2560 && m->vdisplay == 1440 && drm_mode_vrefresh(m) == 100)
+			edid_1440p100 = m->clock;
 		if (m->vdisplay >= 2160 && m->hdisplay >= 3840)
 			has_2160 = true;
 		m->type &= ~DRM_MODE_TYPE_PREFERRED;
@@ -2001,6 +2029,14 @@ int ps5_hdmi_add_modes(struct drm_connector *connector)
 	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 && has_1440 && max_hz >= 119 &&
 	    tmds >= 497750)
 		added += ps5_add_mode(connector, drm_mode_duplicate(dev, &ps5_1440p120));
+	if (modes_100hz && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 && max_hz >= 100) {
+		if (tmds >= 297000)
+			added += ps5_add_mode(connector, drm_display_mode_from_cea_vic(dev, 64));
+		if (has_1440 && edid_1440p100 && edid_1440p100 < 410500)
+			added += ps5_add_mode(connector, drm_mode_duplicate(dev, &ps5_1440p100_short));
+		else if (has_1440 && tmds >= 410500)
+			added += ps5_add_mode(connector, drm_mode_duplicate(dev, &ps5_1440p100));
+	}
 
 	list_for_each_entry(m, &connector->probed_modes, head) {
 		if (drm_match_cea_mode(m) == 16) {
