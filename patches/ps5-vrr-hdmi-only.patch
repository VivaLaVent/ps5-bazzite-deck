PS5 VRR: only for displays with HDMI VRR, as on the PS5 system

The HDMI chip's VRR follow mode is HDMI VRR. A display that announces only AMD FreeSync (no
VRR range in its HDMI Forum block) got VRR anyway, from the FreeSync block's range, and the
FreeSync-only AOC Q27G2G3R4B (Storm) resynced and blanked on every refresh change at
1080p120, 1440p60 and 1440p120. The PS5 system only supports HDMI VRR too. Such displays
aren't offered VRR any more; the log says why.
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -1395,7 +1395,14 @@
 	if (hf_min >= 1 && hf_max > hf_min + 10) {
 		*min_hz = hf_min; *max_hz = hf_max; *src = "HDMI VRR range";
 	} else if (amd_min >= 1 && amd_max > amd_min + 10) {
-		*min_hz = amd_min; *max_hz = amd_max; *src = "FreeSync block";
+		/*
+		 * a display that announces only AMD FreeSync, without HDMI VRR, isn't
+		 * offered VRR, as on the PS5 system (which supports HDMI VRR only). The HDMI chip's
+		 * VRR follow mode is HDMI VRR; a FreeSync-only monitor resynced on every refresh
+		 * change and blanked (an AOC Q27G2G3R4B, at 1080p120, 1440p60 and 1440p120).
+		 */
+		*src = "the display announces only FreeSync, no HDMI VRR";
+		return -ENODATA;
 	} else {
 		return -ENODATA;
 	}
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -4158,8 +4158,9 @@
 		if (key != ps5_vrr_logged) {
 			ps5_vrr_logged = key;
 			drm_info(connector->dev, "PS5 VRR: %s, range %d-%d Hz (%s)\n",
-				 freesync_capable ? "available" : "not available (no VRR range in the EDID)",
-				 lo, hi, freesync_capable ? src : "VRR/FreeSync off in the TV's settings?");
+				 freesync_capable ? "available" : "not available",
+				 lo, hi, freesync_capable || strcmp(src, "none") ? src :
+				 "no VRR range in the EDID: VRR off in the TV's settings?");
 		}
 	} else if (ps5_dm_is_hdmi_connector(amdgpu_dm_connector)) {
 		static bool ps5_vrr_off_logged;
