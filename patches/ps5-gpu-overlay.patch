PS5: expose collision-free GPU telemetry                 [ps5-bazzite-deck]

AMDGPU normally obtains GPU load and hwmon telemetry from the SMU. Sony's
firmware does not provide the normal metrics table, so the PS5 overlay
patch uses DRM GFX busy accounting for load and the shared SoC sensor for
edge temperature.

Keep those fallbacks, but integrate them differently when Viola firmware is
active on PS5 Pro:

1. Move the bounded 500 ms busy-percentage calculation next to the existing
   PS5 DRM busy-time helper so both reporting paths use the same value.
2. Report AMDGPU_PP_SENSOR_GPU_LOAD from the Viola-selected Cyan Skillfish
   sensor callback. AMDGPU can then own its standard gpu_busy_percent file.
3. Do not register the display driver's custom gpu_busy_percent fallback on
   Viola. Registering both files produces -EEXIST and removes AMDGPU's
   attribute group during cleanup. Keep the custom fallback unchanged for
   Cyan firmware, including base/Slim consoles and PS5 Pro fallback boots.
4. Mark gpu_metrics unsupported only with Viola firmware. Otherwise, the
   node opens successfully but every read returns -EOPNOTSUPP. MangoHud
   0.8.4 then treats the empty table as valid and overwrites correct sysfs
   load and temperature values with zero.

The temperature implementation is unchanged. Non-Viola PS5 paths and
non-PS5 AMDGPU devices keep their existing behavior.
---
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_fdinfo.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_fdinfo.c
index 23eb228..1b0baa0 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_fdinfo.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_fdinfo.c
@@ -129,6 +129,10 @@ void amdgpu_show_fdinfo(struct drm_printer *p, struct drm_file *file)
 }
 
 #ifdef CONFIG_X86_PS5
+static DEFINE_MUTEX(ps5_busy_lock);
+static ktime_t ps5_busy_last_t;
+static u64 ps5_busy_last_ns;
+static u32 ps5_busy_pct;
 ktime_t amdgpu_ps5_get_gfx_busy_ns(struct pci_dev *pdev)
 {
 	struct drm_device *ddev = pci_get_drvdata(pdev);
@@ -154,4 +158,29 @@ ktime_t amdgpu_ps5_get_gfx_busy_ns(struct pci_dev *pdev)
 	return total;
 }
 EXPORT_SYMBOL_GPL(amdgpu_ps5_get_gfx_busy_ns);
+
+u32 amdgpu_ps5_get_gfx_busy_percent(struct pci_dev *pdev)
+{
+	ktime_t now = ktime_get();
+	u32 pct;
+
+	mutex_lock(&ps5_busy_lock);
+	if (!ps5_busy_last_t || ktime_ms_delta(now, ps5_busy_last_t) >= 500) {
+		u64 busy = ktime_to_ns(amdgpu_ps5_get_gfx_busy_ns(pdev));
+
+		if (ps5_busy_last_t) {
+			s64 dt = ktime_to_ns(ktime_sub(now, ps5_busy_last_t));
+			u64 db = busy > ps5_busy_last_ns ? busy - ps5_busy_last_ns : 0;
+
+			ps5_busy_pct = dt > 0 ?
+				min_t(u64, div64_u64(db * 100, dt), 100) : 0;
+		}
+		ps5_busy_last_t = now;
+		ps5_busy_last_ns = busy;
+	}
+	pct = ps5_busy_pct;
+	mutex_unlock(&ps5_busy_lock);
+
+	return pct;
+}
 #endif
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 0354a8a..c9ba4ca 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -88,6 +88,8 @@
 #include <linux/sort.h>
 
 #ifdef CONFIG_X86_PS5
+#include <linux/hwmon.h>
+#include <asm/amd/node.h>
 #include <linux/ps5.h>
 #endif
 
@@ -464,6 +466,84 @@ static int amdgpu_dm_init_power_module(struct amdgpu_display_manager *dm)
 	return 0;
 }
 
+#ifdef CONFIG_X86_PS5
+/*
+ * gpu_busy_percent fallback for PS5 firmware without an SMU load sensor.
+ * Viola reports the same DRM-accounting load through AMDGPU's standard sensor
+ * path instead, so this custom attribute must not be created there.
+ */
+
+static ssize_t ps5_gpu_busy_percent_show(struct device *d, struct device_attribute *attr,
+					 char *buf)
+{
+	return sysfs_emit(buf, "%u\n",
+			  amdgpu_ps5_get_gfx_busy_percent(to_pci_dev(d)));
+}
+static struct device_attribute ps5_dev_attr_gpu_busy =
+	__ATTR(gpu_busy_percent, 0444, ps5_gpu_busy_percent_show, NULL);
+
+/*
+ * GPU temperature for the PS5. amdgpu's hwmon sensors also come from the SMU,
+ * so there are none. CPU and GPU are one die, and its one temperature sensor
+ * is what k10temp reports as Tctl; read the same register (SMN 0x59800, same
+ * decoding as k10temp) and report it as the GPU's "edge" temperature, so
+ * overlays show the chip temperature for the GPU too.
+ */
+#define PS5_SMN_REPORTED_TEMP_CTRL	0x00059800
+
+static int ps5_soc_temp(long *val)
+{
+	u32 regval;
+
+	if (amd_smn_read(0, PS5_SMN_REPORTED_TEMP_CTRL, &regval))
+		return -EIO;
+	*val = (regval >> 21) * 125;
+	if ((regval & BIT(19)) || (regval & GENMASK(17, 16)) == GENMASK(17, 16))
+		*val -= 49000;
+	return 0;
+}
+
+static umode_t ps5_hwmon_is_visible(const void *data, enum hwmon_sensor_types type,
+				    u32 attr, int channel)
+{
+	return type == hwmon_temp && (attr == hwmon_temp_input || attr == hwmon_temp_label) ?
+	       0444 : 0;
+}
+
+static int ps5_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
+			  u32 attr, int channel, long *val)
+{
+	if (type == hwmon_temp && attr == hwmon_temp_input)
+		return ps5_soc_temp(val);
+	return -EOPNOTSUPP;
+}
+
+static int ps5_hwmon_read_string(struct device *dev, enum hwmon_sensor_types type,
+				 u32 attr, int channel, const char **str)
+{
+	*str = "edge";
+	return 0;
+}
+
+static const struct hwmon_channel_info * const ps5_hwmon_info[] = {
+	HWMON_CHANNEL_INFO(temp, HWMON_T_INPUT | HWMON_T_LABEL),
+	NULL
+};
+
+static const struct hwmon_ops ps5_hwmon_ops = {
+	.is_visible = ps5_hwmon_is_visible,
+	.read = ps5_hwmon_read,
+	.read_string = ps5_hwmon_read_string,
+};
+
+static const struct hwmon_chip_info ps5_hwmon_chip = {
+	.ops = &ps5_hwmon_ops,
+	.info = ps5_hwmon_info,
+};
+
+static struct device *ps5_hwmon;
+#endif
+
 static int amdgpu_dm_init(struct amdgpu_device *adev)
 {
 	struct dc_init_data init_data;
@@ -814,6 +894,19 @@ static int amdgpu_dm_init(struct amdgpu_device *adev)
 #ifdef CONFIG_X86_PS5
 	/* lets the HDMI bridge driver re-arm the output when the sink re-announces */
 	ps5_hdmi_register_drm(adev_to_drm(adev));
+	if (!amdgpu_ps5_viola_fw(adev) &&
+	    device_create_file(adev->dev, &ps5_dev_attr_gpu_busy))
+		drm_info(adev_to_drm(adev), "PS5: gpu_busy_percent not created (already there?)\n");
+	{
+		long t;
+
+		if (!ps5_soc_temp(&t)) {
+			ps5_hwmon = hwmon_device_register_with_info(adev->dev, "amdgpu", NULL,
+								     &ps5_hwmon_chip, NULL);
+			if (IS_ERR(ps5_hwmon))
+				ps5_hwmon = NULL;
+		}
+	}
 #endif
 
 	if (amdgpu_dm_init_power_module(&adev->dm))
@@ -868,6 +961,12 @@ static void amdgpu_dm_fini(struct amdgpu_device *adev)
 
 #ifdef CONFIG_X86_PS5
 	ps5_hdmi_unregister_drm(adev_to_drm(adev));
+	if (!amdgpu_ps5_viola_fw(adev))
+		device_remove_file(adev->dev, &ps5_dev_attr_gpu_busy);
+	if (ps5_hwmon) {
+		hwmon_device_unregister(ps5_hwmon);
+		ps5_hwmon = NULL;
+	}
 #endif
 
 	if (adev->dm.vblank_control_workqueue) {
diff --git a/drivers/gpu/drm/amd/pm/amdgpu_pm.c b/drivers/gpu/drm/amd/pm/amdgpu_pm.c
index bb304f3..bc5ef75 100644
--- a/drivers/gpu/drm/amd/pm/amdgpu_pm.c
+++ b/drivers/gpu/drm/amd/pm/amdgpu_pm.c
@@ -2702,7 +2702,8 @@ static int default_attr_update(struct amdgpu_device *adev, struct amdgpu_device_
 			dev_attr->store = NULL;
 		}
 	} else if (DEVICE_ATTR_IS(gpu_metrics)) {
-		if (gc_ver < IP_VERSION(9, 1, 0))
+		if (amdgpu_ps5_viola_fw(adev) ||
+		    gc_ver < IP_VERSION(9, 1, 0))
 			*states = ATTR_STATE_UNSUPPORTED;
 	} else if (DEVICE_ATTR_IS(pp_power_profile_mode)) {
 		if (amdgpu_dpm_get_power_profile_mode(adev, NULL) == -EOPNOTSUPP)
diff --git a/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c b/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
index efb02b0..b23c15b 100644
--- a/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
@@ -649,6 +649,9 @@ static int ps5_read_sensor(struct smu_context *smu,
 			return ret;
 		*value = temp;
 		break;
+	case AMDGPU_PP_SENSOR_GPU_LOAD:
+		*value = amdgpu_ps5_get_gfx_busy_percent(smu->adev->pdev);
+		break;
 	default:
 		return -EOPNOTSUPP;
 	}
diff --git a/include/linux/ps5.h b/include/linux/ps5.h
index 6de7bb8..d16f45f 100644
--- a/include/linux/ps5.h
+++ b/include/linux/ps5.h
@@ -158,6 +158,7 @@ int mp1_boost_exit(void);
 extern struct mutex ps5_mp1_q0_lock;
 
 ktime_t amdgpu_ps5_get_gfx_busy_ns(struct pci_dev *pdev);
