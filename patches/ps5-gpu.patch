diff --git a/drivers/ps5/gpufreq.c b/drivers/ps5/gpufreq.c
new file mode 100644
index 000000000..bc92614cf
--- /dev/null
+++ b/drivers/ps5/gpufreq.c
@@ -0,0 +1,304 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* PS5 GPU clock via SMU RequestGfxclk on amdgpu's busy time, capped to hold the SoC at temp_limit. */
+
+#include <linux/devfreq.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/pci.h>
+#include <linux/platform_device.h>
+#include <linux/pm_opp.h>
+#include <linux/ps5.h>
+#include <linux/ratelimit.h>
+#include <linux/units.h>
+#include <linux/workqueue.h>
+#include <asm/amd/node.h>
+
+#define PS5_GPU_MIN_MHZ		500	/* the Pro SMU rejects less */
+#define PS5_GPU_MAX_MHZ		2230
+#define PS5PRO_GPU_MAX_MHZ	2350
+#define PS5_GPU_STEP_MHZ	125	/* trans_stat fits a page */
+
+#define PS5_THERMAL_MS		100
+#define PS5_THERMAL_COOL_MS	1000	/* 20 C or more under the limit */
+#define PS5_THERMAL_GAIN	5	/* MHz per C off target, per poll */
+#define PS5_LIMIT_DEADBAND_MHZ	25
+
+#define PS5_THM_TCON_CUR_TMP	0x00059800
+#define PS5_CUR_TEMP_SHIFT	21
+#define PS5_CUR_TEMP_RANGE_SEL	BIT(19)
+#define PS5_CUR_TEMP_TJ_SEL	GENMASK(17, 16)
+
+struct ps5_gpufreq {
+	struct device *dev;
+	struct devfreq_dev_profile profile;
+	ps5_gpu_busy_ns_t busy_ns;
+	u64 busy;
+	ktime_t stamp;
+	struct delayed_work thermal;
+	struct mutex lock;	/* fields below, SMU requests */
+	unsigned long want;	/* governor's OPP */
+	int limit;		/* thermal limit, MHz */
+	int max_mhz;
+	int mhz;		/* clock set, 0 if unknown */
+	bool opp_only;		/* SMU rejected a clock between OPPs */
+	bool stopped;
+};
+
+#undef MODULE_PARAM_PREFIX
+#define MODULE_PARAM_PREFIX "ps5_gpufreq."
+
+static unsigned int temp_limit = 85;
+
+static int temp_limit_set(const char *val, const struct kernel_param *kp)
+{
+	return param_set_uint_minmax(val, kp, 50, 95);
+}
+
+static const struct kernel_param_ops temp_limit_ops = {
+	.set = temp_limit_set,
+	.get = param_get_uint,
+};
+module_param_cb(temp_limit, &temp_limit_ops, &temp_limit, 0644);
+MODULE_PARM_DESC(temp_limit, "Hottest SoC temperature allowed, in C (50-95, default 85)");
+
+static struct devfreq_simple_ondemand_data ps5_gpufreq_ondemand = {
+	.upthreshold = 70,
+	.downdifferential = 15,
+};
+
+/* SoC die temperature (Tctl), as k10temp reads it. */
+int ps5_soc_temp(int *millidegrees)
+{
+	u32 val;
+	int ret;
+
+	ret = amd_smn_read(0, PS5_THM_TCON_CUR_TMP, &val);
+	if (ret)
+		return ret;
+
+	*millidegrees = (val >> PS5_CUR_TEMP_SHIFT) * 125;
+	if ((val & PS5_CUR_TEMP_RANGE_SEL) ||
+	    (val & PS5_CUR_TEMP_TJ_SEL) == PS5_CUR_TEMP_TJ_SEL)
+		*millidegrees -= 49000;
+	return 0;
+}
+EXPORT_SYMBOL(ps5_soc_temp);
+
+static void ps5_gpufreq_apply(struct ps5_gpufreq *gf)
+{
+	int want = gf->want / HZ_PER_MHZ;
+	int mhz = min(want, gf->limit);
+	int ret;
+
+	lockdep_assert_held(&gf->lock);
+	if (gf->opp_only && mhz < want) {
+		unsigned long f = mhz * HZ_PER_MHZ;
+		struct dev_pm_opp *opp = dev_pm_opp_find_freq_floor(gf->dev, &f);
+
+		if (!IS_ERR(opp)) {
+			dev_pm_opp_put(opp);
+			mhz = f / HZ_PER_MHZ;
+		}
+	}
+	/* Deadband while the limit binds. */
+	if (gf->limit < want && gf->mhz && gf->mhz <= want &&
+	    abs(mhz - gf->mhz) < PS5_LIMIT_DEADBAND_MHZ)
+		return;
+	if (mhz == gf->mhz || gf->stopped)
+		return;
+
+	ret = ps5_mp1_request_gfxclk(mhz);
+	if (!ret) {
+		gf->mhz = mhz;
+	} else if (ret == -EINVAL) {
+		dev_warn(gf->dev, "SMU rejected %d MHz\n", mhz);
+		/* Drop a rejected OPP; if it was not one, limit in OPP steps. */
+		if (dev_pm_opp_disable(gf->dev, mhz * HZ_PER_MHZ))
+			gf->opp_only = true;
+	} else {
+		dev_err(gf->dev, "SMU not responding (%d), scaling stopped\n",
+			ret);
+		gf->stopped = true;
+	}
+}
+
+static int ps5_gpufreq_target(struct device *dev, unsigned long *freq,
+			      u32 flags)
+{
+	struct ps5_gpufreq *gf = dev_get_drvdata(dev);
+	struct dev_pm_opp *opp;
+
+	opp = devfreq_recommended_opp(dev, freq, flags);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+	dev_pm_opp_put(opp);
+
+	mutex_lock(&gf->lock);
+	gf->want = *freq;
+	ps5_gpufreq_apply(gf);
+	mutex_unlock(&gf->lock);
+	return 0;
+}
+
+static int ps5_gpufreq_cur_freq(struct device *dev, unsigned long *freq)
+{
+	struct ps5_gpufreq *gf = dev_get_drvdata(dev);
+	int mhz = READ_ONCE(gf->mhz);
+
+	*freq = mhz ? mhz * HZ_PER_MHZ : READ_ONCE(gf->want);
+	return 0;
+}
+
+static int ps5_gpufreq_status(struct device *dev,
+			      struct devfreq_dev_status *stat)
+{
+	struct ps5_gpufreq *gf = dev_get_drvdata(dev);
+	u64 busy = gf->busy_ns(dev->parent);
+	ktime_t now = ktime_get();
+
+	stat->current_frequency = READ_ONCE(gf->mhz) * HZ_PER_MHZ;
+	stat->busy_time = busy - gf->busy;
+	stat->total_time = ktime_to_ns(ktime_sub(now, gf->stamp));
+	gf->busy = busy;
+	gf->stamp = now;
+	return 0;
+}
+
+/* Integral control: settles at the clock that holds temp_limit. */
+static void ps5_gpufreq_thermal(struct work_struct *work)
+{
+	static DEFINE_RATELIMIT_STATE(rs, 60 * HZ, 1);
+	struct ps5_gpufreq *gf = container_of(to_delayed_work(work),
+					      struct ps5_gpufreq, thermal);
+	int target = READ_ONCE(temp_limit) * 1000;
+	unsigned int delay = PS5_THERMAL_MS;
+	int temp, limit;
+
+	if (!ps5_soc_temp(&temp)) {
+		if (temp < target - 20000)
+			delay = PS5_THERMAL_COOL_MS;
+		mutex_lock(&gf->lock);
+		limit = gf->limit;
+		/* Start from the running clock. */
+		if (temp > target && gf->mhz && limit > gf->mhz)
+			limit = gf->mhz;
+		limit += (target - temp) * PS5_THERMAL_GAIN / 1000;
+		limit = clamp(limit, PS5_GPU_MIN_MHZ, gf->max_mhz);
+		if (limit < gf->limit && gf->limit == gf->max_mhz &&
+		    __ratelimit(&rs))
+			dev_info(gf->dev, "SoC at %d C, limiting the clock\n",
+				 temp / 1000);
+		gf->limit = limit;
+		ps5_gpufreq_apply(gf);
+		mutex_unlock(&gf->lock);
+	}
+	queue_delayed_work(system_freezable_power_efficient_wq, &gf->thermal,
+			   msecs_to_jiffies(delay));
+}
+
+static void ps5_gpufreq_stop_thermal(void *data)
+{
+	struct ps5_gpufreq *gf = data;
+
+	cancel_delayed_work_sync(&gf->thermal);
+}
+
+static void ps5_gpufreq_remove_opps(void *dev)
+{
+	dev_pm_opp_remove_all_dynamic(dev);
+}
+
+static int ps5_gpufreq_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	u32 max_mhz = ps5_is_viola(to_pci_dev(dev->parent)->device) ?
+		      PS5PRO_GPU_MAX_MHZ : PS5_GPU_MAX_MHZ;
+	struct ps5_gpufreq *gf;
+	struct devfreq *df;
+	u32 mhz;
+	int ret;
+
+	ret = ps5_mp1_query_gfxclk(&mhz);
+	if (ret)
+		return dev_err_probe(dev, ret, "SMU not responding\n");
+
+	gf = devm_kzalloc(dev, sizeof(*gf), GFP_KERNEL);
+	if (!gf)
+		return -ENOMEM;
+	ret = devm_mutex_init(dev, &gf->lock);
+	if (ret)
+		return ret;
+	gf->dev = dev;
+	gf->busy_ns = *(ps5_gpu_busy_ns_t *)dev_get_platdata(dev);
+	gf->busy = gf->busy_ns(dev->parent);
+	gf->stamp = ktime_get();
+	gf->max_mhz = gf->limit = max_mhz;
+	gf->want = max_mhz * HZ_PER_MHZ;
+	platform_set_drvdata(pdev, gf);
+
+	ret = devm_add_action_or_reset(dev, ps5_gpufreq_remove_opps, dev);
+	if (ret)
+		return ret;
+	for (u32 f = PS5_GPU_MIN_MHZ;; f = min(f + PS5_GPU_STEP_MHZ, max_mhz)) {
+		struct dev_pm_opp_data opp = { .freq = f * HZ_PER_MHZ };
+
+		ret = dev_pm_opp_add_dynamic(dev, &opp);
+		if (ret)
+			return ret;
+		if (f == max_mhz)
+			break;
+	}
+
+	gf->profile.initial_freq = gf->want;
+	gf->profile.polling_ms = 50;
+	gf->profile.target = ps5_gpufreq_target;
+	gf->profile.get_dev_status = ps5_gpufreq_status;
+	gf->profile.get_cur_freq = ps5_gpufreq_cur_freq;
+	df = devm_devfreq_add_device(dev, &gf->profile,
+				     DEVFREQ_GOV_SIMPLE_ONDEMAND,
+				     &ps5_gpufreq_ondemand);
+	if (IS_ERR(df))
+		return dev_err_probe(dev, PTR_ERR(df), "devfreq failed\n");
+
+	INIT_DELAYED_WORK(&gf->thermal, ps5_gpufreq_thermal);
+	ret = devm_add_action_or_reset(dev, ps5_gpufreq_stop_thermal, gf);
+	if (ret)
+		return ret;
+	queue_delayed_work(system_freezable_power_efficient_wq, &gf->thermal, 0);
+
+	dev_info(dev, "%u-%u MHz, now at %u MHz, limit %u C\n", PS5_GPU_MIN_MHZ,
+		 max_mhz, mhz, temp_limit);
+	return 0;
+}
+
+/* The SMU may resume at another clock. */
+static int ps5_gpufreq_resume(struct device *dev)
+{
+	struct ps5_gpufreq *gf = dev_get_drvdata(dev);
+
+	mutex_lock(&gf->lock);
+	gf->mhz = 0;
+	mutex_unlock(&gf->lock);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(ps5_gpufreq_pm, NULL, ps5_gpufreq_resume);
+
+static struct platform_driver ps5_gpufreq_driver = {
+	.probe = ps5_gpufreq_probe,
+	.driver = {
+		.name = "ps5-gpufreq",
+		.pm = pm_sleep_ptr(&ps5_gpufreq_pm),
+	},
+};
+builtin_platform_driver(ps5_gpufreq_driver);
+
+/* For amdgpu. Undo with platform_device_unregister(). */
+struct platform_device *ps5_gpufreq_register(struct device *gpu,
+					     ps5_gpu_busy_ns_t busy_ns)
+{
+	return platform_device_register_data(gpu, "ps5-gpufreq",
+					     PLATFORM_DEVID_NONE, &busy_ns,
+					     sizeof(busy_ns));
+}
+EXPORT_SYMBOL(ps5_gpufreq_register);
