diff --git a/README.md b/README.md
index e05da56..89ab7d6 100644
--- a/README.md
+++ b/README.md
@@ -20,6 +20,7 @@ generated against the tree the earlier ones produce:
 | `ps5-iw620-tx-min128.patch` | Pads short IW620 data DMA transfers to 128 bytes while preserving real packet lengths and DMA ownership. |
 | `ps5-iw620-tx-priority.patch` | Maps IW620 STA TX TIDs 1→2, 3→0 and 5→4 within their access categories before queue selection and BA bookkeeping to avoid priority-triggered stalls. |
 | `ps5-iw620-fresh-fw.patch` | Resets the IW620 at probe when firmware from an earlier kernel is still running, so it is downloaded fresh (`ps5_fresh_fw=0` reuses it); reports a failure when association gets no response instead of timing out. |
+| `ps5-iw620-no-tdls.patch` | Stops advertising TDLS: the IW620 firmware rejects `TDLS_OPERATION` (0x122), and a peer's setup request then ends in a disconnect and a scan command that never returns. Without the flags `wpa_supplicant` declines the request. |
 
 ### IW620 HE and aggregation
 
diff --git a/install.sh b/install.sh
index cbb2a0b..20b9705 100755
--- a/install.sh
+++ b/install.sh
@@ -20,6 +20,7 @@ HE_PATCH=$script_dir/ps5-iw620-he.patch
 TX_PATCH=$script_dir/ps5-iw620-tx-min128.patch
 PRIORITY_PATCH=$script_dir/ps5-iw620-tx-priority.patch
 FRESH_FW_PATCH=$script_dir/ps5-iw620-fresh-fw.patch
+NO_TDLS_PATCH=$script_dir/ps5-iw620-no-tdls.patch
 
 MODULE_DIR=/lib/modules/$KERNEL_RELEASE/extra/ps5-iw620
 MODPROBE_CONF=/etc/modprobe.d/ps5-iw620.conf
@@ -196,6 +197,16 @@ prepare_source() {
 	else
 		die "fresh-firmware patch does not apply cleanly in $DRIVER_DIR"
 	fi
+
+	[ -f "$NO_TDLS_PATCH" ] || die "patch file not found: $NO_TDLS_PATCH"
+	if git_driver apply --check "$NO_TDLS_PATCH" >/dev/null 2>&1; then
+		say "Applying IW620 no-TDLS patch"
+		git_driver apply "$NO_TDLS_PATCH"
+	elif git_driver apply -R --check "$NO_TDLS_PATCH" >/dev/null 2>&1; then
+		say "IW620 no-TDLS patch is already applied"
+	else
+		die "no-TDLS patch does not apply cleanly in $DRIVER_DIR"
+	fi
 }
 
