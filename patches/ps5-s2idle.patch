+static bool salina_kept_running;
+
+bool xhci_salina_suspend(struct xhci_hcd *xhci)
+{
+	struct pci_dev *pdev = to_pci_dev(xhci_to_hcd(xhci)->self.controller);
+
+	if (!(xhci->quirks & XHCI_PS5_SALINA_PHY) ||
+	    pm_suspend_target_state != PM_SUSPEND_TO_IDLE)
+		return false;
+
+	if (pci_enable_device(pdev))
+		return false;
+
+	salina_stop_xhci_poller();
+	salina_kept_running = true;
+	return true;
+}
+
+bool xhci_salina_resume(struct xhci_hcd *xhci)
+{
+	struct pci_dev *pdev = to_pci_dev(xhci_to_hcd(xhci)->self.controller);
+
+	if (!(xhci->quirks & XHCI_PS5_SALINA_PHY) || !salina_kept_running)
+		return false;
+
+	pci_disable_device(pdev);
+	salina_kept_running = false;
+	salina_start_xhci_poller(xhci);
+	return true;
+}
