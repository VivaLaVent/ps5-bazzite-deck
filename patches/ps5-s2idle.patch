+static void spcie_sleep_enter(void)
+{
+	WRITE_ONCE(icc_dev->suspended, true);
+
+	if (sleep_led) {
+		mutex_lock(&icc_led_lock);
+		__icc_indicator_set_led(indicator_orange, sizeof(indicator_orange));
+		mutex_unlock(&icc_led_lock);
+	}
+}
+
+static void spcie_sleep_exit(void)
+{
+	struct input_dev *idev = icc_dev->idev;
+
+	if (sleep_led) {
+		mutex_lock(&icc_led_lock);
+		if (icc_led_last_size)
+			__icc_indicator_set_led(icc_led_last, icc_led_last_size);
+		mutex_unlock(&icc_led_lock);
+	}
+
+	if (wake_beep)
+		icc_beep();
+
+	WRITE_ONCE(icc_dev->suspended, false);
+	schedule_work(&icc_notification_work);
+
+	input_report_key(idev, KEY_WAKEUP, 1);
+	input_sync(idev);
+	input_report_key(idev, KEY_WAKEUP, 0);
+	input_sync(idev);
+}
+
+static int spcie_pm_notify(struct notifier_block *nb, unsigned long action,
+			   void *data)
+{
+	switch (action) {
+	case PM_SUSPEND_PREPARE:
+		spcie_sleep_enter();
+		break;
+	case PM_POST_SUSPEND:
+		spcie_sleep_exit();
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block spcie_pm_nb = {
+	.notifier_call = spcie_pm_notify,
+};
