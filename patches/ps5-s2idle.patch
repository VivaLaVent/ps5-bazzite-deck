@@ -856,6 +856,51 @@ static void gbe_remove(struct pci_dev *pdev)
 	free_netdev(netdev);
 }
 
+static int gbe_suspend(struct device *dev)
+{
+	struct net_device *netdev = dev_get_drvdata(dev);
+	struct gbe_priv *p = netdev_priv(netdev);
+
+	if (!netif_running(netdev))
+		return 0;
+
+	netif_device_detach(netdev);
+	netif_carrier_off(netdev);
+	cancel_delayed_work_sync(&p->link_poll);
+	napi_disable(&p->napi);
+	gbe_stop_dma(p);
+
+	return 0;
+}
+
+static int gbe_resume(struct device *dev)
+{
+	struct net_device *netdev = dev_get_drvdata(dev);
+	struct gbe_priv *p = netdev_priv(netdev);
+
+	if (!netif_running(netdev))
+		return 0;
+
+	p->link_up = 0;
+	gbe_init_hw(p);
+	gbe_rx_fill(p);
+	gbe_init_rings_hw(p);
+
+	netif_addr_lock_bh(netdev);
+	gbe_set_rx_mode(netdev);
+	netif_addr_unlock_bh(netdev);
+
+	napi_enable(&p->napi);
+	netif_device_attach(netdev);
+
+	gbe_link_change(p);
+	schedule_delayed_work(&p->link_poll, HZ);
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(gbe_pm_ops, gbe_suspend, gbe_resume);
+
 static const struct pci_device_id gbe_pci_tbl[] = {
 	{ PCI_DEVICE(PCI_VENDOR_ID_SONY, PCI_DEVICE_ID_GBE) },
