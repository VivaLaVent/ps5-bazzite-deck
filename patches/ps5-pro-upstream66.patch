+/* The test mailbox (C2PMSG_96/98/72); the main one is under ps5_mp1_q0_lock. */
+static DEFINE_MUTEX(mp1_mbox_mutex);
+#define MP1_LOCK_POLLS	200000	/* 2 s at 10 us */
+
+/*
+ * Sleep entry sends with IRQs off (icc_power_suspend): poll for the lock
+ * there instead of sleeping, and send anyway after 2 s. NULL if not taken.
+ */
+static struct mutex *mp1_mbox_lock(void)
+{
+	int i;
+
+	if (!irqs_disabled()) {
+		mutex_lock(&ps5_mp1_q0_lock);
+		return &ps5_mp1_q0_lock;
+	}
+	for (i = 0; i < MP1_LOCK_POLLS; i++) {
+		if (mutex_trylock(&ps5_mp1_q0_lock))
+			return &ps5_mp1_q0_lock;
+		udelay(10);
+	}
+	return NULL;
+}
