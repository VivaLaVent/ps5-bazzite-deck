+#ifdef CONFIG_X86_PS5
+#define PS5_SLOT_NS	(100 * NSEC_PER_MSEC)
+
+/* Called with ps5_busy_lock held. */
+static u64 amdgpu_fence_ps5_busy(struct amdgpu_device *adev, ktime_t now)
+{
+	return adev->ps5_busy_ns +
+	       (adev->ps5_busy_sources ? now - adev->ps5_busy_since : 0);
+}
+
+/* Record busy time at the 100 ms boundaries passed, before any busy change. */
+static void amdgpu_fence_ps5_slots(struct amdgpu_device *adev, ktime_t now)
+{
+	const unsigned int n = ARRAY_SIZE(adev->ps5_slot_busy);
+	u64 slot = div_u64(now, PS5_SLOT_NS);
+	u64 s = max(adev->ps5_slot, slot > n ? slot - n : 0) + 1;
+
+	for (; s <= slot; s++)
+		adev->ps5_slot_busy[s % n] = amdgpu_fence_ps5_busy(adev,
+								   s * PS5_SLOT_NS);
+	adev->ps5_slot = slot;
+}
+
+/* The GPU is busy while any source is. Called with ps5_busy_lock held. */
+static void amdgpu_fence_ps5_set(struct amdgpu_device *adev, bool *src,
+				 bool busy)
+{
+	ktime_t now;
+
+	if (*src == busy)
+		return;
+	now = ktime_get();
+	amdgpu_fence_ps5_slots(adev, now);
+	*src = busy;
+	if (busy && !adev->ps5_busy_sources++)
+		adev->ps5_busy_since = now;
+	else if (!busy && !--adev->ps5_busy_sources)
+		adev->ps5_busy_ns += now - adev->ps5_busy_since;
+}
+
+/* ps5-gpufreq: a gfx/compute ring is busy while it has fences in flight. */
+static void amdgpu_fence_ps5_update(struct amdgpu_ring *ring)
+{
+	struct amdgpu_device *adev = ring->adev;
+	unsigned long flags;
+
+	if (ring->funcs->type != AMDGPU_RING_TYPE_GFX &&
+	    ring->funcs->type != AMDGPU_RING_TYPE_COMPUTE)
+		return;
+
+	spin_lock_irqsave(&adev->ps5_busy_lock, flags);
+	amdgpu_fence_ps5_set(adev, &ring->ps5_busy,
+			     ring->fence_drv.sync_seq !=
+			     atomic_read(&ring->fence_drv.last_seq));
+	spin_unlock_irqrestore(&adev->ps5_busy_lock, flags);
+}
+
+/* KFD user queues bypass fences: sample GUI_ACTIVE every 1 ms instead. */
+static enum hrtimer_restart amdgpu_fence_ps5_kfd_sample(struct hrtimer *t)
+{
+	struct amdgpu_device *adev = container_of(t, struct amdgpu_device,
+						  ps5_kfd_timer);
+	struct amdgpu_ip_block *gfx =
+		amdgpu_device_ip_get_ip_block(adev, AMD_IP_BLOCK_TYPE_GFX);
+	bool busy = gfx && !adev->in_suspend && !amdgpu_in_reset(adev) &&
+		    !gfx->version->funcs->is_idle(gfx);
+	unsigned long flags;
+
+	spin_lock_irqsave(&adev->ps5_busy_lock, flags);
+	amdgpu_fence_ps5_set(adev, &adev->ps5_kfd_busy, busy);
+	spin_unlock_irqrestore(&adev->ps5_busy_lock, flags);
+	hrtimer_forward_now(t, ms_to_ktime(1));
+	return HRTIMER_RESTART;
+}
+
+void amdgpu_fence_ps5_init(struct amdgpu_device *adev)
+{
+	spin_lock_init(&adev->ps5_busy_lock);
+	hrtimer_setup(&adev->ps5_kfd_timer, amdgpu_fence_ps5_kfd_sample,
+		      CLOCK_MONOTONIC, HRTIMER_MODE_REL_SOFT);
+}
+
+/* True when the first KFD user compute queue starts, false after the last. */
+void amdgpu_fence_ps5_kfd_active(struct amdgpu_device *adev, bool active)
+{
+	unsigned long flags;
+
+	if (active) {
+		if (!IS_ERR_OR_NULL(adev->ps5_gpufreq))
+			hrtimer_start(&adev->ps5_kfd_timer, ms_to_ktime(1),
+				      HRTIMER_MODE_REL_SOFT);
+		return;
+	}
+	hrtimer_cancel(&adev->ps5_kfd_timer);
+	spin_lock_irqsave(&adev->ps5_busy_lock, flags);
+	amdgpu_fence_ps5_set(adev, &adev->ps5_kfd_busy, false);
+	spin_unlock_irqrestore(&adev->ps5_busy_lock, flags);
+}
+
+u64 amdgpu_fence_ps5_busy_ns(struct device *dev)
+{
+	struct amdgpu_device *adev = drm_to_adev(dev_get_drvdata(dev));
+	unsigned long flags;
+	u64 ns;
+
+	spin_lock_irqsave(&adev->ps5_busy_lock, flags);
+	ns = amdgpu_fence_ps5_busy(adev, ktime_get());
+	spin_unlock_irqrestore(&adev->ps5_busy_lock, flags);
+	return ns;
+}
+
+/* Load over the last 0.5-0.6 s, whenever it is read. */
+u32 amdgpu_fence_ps5_busy_percent(struct amdgpu_device *adev)
+{
+	const unsigned int n = ARRAY_SIZE(adev->ps5_slot_busy);
+	unsigned long flags;
+	u64 first, busy;
+	ktime_t now;
+	u32 pct;
+
+	spin_lock_irqsave(&adev->ps5_busy_lock, flags);
+	now = ktime_get();
+	amdgpu_fence_ps5_slots(adev, now);
+	first = adev->ps5_slot - (n - 1);
+	busy = amdgpu_fence_ps5_busy(adev, now) - adev->ps5_slot_busy[first % n];
+	pct = div64_u64(100 * busy, now - first * PS5_SLOT_NS);
+	spin_unlock_irqrestore(&adev->ps5_busy_lock, flags);
+	return min(pct, 100);
+}
