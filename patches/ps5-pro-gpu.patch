+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PS5 Pro thermal sensors behind the southbridge (ICC thermal service).
+ *
+ * Protocol as used by Sony's kernel (SceIccThermal): msg_type 0 returns
+ * sensor info, and with index 0xff the bitmask of present sensors;
+ * msg_type 1 reads one sensor.  Readings are 8.8 fixed-point degrees
+ * Celsius, the format the same controller uses for fan target temperatures
+ * (sensor 0 matches k10temp's Tctl).  The info reply carries no names, so
+ * known sensors are labelled from a table and the rest as iccN.  Registered
+ * by amdgpu when it runs the Viola GPU firmware.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/hwmon.h>
+#include <linux/bitrev.h>
+#include <linux/ctype.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <linux/ps5.h>
+
+#define ICC_THERMAL_MT_INFO	0x00
+#define ICC_THERMAL_MT_READ	0x01
+
+#define ICC_THERMAL_ALL		0xff
+#define ICC_THERMAL_MAX_SENSORS	32
+#define ICC_THERMAL_INFO_LEN	16
+
+#define PS5_THERMAL_LABEL_LEN	(ICC_THERMAL_INFO_LEN + 1)
+
+/* Identified on a PS5 Pro by loading the CPU and the GPU separately. */
+static const char * const ps5_viola_sensor_names[ICC_THERMAL_MAX_SENSORS] = {
+	[0] = "gpu",
+	[1] = "cpu",
+};
+
+struct ps5_thermal {
+	unsigned int nr;
+	u8 index[ICC_THERMAL_MAX_SENSORS];
+	char label[ICC_THERMAL_MAX_SENSORS][PS5_THERMAL_LABEL_LEN];
+	u32 config[ICC_THERMAL_MAX_SENSORS + 1];
+	struct hwmon_channel_info temp_info;
+	const struct hwmon_channel_info *info[2];
+	struct hwmon_chip_info chip;
+};
+
+/* Sends one thermal query; data[] receives the reply payload. */
+static int icc_thermal_query(u16 msg_type, u8 index, u8 *data, size_t len)
+{
+	struct icc_msg *msg;
+	u8 *buf;
+	int ret;
+
+	buf = kzalloc(ICC_MSG_MAX_SIZE, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	msg = (struct icc_msg *)buf;
+
+	msg->service_id = ICC_SERVICE_ID_THERMAL;
+	msg->msg_type = msg_type;
+	msg->length = ICC_MSG_MIN_SIZE;
+	msg->data[0] = index;
+
+	ret = icc_query(buf, buf);
+	if (!ret)
+		memcpy(data, msg->data, len);
+
+	kfree(buf);
+	return ret;
+}
+
+static int ps5_thermal_raw(u8 index, u16 *raw)
+{
+	u8 data[4];
+	int ret;
+
+	ret = icc_thermal_query(ICC_THERMAL_MT_READ, index, data, sizeof(data));
+	if (ret)
+		return ret;
+
+	*raw = get_unaligned_le16(data + 2);
+	return 0;
+}
+
+int ps5_icc_thermal_read(u8 index, int *millidegrees)
+{
+	u16 raw;
+	int ret;
+
+	ret = ps5_thermal_raw(index, &raw);
+	if (ret)
+		return ret;
+
+	*millidegrees = (s16)raw * 1000 / 256;
+	return 0;
+}
+EXPORT_SYMBOL(ps5_icc_thermal_read);
+
+static int ps5_thermal_read(struct device *dev, enum hwmon_sensor_types type,
+			    u32 attr, int channel, long *val)
+{
+	struct ps5_thermal *t = dev_get_drvdata(dev);
+	int mdeg, ret;
+
+	ret = ps5_icc_thermal_read(t->index[channel], &mdeg);
+	if (ret)
+		return ret;
+
+	*val = mdeg;
+	return 0;
+}
+
+static int ps5_thermal_read_string(struct device *dev,
+				   enum hwmon_sensor_types type, u32 attr,
+				   int channel, const char **str)
+{
+	struct ps5_thermal *t = dev_get_drvdata(dev);
+
+	*str = t->label[channel];
+	return 0;
+}
+
+static const struct hwmon_ops ps5_thermal_ops = {
+	.visible = 0444,
+	.read = ps5_thermal_read,
+	.read_string = ps5_thermal_read_string,
+};
+
+/*
+ * Use the info bytes as the label if they hold a printable name, else the
+ * known name, else iccN.
+ */
+static void ps5_thermal_set_label(struct ps5_thermal *t, unsigned int ch,
+				  const u8 *info)
+{
+	unsigned int i;
+
+	for (i = 0; i < ICC_THERMAL_INFO_LEN && info[i]; i++)
+		if (!isprint(info[i]))
+			break;
+
+	if (i && (i == ICC_THERMAL_INFO_LEN || !info[i])) {
+		memcpy(t->label[ch], info, i);
+		t->label[ch][i] = '\0';
+	} else if (ps5_viola_sensor_names[t->index[ch]]) {
+		strscpy(t->label[ch], ps5_viola_sensor_names[t->index[ch]]);
+	} else {
+		snprintf(t->label[ch], PS5_THERMAL_LABEL_LEN, "icc%u",
+			 t->index[ch]);
+	}
+}
+
+static int ps5_thermal_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ps5_thermal *t;
+	struct device *hwmon;
+	u8 data[4 + ICC_THERMAL_INFO_LEN];
+	unsigned long present;
+	unsigned int idx;
+	int ret;
+
+	if (!spcie_is_initialized())
+		return -EPROBE_DEFER;
+
+	t = devm_kzalloc(dev, sizeof(*t), GFP_KERNEL);
+	if (!t)
+		return -ENOMEM;
+
+	ret = icc_thermal_query(ICC_THERMAL_MT_INFO, ICC_THERMAL_ALL,
+				data, sizeof(data));
+	if (ret)
+		return dev_err_probe(dev, ret, "sensor list query failed\n");
+
+	/* Bit-reversed within each byte, as Sony's kernel decodes it. */
+	present = bitrev8x4(get_unaligned_le32(data + 4));
+
+	for_each_set_bit(idx, &present, ICC_THERMAL_MAX_SENSORS) {
+		unsigned int ch = t->nr;
+		int r;
+
+		t->index[ch] = idx;
+
+		memset(data, 0, sizeof(data));
+		r = icc_thermal_query(ICC_THERMAL_MT_INFO, idx, data,
+				      sizeof(data));
+		if (r)
+			dev_warn(dev, "sensor %u: info query failed: %d\n",
+				 idx, r);
+		ps5_thermal_set_label(t, ch, data + 4);
+
+		t->config[ch] = HWMON_T_INPUT | HWMON_T_LABEL;
+		t->nr++;
+	}
+
+	if (!t->nr)
+		return -ENODEV;
+
+	t->temp_info.type = hwmon_temp;
+	t->temp_info.config = t->config;
+	t->info[0] = &t->temp_info;
+	t->chip.ops = &ps5_thermal_ops;
+	t->chip.info = t->info;
+
+	hwmon = devm_hwmon_device_register_with_info(dev, "ps5_thermal", t,
+						     &t->chip, NULL);
+	return PTR_ERR_OR_ZERO(hwmon);
+}
+
+static struct platform_driver ps5_thermal_driver = {
+	.probe  = ps5_thermal_probe,
+	.driver = {
+		.name = "ps5-thermal",
+	},
+};
+
+static struct platform_device *ps5_thermal_pdev;
+
+/* Called by amdgpu once it runs the PS5 Pro (Viola) GPU firmware. */
+void ps5_thermal_viola_init(void)
+{
+	struct platform_device *pdev;
+	int ret;
+
+	if (ps5_thermal_pdev)
+		return;
+
+	ret = platform_driver_register(&ps5_thermal_driver);
+	if (ret) {
+		pr_warn("ps5-thermal: driver registration failed: %d\n", ret);
+		return;
+	}
+
+	pdev = platform_device_register_simple("ps5-thermal", -1, NULL, 0);
+	if (IS_ERR(pdev)) {
+		pr_warn("ps5-thermal: device registration failed: %ld\n",
+			PTR_ERR(pdev));
+		platform_driver_unregister(&ps5_thermal_driver);
+		return;
+	}
+	ps5_thermal_pdev = pdev;
+}
+EXPORT_SYMBOL(ps5_thermal_viola_init);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("PS5 Pro ICC thermal sensors");
+MODULE_ALIAS("platform:ps5-thermal");
