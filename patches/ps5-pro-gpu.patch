+/*
+ * PS5 loads its GPU firmware directly, where the SMU block is normally added
+ * only with amdgpu.dpm=1.  The PS5 Pro SMU backend never changes clocks, so
+ * add it unless DPM is disabled.  Only on a PS5 Pro with the Viola firmware.
+ */
+static bool amdgpu_discovery_ps5_smu(struct amdgpu_device *adev)
+{
+#ifdef CONFIG_X86_PS5
+	return ps5_smu && amdgpu_dpm && amdgpu_ps5_viola_fw(adev);
+#else
+	return false;
+#endif
+}
