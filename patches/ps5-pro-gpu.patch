+static const char * const ps5_viola_fw_names[] = {
+	"amdgpu/viola_ce.bin",
+	"amdgpu/viola_me.bin",
+	"amdgpu/viola_mec.bin",
+	"amdgpu/viola_mec2.bin",
+	"amdgpu/viola_pfp.bin",
+	"amdgpu/viola_rlc.bin",
+	"amdgpu/viola_sdma.bin",
+	"amdgpu/viola_sdma1.bin",
+};
+MODULE_FIRMWARE("amdgpu/viola_ce.bin");
+MODULE_FIRMWARE("amdgpu/viola_me.bin");
+MODULE_FIRMWARE("amdgpu/viola_mec.bin");
+MODULE_FIRMWARE("amdgpu/viola_mec2.bin");
+MODULE_FIRMWARE("amdgpu/viola_pfp.bin");
