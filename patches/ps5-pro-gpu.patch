+static void mp1_viola_enable_wgps(void)
+{
+	struct mp1_msg msg = {};
+	u32 before;
+	int ret;
+
+	ret = mp1fw_sendmsg(&msg, PPSMC_MSG_QueryActiveWgp);
+	if (ret) {
+		pr_warn("Viola: QueryActiveWgp failed: %d\n", ret);
+		return;
+	}
+
+	before = msg.resp_val;
+	if (before == PS5PRO_ACTIVE_WGP_COUNT)
+		return;
+
+	memset(&msg, 0, sizeof(msg));
+	msg.arg = PS5PRO_ACTIVE_WGP_COUNT;
+	ret = mp1fw_sendmsg(&msg, PPSMC_MSG_RequestActiveWgp);
+	if (ret)
+		pr_warn("Viola: RequestActiveWgp(%u) failed: %d\n",
+			PS5PRO_ACTIVE_WGP_COUNT, ret);
+	else
+		pr_info("Viola: enabled %u WGPs (was %u)\n",
+			PS5PRO_ACTIVE_WGP_COUNT, before);
+}
+
+static long mp1_query(unsigned long arg, u8 msgid)
+{
+	struct mp1_query __user *uq = (struct mp1_query __user *)arg;
+	struct mp1_query q;
+	struct mp1_msg msg = {};
+	int ret;
+
+	if (!mp1_viola)
+		return -ENOTTY;
+
+	if (copy_from_user(&q, uq, sizeof(q)))
+		return -EFAULT;
+
+	msg.arg = q.arg;
+	ret = mp1fw_sendmsg(&msg, msgid);
+	if (ret)
+		return ret;
+
+	q.val = msg.resp_val;
+	if (copy_to_user(uq, &q, sizeof(q)))
+		return -EFAULT;
+
+	return 0;
+}
+
+/*
+ * Called by amdgpu once it runs the PS5 Pro (Viola) GPU firmware.  Set 3
+ * overwrites everything set 2 wrote in mp1_init().
+ */
+void ps5_mp1_viola_init(void)
+{
+	if (mp1_viola)
+		return;
+	mp1_viola = true;
+
+	mp1_viola_enable_wgps();
+
+	pr_info("Set BAPM params (Viola)\n");
+	mp1_set_bapm_param_set_all(mp1_viola_bapm_param_set());
+}
+EXPORT_SYMBOL(ps5_mp1_viola_init);
