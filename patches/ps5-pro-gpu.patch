+/* Viola is the Cyan Skillfish variant in the PS5 Pro, device ID 0x13DA. */
+static inline bool amdgpu_is_viola(struct amdgpu_device *adev)
+{
+#ifdef CONFIG_X86_PS5
+	return adev->asic_type == CHIP_CYAN_SKILLFISH &&
+	       adev->pdev->device == 0x13da;
+#else
+	return false;
+#endif
+}
+
+/*
+ * The PS5 Pro (Viola) settings are applied only with the Viola firmware.
+ * With the Cyan Skillfish firmware a PS5 Pro is driven like a base PS5.
+ */
+static inline bool amdgpu_ps5_viola_fw(struct amdgpu_device *adev)
+{
+#ifdef CONFIG_X86_PS5
+	return adev->ps5_viola_fw;
+#else
+	return false;
+#endif
+}
