+#ifdef CONFIG_X86_PS5
+/*
+ * PS5 Pro (Viola) runs Sony's SMU firmware, which has no metrics table.
+ * Report what Sony's own kernel reads instead: the gfx clock from a CLK block
+ * register and the GPU temperature from the southbridge (ICC) sensor.
+ * Only used with the Viola firmware.
+ */
+#define PS5_VIOLA_GFXCLK		0x17e7a	/* CLK4 + 0x7a, 100 kHz units */
+#define PS5_VIOLA_GPU_SENSOR		0	/* ps5_thermal "gpu" */
+
+static int ps5_get_gfxclk(struct smu_context *smu, uint32_t *mhz)
+{
+	struct amdgpu_device *adev = smu->adev;
+
+	*mhz = RREG32(PS5_VIOLA_GFXCLK) / 10;
+	return 0;
+}
+
+static int ps5_get_gpu_temp(struct smu_context *smu, int *millidegrees)
+{
+	return ps5_icc_thermal_read(PS5_VIOLA_GPU_SENSOR, millidegrees);
+}
+
+static int ps5_read_sensor(struct smu_context *smu,
+			   enum amd_pp_sensors sensor,
+			   void *data,
+			   uint32_t *size)
+{
+	uint32_t *value = data;
+	int temp, ret;
+
+	if (!data || !size)
+		return -EINVAL;
+
+	switch (sensor) {
+	case AMDGPU_PP_SENSOR_GFX_SCLK:
+		ret = ps5_get_gfxclk(smu, value);
+		if (ret)
+			return ret;
+		*value *= 100;
+		break;
+	case AMDGPU_PP_SENSOR_EDGE_TEMP:
+		ret = ps5_get_gpu_temp(smu, &temp);
+		if (ret)
+			return ret;
+		*value = temp;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	*size = 4;
+
+	return 0;
+}
+
+static int ps5_emit_clk_levels(struct smu_context *smu,
+			       enum smu_clk_type clk_type, char *buf,
+			       int *offset)
+{
+	uint32_t cur_value;
+	int ret;
+
+	switch (clk_type) {
+	case SMU_SCLK:
+	case SMU_GFXCLK:
+		ret = ps5_get_gfxclk(smu, &cur_value);
+		if (ret)
+			return ret;
+		*offset += sysfs_emit_at(buf, *offset, "0: %uMhz *\n", cur_value);
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+/* Keep reporting the VBIOS default clocks, as amdgpu did without DPM. */
+static int ps5_get_dpm_ultimate_freq(struct smu_context *smu,
+				     enum smu_clk_type clk_type,
+				     uint32_t *min,
+				     uint32_t *max)
+{
+	struct amdgpu_device *adev = smu->adev;
+	uint32_t clk;
+
+	switch (clk_type) {
+	case SMU_GFXCLK:
+	case SMU_SCLK:
+		clk = adev->clock.default_sclk / 100;
+		break;
+	case SMU_UCLK:
+	case SMU_MCLK:
+		clk = adev->clock.default_mclk / 100;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	if (!clk)
+		return -EOPNOTSUPP;
+
+	if (min)
+		*min = clk;
+	if (max)
+		*max = clk;
+
+	return 0;
+}
+
+static bool ps5_is_dpm_running(struct smu_context *smu)
+{
+	/* Sony's firmware manages DPM itself; nothing is enabled by the driver. */
+	return !smu->adev->in_suspend;
+}
+
+/*
+ * Only callbacks that never send generic SMU messages: Sony's firmware does
+ * not implement the metrics table or feature-mask messages.
+ */
+static const struct pptable_funcs ps5_ppt_funcs = {
+	.read_sensor = ps5_read_sensor,
+	.emit_clk_levels = ps5_emit_clk_levels,
+	.get_enabled_mask = cyan_skillfish_get_enabled_mask,
+	.is_dpm_running = ps5_is_dpm_running,
+	.get_dpm_ultimate_freq = ps5_get_dpm_ultimate_freq,
+};
+
+/* Empty: smu_cmn rejects every message instead of sending it to Sony's SMU. */
+static const struct cmn2asic_msg_mapping ps5_message_map[SMU_MSG_MAX_COUNT];
+#endif
+
 void cyan_skillfish_set_ppt_funcs(struct smu_context *smu)
 {
+#ifdef CONFIG_X86_PS5
+	if (amdgpu_ps5_viola_fw(smu->adev)) {
+		smu->ppt_funcs = &ps5_ppt_funcs;
+		smu->is_apu = true;
+		smu_v11_0_init_msg_ctl(smu, ps5_message_map);
+		return;
+	}
+#endif
+
 	smu->ppt_funcs = &cyan_skillfish_ppt_funcs;
 	smu->table_map = cyan_skillfish_table_map;
 	smu->is_apu = true;
