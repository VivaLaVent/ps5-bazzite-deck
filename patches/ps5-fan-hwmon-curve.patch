+static int ps5_fan_hwmon_suspend(struct device *dev)
+{
+	struct ps5_fan_data *data = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&data->lock);
+	data->suspended = true;
+	mutex_unlock(&data->lock);
+	cancel_delayed_work_sync(&data->work);
+	mutex_lock(&data->lock);
+	data->wire_mode = -1;
+	ret = ps5_fan_set_mode(data, PS5_FAN_MODE_AUTO);
+	mutex_unlock(&data->lock);
+	if (ret) {
+		mutex_lock(&data->lock);
+		data->suspended = false;
+		mutex_unlock(&data->lock);
+		schedule_delayed_work(&data->work, PS5_CONTROL_INTERVAL);
+	}
+	return ret;
+}
+
+static int ps5_fan_hwmon_resume(struct device *dev)
+{
+	struct ps5_fan_data *data = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&data->lock);
+	ret = icc_fan_update_param(data->backup);
+	data->wire_mode = -1;
+	data->filtered_valid = false;
+	data->suspended = false;
+	if (!ret)
+		ret = ps5_fan_update_locked(data);
+	else
+		ps5_fan_fallback(data);
+	mutex_unlock(&data->lock);
+	schedule_delayed_work(&data->work, PS5_CONTROL_INTERVAL);
+	return ret;
+}
