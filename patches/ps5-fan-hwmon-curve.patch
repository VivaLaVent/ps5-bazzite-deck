+static inline struct ps5_fan_curve ps5_fan_board_curve(unsigned int minimum_pwm)
+{
+	struct ps5_fan_curve curve = ps5_fan_default_curve();
+	int i;
+
+	if (minimum_pwm > 255)
+		minimum_pwm = 255;
+	for (i = 0; i < PS5_CURVE_POINTS; i++)
+		if (curve.pwm[i] < minimum_pwm)
+			curve.pwm[i] = minimum_pwm;
+	return curve;
+}
+
+static inline int ps5_fan_curve_valid(const struct ps5_fan_curve *curve)
+{
+	int i;
+
+	if (curve->stop_temp < 0 || curve->stop_temp >= curve->temp[0])
+		return -EINVAL;
+	for (i = 0; i < PS5_CURVE_POINTS; i++) {
+		if (curve->temp[i] < 0 ||
+		    curve->temp[i] > PS5_FAN_EMERGENCY_MC ||
+		    curve->pwm[i] > 255)
+			return -EINVAL;
+		if (i && (curve->temp[i] <= curve->temp[i - 1] ||
+			  curve->pwm[i] < curve->pwm[i - 1]))
+			return -EINVAL;
+	}
+	return curve->pwm[PS5_CURVE_POINTS - 1] == 255 ? 0 : -EINVAL;
+}
+
+static inline unsigned int
+ps5_fan_interpolate(const struct ps5_fan_curve *curve, int temp)
+{
+	int i;
+
+	if (temp <= curve->temp[0])
+		return curve->pwm[0];
+	for (i = 1; i < PS5_CURVE_POINTS; i++) {
+		if (temp <= curve->temp[i]) {
+			unsigned int span = curve->temp[i] - curve->temp[i - 1];
+			unsigned int rise = curve->pwm[i] - curve->pwm[i - 1];
+
+			return curve->pwm[i - 1] +
+			       (rise * (temp - curve->temp[i - 1]) + span / 2) /
+				       span;
+		}
+	}
+	return 255;
+}
+
+static inline unsigned int ps5_fan_auto_pwm(const struct ps5_fan_curve *curve,
+					    int raw_temp, int filtered_temp,
+					    bool *running)
+{
+	if (raw_temp < curve->stop_temp)
+		*running = false;
+	else if (raw_temp >= curve->temp[0])
+		*running = true;
+	if (!*running)
+		return 0;
+	return ps5_fan_interpolate(curve, filtered_temp);
+}
+
+static inline unsigned int ps5_fan_slew(unsigned int wanted,
+					unsigned int previous)
+{
+	if (wanted > previous && wanted - previous > 26)
+		return previous + 26;
+	if (wanted < previous && previous - wanted > 13)
+		return previous - 13;
+	return wanted;
+}
+
+static inline unsigned int ps5_pwm_to_duty(unsigned int pwm)
+{
+	return (pwm * 1024 + 127) / 255;
+}
+
+static inline unsigned int ps5_duty_to_pwm(unsigned int duty)
+{
+	return (duty * 255 + 512) / 1024;
+}
