PS5 HDMI: 1440p60 and 1440p120 in the mode list

The FLAVA3 setup has a 1440p path for +hsync -vsync timings, but many TVs list no 1440p, so it never showed
up (v2.1.x added these modes itself). The two standard timings are offered when the display has 1440p or larger
modes and isHdmiModeValid() accepts them for it.
---
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 1dea1e231..a8f7777b0 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -3392,6 +3392,46 @@ static bool dm_ps5_mode_larger(const struct drm_display_mode *a,
 	return a->clock > b->clock;
 }
 
+/*
+ * 1440p in the timings the FLAVA3 setup is made for (+hsync, -vsync): 1440p60 VESA reduced blanking and
+ * 1440p120 CVT-RB. Many TVs list no 1440p at all; isHdmiModeValid() still decides per display.
+ */
+static const struct drm_display_mode dm_ps5_1440p[] = {
+	{ DRM_MODE("2560x1440", DRM_MODE_TYPE_DRIVER, 241500, 2560, 2608, 2640, 2720, 0,
+		   1440, 1443, 1448, 1481, 0, DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NVSYNC) },
+	{ DRM_MODE("2560x1440", DRM_MODE_TYPE_DRIVER, 497750, 2560, 2608, 2640, 2720, 0,
+		   1440, 1443, 1448, 1525, 0, DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NVSYNC) },
+};
+
+static int dm_ps5_add_1440p(struct drm_connector *connector)
+{
+	const struct drm_display_info *info = &connector->display_info;
+	struct drm_display_mode *m, *mode;
+	bool big = false;
+	int i, added = 0;
+
+	list_for_each_entry(m, &connector->probed_modes, head)
+		big |= m->hdisplay >= 2560 && m->vdisplay >= 1440;
+	if (!big || !getHdmiExtendedModes())
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(dm_ps5_1440p); i++) {
+		if (!isHdmiModeValid(&dm_ps5_1440p[i], info, amdgpu_force_1080p))
+			continue;
+		list_for_each_entry(m, &connector->probed_modes, head)
+			if (drm_mode_equal(m, &dm_ps5_1440p[i]))
+				goto next;
+		mode = drm_mode_duplicate(connector->dev, &dm_ps5_1440p[i]);
+		if (mode) {
+			drm_mode_set_name(mode);
+			drm_mode_probed_add(connector, mode);
+			added++;
+		}
+next:
+		;
+	}
+	return added;
+}
+
 /* Keep a stock mode preferred when one passes validation. */
 static void dm_ps5_set_preferred_mode(struct drm_connector *connector)
 {
@@ -3460,8 +3500,10 @@ static int amdgpu_dm_connector_get_modes(struct drm_connector *connector)
 			amdgpu_dm_connector_add_common_modes(encoder, connector);
 		amdgpu_dm_connector_add_freesync_modes(connector, drm_edid);
 #ifdef CONFIG_X86_PS5
-		if (dm_ps5_is_hdmi_connector(connector))
+		if (dm_ps5_is_hdmi_connector(connector)) {
+			amdgpu_dm_connector->num_modes += dm_ps5_add_1440p(connector);
 			dm_ps5_set_preferred_mode(connector);
+		}
 #endif
 	}
 	amdgpu_dm_fbc_init(connector);
