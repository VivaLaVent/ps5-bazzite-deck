+/* The bridge's own setups; FLAVA3 takes any other timing through its manual setup (index 0x05, from rmux) */
+static bool hdmi_mode_is_preset(const struct drm_display_mode *mode)
+{
+	u8 vic = drm_match_cea_mode(mode);
+
+	if (mode->hdisplay == 2560 && mode->vdisplay == 1440)
+		return mode->htotal == 2720;
+	return vic == 16 || vic == 63 || vic == 64 || vic == 97 || ps5_mode_frl(vic);
+}
+
+static bool manual_timing;
+
+static void setManualTimingFlava3(const struct drm_display_mode *mode)
+{
+	u16 hstart = mode->htotal - mode->hsync_start - 2;
+	u16 vstart = mode->vtotal - mode->vsync_start + 1;
+	u16 width = mode->hdisplay - 1;
+	u16 height = mode->vdisplay - 1;
+	u16 htotal = mode->htotal - 1;
+	u16 hsync = mode->hsync_end - mode->hsync_start - 1;
+	u32 frame = (u32)mode->htotal * mode->vtotal - 1;
+	u32 vsync = (u32)mode->htotal * (mode->vsync_end - mode->vsync_start) - 1;
+	u16 clock = mode->clock / 1000;
+
+	i2c_write_data(0x7042, (u8[]){hstart, hstart >> 8, vstart, vstart >> 8,
+		       width, width >> 8, height, height >> 8}, 8);
+	i2c_write(0x704f, 0x12);
+	i2c_write_data(0x7063, (u8[]){htotal, htotal >> 8, hsync, hsync >> 8,
+		       frame, frame >> 8, frame >> 16, frame >> 24,
+		       vsync, vsync >> 8, vsync >> 16}, 11);
+	i2c_write_data(0x7078, (u8[]){clock, 0x80 | ((clock >> 8) & 0x07)}, 2);
+}
