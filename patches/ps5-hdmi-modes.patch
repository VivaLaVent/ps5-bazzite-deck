+/*
+ * 2560x1440@120 (497.75 MHz, above the 340 MHz HDMI 1.4 limit) is allowed on
+ * FLAVA3, where the bridge is set up like 4K60 for it (TMDS 1/40 clock ratio,
+ * scrambling). Other bridges have no high-bandwidth setup for 1440p.
+ */
+
+static bool hdmi_mode_is_hi_rate(const struct drm_display_mode *mode)
+{
+	return mode->clock > 340000;
+}
+
 bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
 {
 	u8 vic = drm_match_cea_mode(mode);
@@ -1283,9 +1300,14 @@ bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
 	if (force_1080p)
 		return vic == 16; /* 1080p60 */
 
-	/* 1440p */
+	/* 1440p: only the standard timings the bridge's 1440p setup is made for */
 	if (mode->hdisplay == 2560 && mode->vdisplay == 1440) {
-		return mode->clock == 241500 || mode->clock == 241700;
+		if (mode->htotal != 2720)
+			return false;
+		if ((mode->clock == 241500 || mode->clock == 241700) && mode->vtotal == 1481)
+			return true;	/* 1440p60, VESA DMT reduced blanking */
+		return hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 &&
+		       mode->clock == 497750 && mode->vtotal == 1525;	/* 1440p120, CVT-RB */
 	}
 
 	switch (vic) {
@@ -1299,6 +1321,163 @@ bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
