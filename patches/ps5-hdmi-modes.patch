+/*
+ * The modes the HDMI bridge has a setup for, in their standard timings:
+ * 1080p60 (VIC 16), 1080p120 (VIC 63), 2160p60 (VIC 97), 1440p60 (VESA DMT
+ * reduced blanking) and, on FLAVA3, 1440p120 (CVT-RB). The sink's own
+ * variants of 1440p are dropped by isHdmiModeValid(); the standard ones are
+ * offered whenever the sink's limits allow them, also when its EDID doesn't
+ * list them: its highest refresh rate (range descriptor or any listed mode),
+ * its max TMDS clock, and for 1440p/2160p a listed mode at that size or above.
+ * 1080p60 is marked preferred, so a new display starts there; compositors
+ * remember a higher mode once it is picked.
+ */
+static const struct drm_display_mode ps5_1440p60 = {
+	DRM_MODE("2560x1440", DRM_MODE_TYPE_DRIVER, 241500,
+		 2560, 2608, 2640, 2720, 0, 1440, 1443, 1448, 1481, 0,
+		 DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NVSYNC)
+};
+
+static const struct drm_display_mode ps5_1440p120 = {
+	DRM_MODE("2560x1440", DRM_MODE_TYPE_DRIVER, 497750,
+		 2560, 2608, 2640, 2720, 0, 1440, 1443, 1448, 1525, 0,
+		 DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NVSYNC)
+};
+
+static bool ps5_has_mode(struct drm_connector *connector, const struct drm_display_mode *want)
+{
+	struct drm_display_mode *m;
+
+	list_for_each_entry(m, &connector->probed_modes, head)
+		if (drm_mode_match(m, want, DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+			return true;
+	return false;
+}
+
+static int ps5_add_mode(struct drm_connector *connector, struct drm_display_mode *mode)
+{
+	if (!mode)
+		return 0;
+	if (ps5_has_mode(connector, mode)) {
+		drm_mode_destroy(connector->dev, mode);
+		return 0;
+	}
+	mode->type = DRM_MODE_TYPE_DRIVER;
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+int ps5_hdmi_add_modes(struct drm_connector *connector)
+{
+	struct drm_device *dev = connector->dev;
+	const struct drm_display_info *info = &connector->display_info;
+	int tmds = info->max_tmds_clock ? info->max_tmds_clock : 340000;
+	int max_hz = info->monitor_range.max_vfreq;
+	bool has_1440 = false, has_2160 = false;
+	struct drm_display_mode *m;
+	int added = 0;
+
+	if (list_empty(&connector->probed_modes))
+		return 0;	/* no EDID */
+
+	list_for_each_entry(m, &connector->probed_modes, head) {
+		max_hz = max(max_hz, drm_mode_vrefresh(m));
+		if (m->vdisplay >= 1440 && m->hdisplay >= 2560)
+			has_1440 = true;
+		if (m->vdisplay >= 2160 && m->hdisplay >= 3840)
+			has_2160 = true;
+		m->type &= ~DRM_MODE_TYPE_PREFERRED;
+	}
+
+	added += ps5_add_mode(connector, drm_display_mode_from_cea_vic(dev, 16));
+	if (max_hz >= 119 && tmds >= 297000)
+		added += ps5_add_mode(connector, drm_display_mode_from_cea_vic(dev, 63));
+	if (has_2160 && tmds >= 594000)
+		added += ps5_add_mode(connector, drm_display_mode_from_cea_vic(dev, 97));
+	if (has_1440 && tmds >= 241500)
+		added += ps5_add_mode(connector, drm_mode_duplicate(dev, &ps5_1440p60));
+	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 && has_1440 && max_hz >= 119 &&
+	    tmds >= 497750)
+		added += ps5_add_mode(connector, drm_mode_duplicate(dev, &ps5_1440p120));
+
+	list_for_each_entry(m, &connector->probed_modes, head) {
+		if (drm_match_cea_mode(m) == 16) {
+			m->type |= DRM_MODE_TYPE_PREFERRED;
+			break;
+		}
+	}
+	pr_info("modes: standard set added %d (max %d Hz, TMDS %d MHz, 1440p %d, 2160p %d), 1080p60 preferred\n",
+		added, max_hz, tmds / 1000, has_1440, has_2160);
+	return added;
+}
+EXPORT_SYMBOL(ps5_hdmi_add_modes);
+
+/*
+ * FLAVA3 places a 1440p picture as if the signal had the timing of the
+ * standard 2560x1440@60 (VESA DMT / CVT-RB, +hsync -vsync): horizontally it
+ * starts the picture 112 px after the rising edge of hsync (32 px pulse +
+ * 80 px back porch), vertically 33 lines after the vsync pulse. A sync with
+ * the other polarity moves the picture by the pulse width: -hsync 32 px to
+ * the left (Elgato 4K X), +vsync 5 lines up (LG TVs' 1440p120). So give both
+ * syncs the standard shape and polarity. The standard timings offered above
+ * already have it; this is the safety net for the sink's and desktop modes.
+ */
+#define PS5_FLAVA3_1440P_HSW	32
+#define PS5_FLAVA3_1440P_HBP	80
+#define PS5_FLAVA3_1440P_VBP	33
+
+static bool ps5_set_sync(int disp, int total, int bp, int width, u16 *start, u16 *end)
+{
+	int new_end = total - bp;
+	int new_start = new_end - width;
+
+	if (width <= 0 || new_start <= disp ||
+	    (new_start == *start && new_end == *end))
+		return false;
+	*start = new_start;
+	*end = new_end;
+	return true;
+}
+
+void ps5_hdmi_fixup_timing(struct drm_display_mode *m)
+{
+	static u16 last_hs, last_vs;
+	static u32 last_flags;
+	bool h, v, pol = false;
+
+	if (hdmi_ic_type != HDMI_IC_TYPE_FLAVA3 ||
+	    m->hdisplay != 2560 || m->vdisplay != 1440)
+		return;
+
+	h = ps5_set_sync(m->hdisplay, m->htotal, PS5_FLAVA3_1440P_HBP,
+			 PS5_FLAVA3_1440P_HSW, &m->hsync_start, &m->hsync_end);
+	v = ps5_set_sync(m->vdisplay, m->vtotal, PS5_FLAVA3_1440P_VBP,
+			 m->vsync_end - m->vsync_start, &m->vsync_start, &m->vsync_end);
+	ps5_set_sync(m->crtc_hdisplay, m->crtc_htotal, PS5_FLAVA3_1440P_HBP,
+		     PS5_FLAVA3_1440P_HSW, &m->crtc_hsync_start, &m->crtc_hsync_end);
+	ps5_set_sync(m->crtc_vdisplay, m->crtc_vtotal, PS5_FLAVA3_1440P_VBP,
+		     m->crtc_vsync_end - m->crtc_vsync_start,
+		     &m->crtc_vsync_start, &m->crtc_vsync_end);
+	if (m->flags & DRM_MODE_FLAG_NHSYNC) {
+		m->flags = (m->flags & ~DRM_MODE_FLAG_NHSYNC) | DRM_MODE_FLAG_PHSYNC;
+		pol = true;
+	}
+	if (m->flags & DRM_MODE_FLAG_PVSYNC) {
+		m->flags = (m->flags & ~DRM_MODE_FLAG_PVSYNC) | DRM_MODE_FLAG_NVSYNC;
+		pol = true;
+	}
+	if ((h || v || pol) &&
+	    (m->hsync_start != last_hs || m->vsync_start != last_vs || m->flags != last_flags)) {
+		last_hs = m->hsync_start;
+		last_vs = m->vsync_start;
+		last_flags = m->flags;
+		pr_info("FLAVA3 1440p: standard syncs (hsync %d-%d +, vsync %d-%d %c)\n",
+			m->hsync_start, m->hsync_end, m->vsync_start, m->vsync_end,
+			(m->flags & DRM_MODE_FLAG_PVSYNC) ? '+' : '-');
+	}
+}
+EXPORT_SYMBOL(ps5_hdmi_fixup_timing);
+
 bool isHdmiHdrSupported(void)
 {
 	return hdmi_ic_type == HDMI_IC_TYPE_FLAVA3;
