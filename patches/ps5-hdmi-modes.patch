--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1610,6 +1610,10 @@ create_stream_for_sink(struct drm_connector *connector,
 	if (recalculate_timing)
 		drm_mode_set_crtcinfo(&saved_mode, 0);
 
+#ifdef CONFIG_X86_PS5
+	ps5_hdmi_fixup_timing(&mode);
+#endif
+
 	/*
 	 * If scaling is enabled and refresh rate didn't change
 	 * we copy the vic and polarities of the old timings
@@ -2553,6 +2557,16 @@ enum drm_mode_status amdgpu_dm_connector_mode_valid(struct drm_connector *connec
 #ifdef CONFIG_X86_PS5
 	if (!isHdmiModeValid(mode, amdgpu_force_1080p))
 		return MODE_ERROR;
+
+	/*
+	 * The PS5 HDMI bridge is always set up for RGB/4:4:4 (the AVI InfoFrame
+	 * it sends says RGB), so a mode the sink only accepts as YCbCr 4:2:0
+	 * (e.g. 4K60 on TVs/ports limited to HDMI 1.4 bandwidth) is sent as
+	 * 4:2:0 but decoded as RGB: half-width, wrong colours, noise. Drop
+	 * those modes so the next valid mode (usually 1080p) is used.
+	 */
+	if (drm_mode_is_420_only(&connector->display_info, mode))
+		return MODE_ERROR;
 #endif
 
 	if ((mode->flags & DRM_MODE_FLAG_INTERLACE) ||
@@ -3198,6 +3212,9 @@ static int amdgpu_dm_connector_get_modes(struct drm_connector *connector)
 		}
 	} else {
 		amdgpu_dm_connector_ddc_get_modes(connector, drm_edid);
+#ifdef CONFIG_X86_PS5
+		amdgpu_dm_connector->num_modes += ps5_hdmi_add_modes(connector);
+#endif
 		if (encoder)
 			amdgpu_dm_connector_add_common_modes(encoder, connector);
 		amdgpu_dm_connector_add_freesync_modes(connector, drm_edid);
