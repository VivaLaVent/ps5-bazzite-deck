+	int ret, aux_ret = -ENODATA;
+
+	spin_lock_irqsave(&dm->ps5_usbc_work_lock, flags);
+	rescan = dm->ps5_usbc_rescan;
+	dm->ps5_usbc_rescan = false;
+	spin_unlock_irqrestore(&dm->ps5_usbc_work_lock, flags);
+	if (!READ_ONCE(dm->ps5_usbc_running))
+		return;
+
+	ret = ps5_usbc_dp_get_state(&state);
+	if (ret) {
+		dev_warn_ratelimited(dm->adev->dev, "USB-C state query failed: %d\n", ret);
+		state = dm->ps5_usbc_state;
+	}
+	ps5_usbc_dp_get_mode(&mode);
+	changed = !ret && (!dm->ps5_usbc_state_valid ||
+		state.dp_alt != dm->ps5_usbc_state.dp_alt ||
+		state.hpd != dm->ps5_usbc_state.hpd ||
+		state.orientation != dm->ps5_usbc_state.orientation ||
+		state.pin_assignment != dm->ps5_usbc_state.pin_assignment);
+
+	scoped_guard(mutex, &aconnector->hpd_lock) {
+		guard(mutex)(&dm->dc_lock);
+		dc_exit_ips_for_hw_access(dm->dc);
+		native_hpd = link->link_enc->funcs->get_hpd_state(link->link_enc);
+		if (native_hpd) {
+			WRITE_ONCE(link->ps5_aux_connected, false);
+			dm->ps5_usbc_aux_failures = 0;
+		} else if (link->ps5_probe_without_hpd) {
+			/* The normal AUX path acquires the GPIO pads and enables AUX.
+			 * A valid receiver reply is required to admit detection.
+			 */
+			aux_ret = drm_dp_dpcd_read(&aconnector->dm_dp_aux.aux,
+						 DP_DPCD_REV, dpcd, sizeof(dpcd));
+			if (aux_ret == (int)sizeof(dpcd) &&
+			    ps5_usbc_dp_receiver_present(dpcd, sizeof(dpcd))) {
+				WRITE_ONCE(link->ps5_aux_connected, true);
+				dm->ps5_usbc_aux_failures = 0;
+			} else if (dm->ps5_usbc_aux_failures < 3 &&
+				   ++dm->ps5_usbc_aux_failures == 3) {
+				WRITE_ONCE(link->ps5_aux_connected, false);
+			}
+		}
+		active = native_hpd || READ_ONCE(link->ps5_aux_connected);
+	}
+	changed |= native_hpd != dm->ps5_usbc_native_hpd;
+	changed |= active != dm->ps5_usbc_detected_active;
+	dm->ps5_usbc_native_hpd = native_hpd;
+	if (!ret) {
+		dm->ps5_usbc_state = state;
+		dm->ps5_usbc_state_valid = true;
+	}
+	if (changed || rescan)
+		drm_info(aconnector->base.dev,
+			 "PS5 USB-C %s: AUX index=%u HPD index=%u mode=%u candidate_alt=%u candidate_hpd=%u native_hpd=%u logical_connected=%u aux_probe=%d orientation=%u pin=%u\n",
+			 aconnector->base.name, link->ddc_hw_inst, link->hpd_src,
+			 mode, state.dp_alt, state.hpd, native_hpd, active, aux_ret, state.orientation,
+			 state.pin_assignment);
+
+	/* Reuse DRM's connection/disconnection and MST handling, with real AUX. */
+	if (active != dm->ps5_usbc_detected_active || rescan ||
+	    (active && !aconnector->dc_sink &&
+				link->type != dc_connection_mst_branch)) {
+		handle_hpd_irq_helper(aconnector, DETECT_REASON_HPD);
+		dm->ps5_usbc_detected_active = active;
+		if (active && link->local_sink)
+			drm_dbg_kms(aconnector->base.dev,
+				    "PS5 USB-C AUX index=%u: DPCD rev=%#x EDID bytes=%u monitor=%s\n",
+				    link->ddc_hw_inst, link->dpcd_caps.dpcd_rev.raw,
+				    link->local_sink->dc_edid.length,
+				    link->local_sink->edid_caps.display_name);
+	}
+	amdgpu_dm_ps5_usbc_queue(dm, msecs_to_jiffies(1000), false);
+}
+
+static int amdgpu_dm_ps5_usbc_notify(struct notifier_block *nb,
+				    unsigned long event, void *data)
+{
+	struct amdgpu_display_manager *dm =
+		container_of(nb, struct amdgpu_display_manager, ps5_usbc_notifier);
+
+	amdgpu_dm_ps5_usbc_queue(dm, 0, true);
+	return NOTIFY_OK;
+}
+
+int amdgpu_dm_ps5_usbc_configure(struct amdgpu_display_manager *dm)
+{
+	int ret;
+
+	if (!dm->ps5_usbc_connector || dm->ps5_usbc_configured)
+		return 0;
+	ret = ps5_usbc_dp_enable();
+	if (ret) {
+		ps5_usbc_dp_disable();
+		dev_warn(dm->adev->dev, "USB-C DP initialization failed: %d\n", ret);
+		return ret;
+	}
+	dm->ps5_usbc_configured = ps5_usbc_dp_enabled();
+	return 0;
+}
+
+void amdgpu_dm_ps5_usbc_start(struct amdgpu_display_manager *dm)
+{
+	unsigned long flags;
+
+	if (!dm->ps5_usbc_connector)
+		return;
+	/* A rejected policy SET must not suppress native HPD/AUX observation. */
+	amdgpu_dm_ps5_usbc_configure(dm);
+	dm->ps5_usbc_state_valid = false;
+	dm->ps5_usbc_aux_failures = 0;
+	WRITE_ONCE(dm->ps5_usbc_connector->dc_link->ps5_aux_connected, false);
+	spin_lock_irqsave(&dm->ps5_usbc_work_lock, flags);
+	WRITE_ONCE(dm->ps5_usbc_running, true);
+	spin_unlock_irqrestore(&dm->ps5_usbc_work_lock, flags);
+	amdgpu_dm_ps5_usbc_queue(dm, 0, true);
+}
+
+void amdgpu_dm_ps5_usbc_stop(struct amdgpu_display_manager *dm)
+{
+	unsigned long flags;
+
+	if (!dm->ps5_usbc_connector)
+		return;
+	spin_lock_irqsave(&dm->ps5_usbc_work_lock, flags);
+	WRITE_ONCE(dm->ps5_usbc_running, false);
+	spin_unlock_irqrestore(&dm->ps5_usbc_work_lock, flags);
+	cancel_delayed_work_sync(&dm->ps5_usbc_work);
+	WRITE_ONCE(dm->ps5_usbc_connector->dc_link->ps5_aux_connected, false);
+	if (dm->ps5_usbc_configured) {
+		ps5_usbc_dp_disable();
+		dm->ps5_usbc_configured = false;
+	}
+}
+
+void amdgpu_dm_ps5_usbc_init(struct amdgpu_display_manager *dm)
+{
+	struct drm_connector_list_iter iter;
+	struct drm_connector *connector, *hdmi = NULL;
+	struct amdgpu_dm_connector *usbc = NULL;
+	unsigned int usbc_count = 0, hdmi_count = 0;
+	int ret;
+
+	drm_connector_list_iter_begin(dm->ddev, &iter);
+	drm_for_each_connector_iter(connector, &iter) {
+		struct amdgpu_dm_connector *aconnector;
+		struct dc_link *link;
+
+		if (connector->connector_type == DRM_MODE_CONNECTOR_WRITEBACK)
+			continue;
+		aconnector = to_amdgpu_dm_connector(connector);
+		link = aconnector->dc_link;
+		if (!link || aconnector->mst_root || link->ep_type != DISPLAY_ENDPOINT_PHY)
+			continue;
+		drm_info(dm->ddev,
+			 "PS5 display route: %s link=%u AUX index=%u (DDC%u) HPD index=%u (HPD_SOURCEID%u) BIOS USB-C=%u selected=%u\n",
+			 connector->name, link->link_index, link->ddc_hw_inst,
+			 link->ddc_hw_inst + 1, link->hpd_src, link->hpd_src + 1,
+			 link->link_id.id == CONNECTOR_ID_USBC ||
+			 link->link_enc->features.flags.bits.DP_IS_USB_C, link->ps5_usbc);
+		if (link->ps5_usbc) {
+			usbc = aconnector;
+			usbc_count++;
+		} else if (dc_is_dp_signal(link->connector_signal) ||
+			   dc_is_hdmi_signal(link->connector_signal)) {
+			hdmi = connector;
+			hdmi_count++;
+		}
+	}
+	drm_connector_list_iter_end(&iter);
+	if (hdmi_count == 1)
+		ps5_hdmi_set_connector(hdmi);
+	if (usbc_count != 1 || hdmi_count != 1) {
+		drm_warn(dm->ddev,
+			 "PS5 USB-C disabled: routing is ambiguous (USB-C=%u HDMI=%u); verify VBIOS and set usbc_dp.aux/usbc_dp.hpd\n",
+			 usbc_count, hdmi_count);
+		return;
+	}
+
+	dm->ps5_usbc_connector = usbc;
+	spin_lock_init(&dm->ps5_usbc_work_lock);
+	INIT_DELAYED_WORK(&dm->ps5_usbc_work, amdgpu_dm_ps5_usbc_work);
+	dm->ps5_usbc_notifier.notifier_call = amdgpu_dm_ps5_usbc_notify;
+	ret = ps5_usbc_register_notifier(&dm->ps5_usbc_notifier);
+	if (ret) {
+		drm_warn(dm->ddev, "PS5 USB-C notifier registration failed: %d\n", ret);
+		dm->ps5_usbc_connector = NULL;
+		return;
+	}
+	amdgpu_dm_ps5_usbc_start(dm);
+}
+
+void amdgpu_dm_ps5_usbc_fini(struct amdgpu_display_manager *dm)
+{
+	amdgpu_dm_ps5_usbc_stop(dm);
+	if (dm->ps5_usbc_connector) {
+		ps5_usbc_unregister_notifier(&dm->ps5_usbc_notifier);
+		dm->ps5_usbc_connector = NULL;
+	}
+	ps5_hdmi_set_connector(NULL);
+}
