PS5 HDMI: full-rate DP link to the HDMI bridge

Train the DP link to the HDMI bridge at its full verified rate (4 lanes HBR3)
for every mode, instead of the lowest rate the mode needs: the bridge
sometimes fails to sync on the lower rates amdgpu picks below 4K. With it,
v1.4.0-rc1 testers saw no black screens at any resolution. No option: if
training at the full rate ever fails (the #54 hotplug work sees a stream
whose link isn't active), the fixed rate is released for the rest of the
session and amdgpu chooses and falls back by itself again, logged once.
---

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index 1c7ebfdb2..3d28a374f 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -746,6 +746,8 @@ struct amdgpu_display_manager {
 #ifdef CONFIG_X86_PS5
 	struct delayed_work ps5_hotplug_work;
 	unsigned int ps5_hotplug_failures;
+	/* the full-rate DP link was released after a failed training (amdgpu chooses the rate) */
+	bool ps5_link_lock_released;
 	struct delayed_work ps5_hdmi_resetup_work;
 	unsigned long ps5_hdmi_resetup_until;
 	bool ps5_hdmi_resetup;
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 569003a81..df4752b25 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1612,6 +1612,26 @@ create_stream_for_sink(struct drm_connector *connector,
 
 #ifdef CONFIG_X86_PS5
 	ps5_hdmi_fixup_timing(&mode);
+	if (aconnector && aconnector->dc_link && !drm_to_adev(connector->dev)->dm.ps5_link_lock_released &&
+	    aconnector->dc_link->verified_link_cap.lane_count != LANE_COUNT_UNKNOWN &&
+	    aconnector->dc_link->verified_link_cap.link_rate != LINK_RATE_UNKNOWN) {
+		struct dc_link *link = aconnector->dc_link;
+
+		/*
+		 * Train the DP link to the HDMI bridge at its full verified rate
+		 * (4 lanes HBR3) for every mode, not the lowest rate the mode needs:
+		 * the bridge sometimes fails to sync on the lower rates.
+		 */
+		if (link->preferred_link_setting.lane_count != link->verified_link_cap.lane_count ||
+		    link->preferred_link_setting.link_rate != link->verified_link_cap.link_rate) {
+			link->preferred_link_setting.lane_count = link->verified_link_cap.lane_count;
+			link->preferred_link_setting.link_rate = link->verified_link_cap.link_rate;
+			link->preferred_link_setting.link_spread = link->verified_link_cap.link_spread;
+			link->preferred_link_setting.use_link_rate_set = false;
+			pr_info("PS5: DP link locked to %d lanes, rate 0x%x\n",
+				link->verified_link_cap.lane_count, link->verified_link_cap.link_rate);
+		}
+	}
 #endif
 
 	/*
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
index 246d822d8..7ebcfcba3 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
@@ -1492,6 +1492,27 @@ void dm_ps5_hotplug_work_func(struct work_struct *work)
 	drm_connector_list_iter_end(&iter);
 
 	failures = dm_ps5_link_failed(dev) ? dm->ps5_hotplug_failures + 1 : 0;
+	if (failures && !dm->ps5_link_lock_released) {
+		/*
+		 * Training at the full link rate failed: release the fixed rate, so
+		 * amdgpu chooses (and falls back) by itself from now on.
+		 */
+		drm_connector_list_iter_begin(dev, &iter);
+		drm_for_each_connector_iter(connector, &iter) {
+			struct dc_link *link;
+
+			if (connector->connector_type != DRM_MODE_CONNECTOR_DisplayPort)
+				continue;
+			link = to_amdgpu_dm_connector(connector)->dc_link;
+			if (link) {
+				link->preferred_link_setting.lane_count = LANE_COUNT_UNKNOWN;
+				link->preferred_link_setting.link_rate = LINK_RATE_UNKNOWN;
+			}
+		}
+		drm_connector_list_iter_end(&iter);
+		dm->ps5_link_lock_released = true;
+		drm_info(dev, "PS5: DP link training failed at full rate, letting amdgpu choose the rate\n");
+	}
 	if (failures == PS5_HOTPLUG_RETRIES)
 		drm_warn(dev, "PS5: DP link training keeps failing after HDMI hotplug, backing off\n");
 	else if (!failures && dm->ps5_hotplug_failures >= PS5_HOTPLUG_RETRIES)
