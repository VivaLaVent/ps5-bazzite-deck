+static long mp1_query(unsigned long arg, u8 msgid)
+{
+	struct mp1_query __user *uq = (struct mp1_query __user *)arg;
+	struct mp1_query q;
+	struct mp1_msg msg = {};
+	int ret;
+
+	if (!mp1_viola)
+		return -ENOTTY;
+
+	if (copy_from_user(&q, uq, sizeof(q)))
+		return -EFAULT;
+
+	msg.arg = q.arg;
+	ret = mp1fw_sendmsg(&msg, msgid);
+	if (ret)
+		return ret;
+
+	q.val = msg.resp_val;
+	if (copy_to_user(uq, &q, sizeof(q)))
+		return -EFAULT;
+
+	return 0;
+}
