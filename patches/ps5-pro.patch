+
+static int ps5_read_sensor(struct smu_context *smu,
+			   enum amd_pp_sensors sensor,
+			   void *data,
+			   uint32_t *size)
+{
+	uint32_t *value = data;
+	int temp, ret;
+
+	if (!data || !size)
+		return -EINVAL;
+
+	switch (sensor) {
+	case AMDGPU_PP_SENSOR_GFX_SCLK:
+		ret = ps5_get_gfxclk(smu, value);
+		if (ret)
+			return ret;
+		*value *= 100;
+		break;
+	case AMDGPU_PP_SENSOR_EDGE_TEMP:
+		ret = ps5_get_gpu_temp(smu, &temp);
+		if (ret)
+			return ret;
+		*value = temp;
+		break;
+	case AMDGPU_PP_SENSOR_GPU_LOAD:
+		*value = amdgpu_fence_ps5_busy_percent(smu->adev);
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	*size = 4;
+
+	return 0;
+}
+
+static int ps5_emit_clk_levels(struct smu_context *smu,
+			       enum smu_clk_type clk_type, char *buf,
+			       int *offset)
+{
+	uint32_t cur_value;
+	int ret;
+
+	switch (clk_type) {
+	case SMU_SCLK:
+	case SMU_GFXCLK:
+		ret = ps5_get_gfxclk(smu, &cur_value);
+		if (ret)
+			return ret;
+		*offset += sysfs_emit_at(buf, *offset, "0: %uMhz *\n", cur_value);
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+/* Keep reporting the VBIOS default clocks, as amdgpu did without DPM. */
+static int ps5_get_dpm_ultimate_freq(struct smu_context *smu,
+				     enum smu_clk_type clk_type,
+				     uint32_t *min,
+				     uint32_t *max)
+{
+	struct amdgpu_device *adev = smu->adev;
+	uint32_t clk;
+
+	switch (clk_type) {
+	case SMU_GFXCLK:
+	case SMU_SCLK:
+		clk = adev->clock.default_sclk / 100;
+		break;
+	case SMU_UCLK:
+	case SMU_MCLK:
+		clk = adev->clock.default_mclk / 100;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	if (!clk)
+		return -EOPNOTSUPP;
+
+	if (min)
+		*min = clk;
+	if (max)
+		*max = clk;
+
+	return 0;
+}
