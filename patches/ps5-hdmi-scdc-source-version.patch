PS5 HDMI: SCDC Source Version at every video setup

Issue #11: a TV ("Beyond TV", XXX 9615) offered its HDMI 2.1 EDID (4K60 RGB,
1080p120, 4K120, VRR) on v1.2.0 and an HDMI 1.4 EDID (340 MHz, 4K60 as
4:2:0 only, nothing above 60 Hz) on v1.3.0+, intermittently. v1.2.0 started
at 4K60 and wrote SCDC TMDS_Config at once; v1.3.0 starts at 1080p60 with no
SCDC traffic, and the TV then re-announced itself as HDMI 1.4 (second "got
real edid" at 40 s). HDMI 2.x sources write SCDC Source Version = 1 after
hotplug; now the bridge does that at every video setup, through its DDC
write descriptor at 0x7a80 (SCDC 0xa8, register 0x02, 1 byte), for sinks
that talk SCDC: an HDMI Forum VSDB with SCDC_Present, or 4K / 4:2:0-only
modes (an HDMI 2.x TV in its 1.4 fallback still lists those). 1080p-only
HDMI 1.4 TVs never get SCDC traffic.
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -125,6 +125,46 @@
 static u8 dp_polarity;
 static u8 dp_ch_swap;
 static bool scrambling;
+static bool sink_scdc;		/* the sink's EDID has an HDMI Forum VSDB with SCDC */
+
+/*
+ * Does this sink talk SCDC? True for an HDMI Forum VSDB (OUI C4-5D-D8) with
+ * SCDC_Present, and also for a sink that lists 4K modes (VIC 93+) or 4:2:0-only
+ * modes: an HDMI 2.x TV that has fallen back to its HDMI 1.4 EDID still does
+ * that, and it needs the SCDC Source Version to come back. A 1080p HDMI 1.4
+ * TV lists neither, and never gets SCDC traffic.
+ */
+static bool edid_has_scdc(const u8 *e, int len)
+{
+	int ext, i, j;
+
+	if (len < 256)
+		return false;
+	for (ext = 1; ext <= e[0x7e] && (ext + 1) * 128 <= len; ext++) {
+		const u8 *b = &e[ext * 128];
+		int d = b[2];
+
+		if (b[0] != 0x02 || d < 4 || d > 127)
+			continue;
+		for (i = 4; i < d; i += 1 + (b[i] & 0x1f)) {
+			int tag = b[i] >> 5, l = b[i] & 0x1f;
+			const u8 *p = &b[i + 1];
+
+			if (i + 1 + l > d)
+				break;
+			if (tag == 3 && l >= 7 && p[0] == 0xd8 && p[1] == 0x5d && p[2] == 0xc4 &&
+			    (p[5] & 0x80))
+				return true;				/* SCDC_Present */
+			if (tag == 2)
+				for (j = 0; j < l; j++)
+					if ((p[j] & 0x7f) >= 93)
+						return true;			/* a 4K mode */
+			if (tag == 7 && l >= 1 && p[0] == 14)
+				return true;				/* 4:2:0-only modes */
+		}
+	}
+	return false;
+}
 static bool hdr_enabled;
 static bool bt2020_enabled;
 
@@ -895,6 +935,24 @@
 	i2c_waitclear(0x7a84, 0x01);
 	i2c_begin_block();
 	i2c_write(0x7a8b, 0x05);
+	i2c_end_block();
+	if (sink_scdc) {
+		/*
+		 * SCDC Source Version = 1 at every setup, as HDMI 2.x sources do after
+		 * hotplug. Some TVs only present their HDMI 2.x EDID (4K60 RGB, 120 Hz,
+		 * VRR) to a source that writes it; the "Beyond TV" of issue #11 fell
+		 * back to an HDMI 1.4 EDID once we started at 1080p60 with no SCDC
+		 * traffic, and offered the modes again when the console started at 4K60
+		 * (TMDS_Config written). The 0x7a80 descriptor is the bridge's DDC
+		 * write: SCDC address 0xa8, register, length-1, start.
+		 */
+		i2c_begin_block();
+		i2c_write(0x7c00, 0x01);
+		i2c_write_data(0x7a80, (u8[]){0xa8, 0x02, 0x00, 0x80}, 4);
+		i2c_end_block();
+		i2c_waitclear(0x7a84, 0x01);
+	}
+	i2c_begin_block();
 	if (vic == 97 || hdmi_mode_is_hi_rate(mode) || scrambling) {
 		/* SCDC TMDS_Config: scrambling + 1/40 clock ratio above 340 MHz */
 		i2c_write(0x7c00, (vic == 97 || hdmi_mode_is_hi_rate(mode)) ? 0x03 : 0x00);
@@ -1746,6 +1804,7 @@
 		if (msg->data[1] == 0x02) {
 			fix_edid(&msg->data[4]);
 			real_edid = drm_edid_alloc(&msg->data[4], *(u16 *)&msg->data[2]);
+			sink_scdc = edid_has_scdc(&msg->data[4], *(u16 *)&msg->data[2]);
 			pr_info("got real edid\n");
 			sceHdmiOutputMode();
 
