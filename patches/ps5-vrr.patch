+/*
+ * VRR (FLAVA3 consoles).
+ *
+ * The fix is on the GPU side, which no ICC capture
+ * could show (stock-system captures narrowed it down):
+ *  1. Sony's GPU sends the HDMI chip a timing packet every frame, a DP extension SDP
+ *     (HB 39 04) with the source timing (amdgpu_dm_freesync.c). Without it the chip's
+ *     follow mode (0x6064=03) gives a black picture.
+ *  2. The chip drops its input lock when DPCD 0x107's MSA-ignore bit is set, but follows
+ *     a variable frame length with valid MSA: the bit stays clear (link_dpms.c).
+ *  3. The chip is switched to follow mode only after the packet flows, step by step,
+ *     plus a FreeSync SPD in its SPD slot 0x7240 for the TV.
+ * The setup itself stays normal; the follow block comes after it, with the picture muted
+ * until the chip has switched over (a short black instead of a drifting picture).
+ * Steam's VRR setting switches it; hdmi.vrr=0 never offers VRR.
+ */
+static bool vrr = true;
+module_param(vrr, bool, 0444);
+MODULE_PARM_DESC(vrr, "VRR on FLAVA3 consoles: offer the TV's VRR range, switched with Steam's VRR setting (default on; 0 never offers it)");
+static bool vrr_measure;
+module_param(vrr_measure, bool, 0644);
+MODULE_PARM_DESC(vrr_measure, "Log the measured frame intervals every 2 s while VRR is on, for debugging (default off)");
+
+#define VRR_FOLLOW_STEP_MS	250	/* between the follow steps (tested up to 1000) */
+#define VRR_FOLLOW_SETTLE_MS	500	/* after the last step, before the picture comes back */
+
+static bool vrr_requested;		/* VRR switched on, as last set up */
+static bool vrr_follow;			/* ... and the chip goes to follow mode */
+static bool vrr_follow_pending;		/* the setup's unmute waits for the follow block */
+static unsigned int vrr_follow_hz = 60;
+
+static u8 vrr_edid[512];
+static int vrr_edid_len;
+static DEFINE_SPINLOCK(vrr_edid_lock);
+
+/* copy of the sink's EDID for the VRR range, bounded by what the message holds */
+static void ps5_vrr_save_edid(const struct icc_msg *msg)
+{
+	int len = *(const u16 *)&msg->data[2];
+	int avail = (int)msg->length - (int)sizeof(*msg) - 4;
+	unsigned long flags;
+
+	len = clamp(min(len, avail), 0, (int)sizeof(vrr_edid));
+	spin_lock_irqsave(&vrr_edid_lock, flags);
+	memcpy(vrr_edid, &msg->data[4], len);
+	vrr_edid_len = len;
+	spin_unlock_irqrestore(&vrr_edid_lock, flags);
+}
+
+bool ps5_hdmi_vrr_possible(void)
+{
+	return vrr && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_possible);
+
+bool ps5_hdmi_ic_is_flava3(void)
+{
+	return hdmi_ic_type == HDMI_IC_TYPE_FLAVA3;
+}
+EXPORT_SYMBOL(ps5_hdmi_ic_is_flava3);
+
+bool ps5_hdmi_vrr_measure(void)
+{
+	return vrr_measure;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_measure);
+
+/* the TV's VRR range: HDMI Forum VSDB (VRRmin/VRRmax), else the AMD FreeSync VSDB */
+int ps5_hdmi_vrr_range(int *min_hz, int *max_hz, const char **src)
+{
+	int amd_min = 0, amd_max = 0, hf_min = 0, hf_max = 0;
+	int ext, n, i, len;
+	unsigned long flags;
+	u8 *e;
+
+	e = kmalloc(sizeof(vrr_edid), GFP_KERNEL);
+	if (!e)
+		return -ENOMEM;
+	spin_lock_irqsave(&vrr_edid_lock, flags);
+	len = vrr_edid_len;
+	memcpy(e, vrr_edid, len);
+	spin_unlock_irqrestore(&vrr_edid_lock, flags);
+
+	if (len < 128) {
+		kfree(e);
+		return -ENODATA;
+	}
+
+	n = e[0x7e];
+	for (ext = 1; ext <= n && (ext + 1) * 128 <= len; ext++) {
+		const u8 *b = &e[ext * 128];
+		int d = b[2];
+
+		if (b[0] != 0x02 || d < 4 || d > 127)
+			continue;
+		for (i = 4; i < d; i += 1 + (b[i] & 0x1f)) {
+			int tag = b[i] >> 5, l = b[i] & 0x1f;
+			const u8 *p = &b[i + 1];
+
+			if (tag != 3 || l < 3 || i + 1 + l > d)
+				continue;
+			if (p[0] == 0x1a && p[1] == 0x00 && p[2] == 0x00 && l >= 7) {
+				amd_min = p[5];
+				amd_max = p[6];
+			} else if (p[0] == 0xd8 && p[1] == 0x5d && p[2] == 0xc4 && l >= 10) {
+				hf_min = p[8] & 0x3f;
+				hf_max = ((p[8] & 0xc0) << 2) | p[9];
+			}
+		}
+	}
+	kfree(e);
+
+	if (hf_min >= 1 && hf_max > hf_min + 10) {
+		*min_hz = hf_min; *max_hz = hf_max; *src = "HDMI VRR range";
+	} else if (amd_min >= 1 && amd_max > amd_min + 10) {
+		*min_hz = amd_min; *max_hz = amd_max; *src = "FreeSync block";
+	} else {
+		return -ENODATA;
+	}
+	return 0;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_range);
+
+/* one I2C program to the chip, without the shared i2c_ctx (runs from a work item) */
+static int vrr_icc(const u8 *body, int n)
+{
+	static u8 buf[ICC_MSG_MAX_SIZE];
+	static DEFINE_MUTEX(lock);
+	struct icc_msg *msg = (struct icc_msg *)buf;
+	int ret;
+
+	mutex_lock(&lock);
+	memset(buf, 0, sizeof(buf));
+	msg->service_id = ICC_SERVICE_ID_HDMI;
+	msg->length = sizeof(*msg) + n;
+	memcpy(msg->data, body, n);
+	if (icc_trace)
+		icc_trace_dump("hdmi icc query: ", buf);
+	ret = icc_query(buf, buf);
+	if (!ret && buf[0xc])
+		ret = -EIO;
+	mutex_unlock(&lock);
+	return ret;
+}
+
+/* one block write of one register (code, then a 2/2 command) */
+static int vrr_icc_write(u8 code, u16 reg, const u8 *data, int len)
+{
+	u8 b[48];
+	int n = 0;
+
+	b[n++] = code; b[n++] = 0; b[n++] = 0; b[n++] = 1;
+	b[n++] = 0x02; b[n++] = 4 + 3 + len; b[n++] = 0x02; b[n++] = 1;
+	b[n++] = len; b[n++] = reg >> 8; b[n++] = reg & 0xff;
+	memcpy(b + n, data, len);
+	n += len;
+	b[1] = n & 0xff; b[2] = n >> 8;
+	return vrr_icc(b, n);
+}
+
+/* the unmute the setup left to the follow block (same code as sceHdmiDeviceSetVideoMute) */
+static void vrr_follow_unmute(void)
+{
+	if (xchg(&vrr_follow_pending, false))
+		vrr_icc_write(0x04, 0x705f, (u8[]){ 0x00 }, 1);
+}
+
+static void vrr_follow_fn(struct work_struct *work)
+{
+	static const struct { u16 reg; u8 len; u8 v[2]; } steps[] = {
+		{ 0x6064, 1, { 0x03 } }, { 0x1047, 1, { 0x30 } }, { 0x600c, 2, { 0x01, 0x00 } },
+		{ 0x6224, 2, { 0x40, 0x0f } }, { 0x6c07, 1, { 0x80 } },
+	};
+	u8 spd[30] = { 0x83, 0x01, 0x08, 0, 0x1a, 0, 0, 0, 0, 0x07 };
+	u8 b[64];
+	int i, n = 0, ret, sum = 0;
+
+	if (!READ_ONCE(vrr_follow))
+		goto out;
+	/* FreeSync SPD (AMD OUI; supported, enabled, active; min, max) in the SPD slot */
+	spd[10] = 40;
+	spd[11] = vrr_follow_hz;
+	for (i = 0; i < 12; i++)
+		sum += spd[i];
+	spd[3] = (256 - (sum & 0xff)) & 0xff;
+	b[n++] = 0x01; b[n++] = 0; b[n++] = 0; b[n++] = 4;
+	b[n++] = 0x02; b[n++] = 4 + 3 + 30; b[n++] = 0x02; b[n++] = 1;	/* 0x7240 = SPD */
+	b[n++] = 30; b[n++] = 0x72; b[n++] = 0x40;
+	memcpy(b + n, spd, 30); n += 30;
+	b[n++] = 0x02; b[n++] = 9; b[n++] = 0x03; b[n++] = 1;		/* 0x7203 |= 0x20 */
+	b[n++] = 1; b[n++] = 0x72; b[n++] = 0x03; b[n++] = 0x20; b[n++] = 0x20;
+	b[n++] = 0x02; b[n++] = 8; b[n++] = 0x02; b[n++] = 1;		/* 0x7204 = 0x20 */
+	b[n++] = 1; b[n++] = 0x72; b[n++] = 0x04; b[n++] = 0x20;
+	b[n++] = 0x03; b[n++] = 8; b[n++] = 0x03; b[n++] = 1;		/* until it's taken */
+	b[n++] = 0; b[n++] = 0x72; b[n++] = 0x04; b[n++] = 0x20;
+	b[1] = n & 0xff; b[2] = n >> 8;
+	ret = vrr_icc(b, n);
+	for (i = 0; i < ARRAY_SIZE(steps) && !ret; i++) {
+		msleep(VRR_FOLLOW_STEP_MS);
+		if (!READ_ONCE(vrr_follow))
+			goto out;
+		ret = vrr_icc_write(0x01, steps[i].reg, steps[i].v, steps[i].len);
+	}
+	if (ret)
+		pr_warn("VRR: switching the HDMI chip over failed (%d)\n", ret);
+	else
+		pr_info("VRR: on, %u-%u Hz\n", spd[10], vrr_follow_hz);
+	msleep(VRR_FOLLOW_SETTLE_MS);
+out:
+	vrr_follow_unmute();
+}
+static DECLARE_DELAYED_WORK(vrr_follow_work, vrr_follow_fn);
+
+void sceHdmiSetVrrMode(bool on)
+{
+	vrr_requested = on;
+	WRITE_ONCE(vrr_follow, on && ps5_hdmi_vrr_possible());
+	if (!vrr_follow) {
+		cancel_delayed_work(&vrr_follow_work);
+		WRITE_ONCE(vrr_follow_pending, false);	/* the coming setup unmutes as usual */
+	}
+}
+EXPORT_SYMBOL(sceHdmiSetVrrMode);
+
+bool sceHdmiGetVrrMode(void)
+{
+	return vrr_requested;
+}
+EXPORT_SYMBOL(sceHdmiGetVrrMode);
+
+/* end of a setup: the follow block once the timing packet flows, picture muted until then */
+static void vrr_follow_after_setup(const struct drm_display_mode *mode)
+{
+	if (!READ_ONCE(vrr_follow))
+		return;
+	WRITE_ONCE(vrr_follow_pending, true);
+	vrr_follow_hz = mode ? drm_mode_vrefresh(mode) : 60;
+	mod_delayed_work(system_dfl_wq, &vrr_follow_work, msecs_to_jiffies(VRR_FOLLOW_STEP_MS));
+}
