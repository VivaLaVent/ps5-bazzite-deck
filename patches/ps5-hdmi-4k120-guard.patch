+/*
+ * offer 4K120 only where it can work, and leave it
+ * by itself when it doesn't come up (no more black screen until a reboot).
+ *  - the display's EDID must announce FRL at 4 lanes x 8 Gbps or more (HF-VSDB or HF-SCDB
+ *    Max_FRL_Rate >= 4; the chip's 4K120 path needs that rate) and YCbCr 4:2:2 in a CTA block
+ *  - the chip's own report in byte 0 of its EDID notification (bits 3:1, the FRL rate it
+ *    found for the display) must not be 1-3
+ *  - after the 4K120 setup, the chip's 0x7019 bit 6 (set while it sends FRL) must come on;
+ *    if not, 4K120 is withheld for this display (same EDID) and amdgpu falls back to the
+ *    same size at the highest refresh still offered
+ */
+static u8 frl_ic_rate;
+static bool frl_edid_ok;
+static bool frl_failed;
+static u32 frl_edid_crc;
+static void (*frl_fallback_cb)(void);
+static atomic_t frl_check_seq = ATOMIC_INIT(0);
+
+void hdmi_set_frl_fallback(void (*cb)(void))
+{
+	WRITE_ONCE(frl_fallback_cb, cb);
+}
+EXPORT_SYMBOL(hdmi_set_frl_fallback);
+
+static bool frl_offer_ok(void)
+{
+	u8 rate = READ_ONCE(frl_ic_rate);
+
+	return READ_ONCE(frl_edid_ok) && !READ_ONCE(frl_failed) && !(rate && rate < 4);
+}
+
+static void edid_frl_caps(const u8 *e, int len, u8 *max_frl, bool *y422)
+{
+	int ext, n = len >= 128 ? e[0x7e] : 0, i;
+
+	*max_frl = 0;
+	*y422 = false;
+	for (ext = 1; ext <= n && (ext + 1) * 128 <= len; ext++) {
+		const u8 *b = &e[ext * 128];
+		int d = b[2];
+
+		if (b[0] != 0x02 || d < 4 || d > 127)
+			continue;
+		if (b[3] & 0x10)
+			*y422 = true;
+		for (i = 4; i < d; i += 1 + (b[i] & 0x1f)) {
+			int tag = b[i] >> 5, l = b[i] & 0x1f;
+
+			if (i + 1 + l > d || l < 7)
+				continue;
+			if ((tag == 3 && b[i + 1] == 0xd8 && b[i + 2] == 0x5d && b[i + 3] == 0xc4) ||
+			    (tag == 7 && b[i + 1] == 0x79))
+				*max_frl = max_t(u8, *max_frl, b[i + 7] >> 4);
+		}
+	}
+}
+
+/* EDID notification: the chip's FRL report and the display's capabilities for 4K120 */
+static void frl_note_edid(u8 byte0, const u8 *e, int len)
+{
+	u32 crc = crc32_le(~0, e, len);
+	u8 max_frl;
+	bool y422, ok;
+
+	u8 rate = (byte0 >> 1) & 7;
+	bool changed = crc != frl_edid_crc;
+
+	edid_frl_caps(e, len, &max_frl, &y422);
+	ok = max_frl >= 4 && y422;
+	if (changed) {
+		frl_edid_crc = crc;
+		WRITE_ONCE(frl_failed, false);	/* another display, or the same one changed */
+	}
+	if (changed || ok != READ_ONCE(frl_edid_ok) || rate != READ_ONCE(frl_ic_rate))
+		pr_info("hdmi: 4K120 %s (EDID FRL rate %u, YCbCr 4:2:2 %s, chip reports %u%s)\n",
+			ok && !READ_ONCE(frl_failed) && !(rate && rate < 4) ? "possible" : "not offered",
+			max_frl, y422 ? "yes" : "no", rate,
+			READ_ONCE(frl_failed) ? ", failed before with this display" : "");
+	WRITE_ONCE(frl_ic_rate, rate);
+	WRITE_ONCE(frl_edid_ok, ok);
+}
+
+/* one chip register, read through the EMC */
+static int hdmi_reg_read(u16 reg, u8 *val)
+{
+	static u8 buf[ICC_MSG_MAX_SIZE];
+	static DEFINE_MUTEX(lock);
+	const u8 body[] = { 0x04, 0x0c, 0x00, 0x01, 0x01, 0x08, 0x01, 0x01, 1, reg >> 8, reg & 0xff, 0x00 };
+	struct icc_msg *msg = (struct icc_msg *)buf;
+	int ret;
+
+	mutex_lock(&lock);
+	memset(buf, 0, sizeof(buf));
+	msg->service_id = ICC_SERVICE_ID_HDMI;
+	msg->length = sizeof(*msg) + sizeof(body);
+	memcpy(msg->data, body, sizeof(body));
+	ret = icc_query(buf, buf);
+	if (!ret && (msg->service_id != ICC_SERVICE_ID_HDMI || msg->length < sizeof(*msg) + 9 ||
+		     msg->data[0] || msg->data[1]))
+		ret = -EIO;
+	if (!ret)
+		*val = msg->data[8];
+	mutex_unlock(&lock);
+	return ret;
+}
+
+static void frl_check_fn(struct work_struct *work)
+{
+	int seq = atomic_read(&frl_check_seq), i;
+	void (*cb)(void);
+	u8 v = 0;
+
+	for (i = 0; i < 20; i++) {
+		if (atomic_read(&frl_check_seq) != seq)
+			return;		/* a new setup started */
+		if (!hdmi_reg_read(0x7019, &v) && (v & 0x40)) {
+			pr_info("hdmi: 4K120 link up (0x7019=%02x)\n", v);
+			return;
+		}
+		msleep(250);
+	}
+	if (atomic_read(&frl_check_seq) != seq)
+		return;
+	WRITE_ONCE(frl_failed, true);
+	pr_warn("hdmi: 4K120 link didn't come up (0x7019=%02x): not offered for this display any more, falling back\n", v);
+	cb = READ_ONCE(frl_fallback_cb);
+	if (cb)
+		cb();
+}
+static DECLARE_DELAYED_WORK(frl_check_work, frl_check_fn);
