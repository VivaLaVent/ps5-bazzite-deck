 {
-	return frl_4k120 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 && vic == 118;
+	return frl_4k120 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 && (vic == 118 || vic == 117);
 }
 
