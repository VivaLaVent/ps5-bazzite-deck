PS5 MediaTek Bluetooth (0e8d:3603): no ISO interface setup (ps5-linux-patches #71)

The ISO setup times out, and the reset after it leaves Bluetooth broken after a warm restart until a
cold boot. The PS5 Pro (0e8d:3605) already skips it.
---
diff --git a/drivers/bluetooth/btusb.c b/drivers/bluetooth/btusb.c
index acca46b03..0edb24fab 100644
--- a/drivers/bluetooth/btusb.c
+++ b/drivers/bluetooth/btusb.c
@@ -63,6 +63,13 @@ static bool btusb_is_ps5_viola(struct usb_device *udev)
 	       le16_to_cpu(udev->descriptor.idProduct) == PS5_VIOLA_BT_PID;
 }
 
+/* PS5 MT7921 (0e8d:3603): the ISO setup times out, and the reset after it breaks Bluetooth after a kexec (#71) */
+static bool btusb_is_ps5_mt7921(struct usb_device *udev)
+{
+	return le16_to_cpu(udev->descriptor.idVendor) == 0x0e8d &&
+	       le16_to_cpu(udev->descriptor.idProduct) == 0x3603;
+}
+
 static int btusb_ps5_viola_wait_ready(struct hci_dev *hdev)
 {
 	struct sk_buff *skb;
@@ -3132,7 +3139,8 @@ static int btusb_mtk_setup(struct hci_dev *hdev)
 		data->cmdreq_type = USB_TYPE_CLASS;
 
 	/* Claim ISO data interface and endpoint */
-	if (!viola && !test_bit(BTMTK_ISOPKT_OVER_INTR, &btmtk_data->flags)) {
+	if (!viola && !btusb_is_ps5_mt7921(data->udev) &&
+	    !test_bit(BTMTK_ISOPKT_OVER_INTR, &btmtk_data->flags)) {
 		btmtk_data->isopkt_intf = usb_ifnum_to_if(data->udev, MTK_ISO_IFNUM);
 		btusb_mtk_claim_iso_intf(data);
 	}
