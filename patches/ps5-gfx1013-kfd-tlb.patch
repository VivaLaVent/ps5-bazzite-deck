GFX1013: flush the TLB for KFD (compute)

The MMIO PASID flush path for GFX1013 from ps5-linux-patches #57 (Tertium), which rmux's shitshow dropped,
with #77 (Sergey): the PS5 never programs ATC_VMID*_PASID_MAPPING, so no VMID matched and nothing was
flushed; KFD (ROCm/HIP, OpenCL through amdkfd) then ran on stale translations: page faults on fresh
allocations and lost writes. Every KFD VMID is flushed when none maps the PASID. Vulkan and games don't use KFD.
---
diff --git a/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c b/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
index c70657bc089b..316abfd84953 100644
--- a/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
@@ -232,12 +232,14 @@ static bool gmc_v10_0_get_atc_vmid_pasid_mapping_info(
  *
  * Flush the TLB for the requested page table.
  */
-static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
-					uint32_t vmhub, uint32_t flush_type)
+static void gmc_v10_0_flush_gpu_tlb_internal(struct amdgpu_device *adev,
+					     uint32_t vmid, uint32_t vmhub,
+					     uint32_t flush_type,
+					     bool gfx1013_pasid_path)
 {
-	bool use_semaphore = gmc_v10_0_use_invalidate_semaphore(adev, vmhub);
+	bool use_semaphore;
 	struct amdgpu_vmhub *hub = &adev->vmhub[vmhub];
-	u32 inv_req = hub->vmhub_funcs->get_invalidate_req(vmid, flush_type);
+	u32 inv_req;
 	/* Use register 17 for GART */
 	const unsigned int eng = 17;
 	unsigned char hub_ip = 0;
@@ -245,6 +247,14 @@ static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
 	unsigned int i;
 	u32 tmp;
 
+	if (gfx1013_pasid_path && vmhub == AMDGPU_GFXHUB(0) &&
+	    flush_type == 2)
+		flush_type = 0;
+
+	use_semaphore = gmc_v10_0_use_invalidate_semaphore(adev, vmhub) ||
+		(gfx1013_pasid_path && vmhub == AMDGPU_GFXHUB(0));
+	inv_req = hub->vmhub_funcs->get_invalidate_req(vmid, flush_type);
+
 	sem = hub->vm_inv_eng0_sem + hub->eng_distance * eng;
 	req = hub->vm_inv_eng0_req + hub->eng_distance * eng;
 	ack = hub->vm_inv_eng0_ack + hub->eng_distance * eng;
@@ -255,7 +265,8 @@ static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
 	/* This is necessary for SRIOV as well as for GFXOFF to function
 	 * properly under bare metal
 	 */
-	if (adev->gfx.kiq[0].ring.sched.ready && !adev->enable_mes &&
+	if (!gfx1013_pasid_path &&
+	    adev->gfx.kiq[0].ring.sched.ready && !adev->enable_mes &&
 	    (amdgpu_sriov_runtime(adev) || !amdgpu_sriov_vf(adev))) {
 		amdgpu_gmc_fw_reg_write_reg_wait(adev, req, ack, inv_req,
 						 1 << vmid, GET_INST(GC, 0));
@@ -318,6 +329,13 @@ static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
 			vmhub);
 }
 
+static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
+					uint32_t vmhub, uint32_t flush_type)
+{
+	gmc_v10_0_flush_gpu_tlb_internal(adev, vmid, vmhub, flush_type,
+					   false);
+}
+
 /**
  * gmc_v10_0_flush_gpu_tlb_pasid - tlb flush via pasid
  *
@@ -334,7 +352,11 @@ static void gmc_v10_0_flush_gpu_tlb_pasid(struct amdgpu_device *adev,
 					  bool all_hub, uint32_t inst)
 {
 	uint16_t queried;
-	int vmid, i;
+	int vmid, i, matched = 0;
+	bool gfx1013_pasid_path =
+		(adev->pdev->device == 0x13FE || adev->pdev->device == 0x13DB ||
+		 adev->pdev->device == 0x13FB) &&
+		amdgpu_ip_version(adev, GC_HWIP, 0) == IP_VERSION(10, 1, 3);
 
 	for (vmid = 1; vmid < AMDGPU_NUM_VMID; vmid++) {
 		bool valid;
@@ -343,17 +365,45 @@ static void gmc_v10_0_flush_gpu_tlb_pasid(struct amdgpu_device *adev,
 								  &queried);
 		if (!valid || queried != pasid)
 			continue;
+		matched++;
 
 		if (all_hub) {
 			for_each_set_bit(i, adev->vmhubs_mask,
 					 AMDGPU_MAX_VMHUBS)
-				gmc_v10_0_flush_gpu_tlb(adev, vmid, i,
-							flush_type);
+				if (gfx1013_pasid_path)
+					gmc_v10_0_flush_gpu_tlb_internal(
+						adev, vmid, i, flush_type, true);
+				else
+					gmc_v10_0_flush_gpu_tlb(
+						adev, vmid, i, flush_type);
 		} else {
-			gmc_v10_0_flush_gpu_tlb(adev, vmid, AMDGPU_GFXHUB(0),
-						flush_type);
+			if (gfx1013_pasid_path)
+				gmc_v10_0_flush_gpu_tlb_internal(
+					adev, vmid, AMDGPU_GFXHUB(0),
+					flush_type, true);
+			else
+				gmc_v10_0_flush_gpu_tlb(
+					adev, vmid, AMDGPU_GFXHUB(0),
+					flush_type);
 		}
 	}
+
+	/*
+	 * The PS5 never programs ATC_VMID*_PASID_MAPPING (all zero under HWS),
+	 * so the lookup above finds no VMID and nothing gets invalidated: KFD
+	 * then runs on stale translations (page faults, lost writes). Flush
+	 * every KFD VMID instead; that is only a few register writes.
+	 */
+	if (!matched && gfx1013_pasid_path) {
+		dev_info_once(adev->dev,
+			      "GFX1013: no VMID for PASID %u, flushing all KFD VMIDs\n",
+			      pasid);
+		for (vmid = adev->vm_manager.first_kfd_vmid;
+		     vmid < AMDGPU_NUM_VMID; vmid++)
+			for_each_set_bit(i, adev->vmhubs_mask, AMDGPU_MAX_VMHUBS)
+				gmc_v10_0_flush_gpu_tlb_internal(adev, vmid, i,
+								 flush_type, true);
+	}
 }
 
 static uint64_t gmc_v10_0_emit_flush_gpu_tlb(struct amdgpu_ring *ring,
@@ -960,7 +1010,21 @@ static int gmc_v10_0_hw_init(struct amdgpu_ip_block *ip_block)
 	struct amdgpu_device *adev = ip_block->adev;
 	int r;
 
-	adev->gmc.flush_pasid_uses_kiq = !amdgpu_emu_mode;
+	/*
+	 * GFX1013/BC-250/PS5: KIQ-routed PASID TLB invalidation can corrupt
+	 * sustained KFD workloads.  Keep the existing behavior for every
+	 * other GMC v10 device and route only GFX1013 through MMIO.
+	 */
+	adev->gmc.flush_pasid_uses_kiq = !amdgpu_emu_mode &&
+		amdgpu_ip_version(adev, GC_HWIP, 0) != IP_VERSION(10, 1, 3);
+	if (!adev->gmc.flush_pasid_uses_kiq &&
+	    amdgpu_ip_version(adev, GC_HWIP, 0) == IP_VERSION(10, 1, 3))
+		dev_info(adev->dev,
+			 "GFX1013/BC-250/PS5: using MMIO PASID TLB flushes\n");
+
+	if (amdgpu_ip_version(adev, GC_HWIP, 0) == IP_VERSION(10, 1, 3))
+		dev_info(adev->dev,
+			 "GFX1013/BC-250/PS5: PASID-only CPU type-0 invalidation\n");
 
 	/* The sequence of these two function calls matters.*/
 	gmc_v10_0_init_golden_registers(adev);
