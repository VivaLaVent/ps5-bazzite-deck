PS5 HDMI: full RGB range in the AVI InfoFrame (hdmi.rgb_range)

The GPU sends full-range RGB on its DP link to the FLAVA3 bridge, but the
AVI InfoFrame's quantization range (PB3 Q1:Q0, register 0x7226 bits 3:2;
PB3 = 0x7226 holds ITC and EC as the existing code shows) stayed "default".
TVs read "default" as limited range for TV timings (1080p, 4K60: CTA-861
VICs) and as full for PC timings (1440p): crushed blacks / oversaturated
colours at 1080p only. Now "full" is sent explicitly for RGB output (not for
the HDR YCbCr 4:2:2 path); TVs without selectable quantization ignore it.
hdmi.rgb_range=0 restores the old behaviour, 2 says limited.
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -833,6 +833,20 @@
 
 static bool hdmi_mode_is_hi_rate(const struct drm_display_mode *mode);
 
+/*
+ * RGB quantization range in the AVI InfoFrame (PB3 = 0x7226: ITC, EC, Q, SC).
+ * The GPU sends full-range RGB on its DP link to the bridge, but the AVI
+ * InfoFrame said "default", which TVs read as LIMITED for TV timings like
+ * 1080p (CTA-861) and as full for PC timings like 1440p: crushed blacks and
+ * oversaturated colours at 1080p only. Say "full" explicitly;
+ * TVs without selectable quantization (VCDB QS=0) ignore it.
+ * hdmi.rgb_range: 1 full (default), 2 limited, 0 leave it at "default".
+ */
+static unsigned int rgb_range = 1;
+module_param(rgb_range, uint, 0644);
+MODULE_PARM_DESC(rgb_range, "AVI RGB quantization range: 1 full (default), 2 limited, 0 default (TV decides)");
+static bool avi_rgb;
+
 static void setHdmiBasicVideoConfigFlava3(const struct drm_display_mode *mode,
 					  unsigned int bpc, bool yuv422)
 {
@@ -868,6 +882,7 @@
 	i2c_write(0x70c0, 0xdc);
 	i2c_write(0x621b, 0x00);
 	i2c_write(0x629a, 0x00);
+	avi_rgb = !yuv422;
 	/* Set color format */
 	if (yuv422) {
 		i2c_write_data(0x70c4, (u8[]){0x04, 0x04}, 2);
@@ -902,6 +917,7 @@
 }
 
 
+
 static void setVideoAdditionalConfigFlava3(const struct drm_display_mode *mode)
 {
 	u8 vic = drm_match_cea_mode(mode);
@@ -914,6 +930,8 @@
 	}
 	/* Enable IT content */
 	i2c_mask(0x7226, 1 << 7, 0x80);
+	/* RGB quantization range (Q1:Q0), only meaningful for RGB output */
+	i2c_mask(0x7226, avi_rgb && rgb_range <= 2 ? rgb_range << 2 : 0x00, 0x0c);
 	/* Set content type (game) */
 	i2c_mask(0x7228, 3 << 4, 0x30);
 	i2c_write(0x7204, 0x40);
