PS5 HDMI: no hang on the blinking cursor when switching sessions

Game Mode <-> desktop: between the two compositors the console owns the
display; its modeset makes the TV re-announce, and two things then fought
the next session:
 - the console re-arm blanked/unblanked fbcon under console_lock (each a full
   bridge setup, seconds), blocking the next session's VT switch, and its
   unblank made the TV re-announce again. It now only runs when no mode was
   set up for rearm_quiet_ms (5 s): a console that just got the display is
   still settling.
 - every same-display re-announce also fired a hotplug, so the starting
   compositor reprobed and modeset, which made the TV re-announce again. The
   hotplug now fires for a new or different display only (what the #43
   comment intended); the same display is the re-arm's job.
Also: EDID announcements that are ignored still reach CEC like every other
message.
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -1270,8 +1270,12 @@
 }
 EXPORT_SYMBOL(sceHdmiInitVideoConfig);
 
+/* when the bridge was last set up for a mode (any path); see rearm_quiet_ms */
+static ktime_t last_video_setup;
+
 void sceHdmiSetVideoConfig(const struct drm_display_mode *mode, unsigned int bpc, bool yuv422)
 {
+	WRITE_ONCE(last_video_setup, ktime_get());
 	pr_debug("setup: %s@%d %d kHz vic %d, %u bpc %s\n", mode->name,
 		 drm_mode_vrefresh(mode), mode->clock, drm_match_cea_mode(mode),
 		 bpc, yuv422 ? "YCbCr 4:2:2" : "RGB");
@@ -1681,6 +1685,17 @@
 static unsigned int rearm_settle_ms = 300;
 module_param(rearm_settle_ms, uint, 0644);
 MODULE_PARM_DESC(rearm_settle_ms, "Quiet time after the last EDID announce before re-arming");
+/*
+ * Session switches (Game Mode <-> desktop): between the two compositors the
+ * console owns the display, its modeset makes the TV re-announce, and a
+ * console re-arm then blanks/unblanks fbcon under console_lock for seconds,
+ * which blocks the next session's VT switch (stuck on the blinking cursor),
+ * and re-announces again. Only re-arm the console when no mode was set up
+ * for rearm_quiet_ms; a console that just got the display is still settling.
+ */
+static unsigned int rearm_quiet_ms = 5000;
+module_param(rearm_quiet_ms, uint, 0644);
+MODULE_PARM_DESC(rearm_quiet_ms, "Console re-arm only if the last video setup is this long ago (session switches)");
 static unsigned int rearm_max = 4;
 module_param(rearm_max, uint, 0644);
 MODULE_PARM_DESC(rearm_max, "Max automatic re-arms per rearm_window_s (0 = unlimited)");
@@ -1747,6 +1762,10 @@
 	int ret;
 
 	info = rearm_fbcon_screen(dev);
+	if (info && ktime_ms_delta(ktime_get(), READ_ONCE(last_video_setup)) < rearm_quiet_ms) {
+		pr_info("re-arm: console just got the display (session switch?), skipped\n");
+		return 0;
+	}
 	if (info) {
 		pr_info("re-arm: blanking fb%d (no DRM master)\n", info->node);
 		console_lock();
@@ -1861,7 +1880,7 @@
 void hdmi_notification_handler(struct icc_msg *msg)
 {
 	u32 crc;
-	bool other;
+	bool other, first;
 
 	/* PR #57: validate the ICC message before touching its payload */
 	if (msg->length < sizeof(*msg) + 4 || msg->length > ICC_MSG_MAX_SIZE)
@@ -1876,7 +1895,7 @@
 			if (length < EDID_LENGTH || length > msg->length - sizeof(*msg) - 4) {
 				pr_info_ratelimited("ignored an EDID announcement of %u bytes, keeping the previous EDID\n",
 						    length);
-				return;
+				goto notify_cec;
 			}
 			fix_edid(&msg->data[4]);
 			edid = drm_edid_alloc(&msg->data[4], length);
@@ -1890,7 +1909,7 @@
 			if (!edid || !drm_edid_valid(edid)) {
 				drm_edid_free(edid);
 				pr_info_ratelimited("ignored an invalid EDID announcement, keeping the previous EDID\n");
-				return;
+				goto notify_cec;
 			}
 			/* PR #57: the EDID is stored under a lock and bound to one connector */
 			scoped_guard(mutex, &hdmi_edid_lock) {
@@ -1902,22 +1921,31 @@
 			pr_info("got real edid\n");
 			sceHdmiOutputMode();
 
-			/* #43: a different sink -> amdgpu redetects via its HPD path */
-			mutex_lock(&hotplug_lock);
-			if (hotplug_handler)
-				hotplug_handler(hotplug_data);
-			mutex_unlock(&hotplug_lock);
-
 			/*
 			 * #46: the same sink re-announcing wipes the bridge output -> re-arm.
-			 * A different sink (other EDID) is set up by the hotplug path above
+			 * A different sink (other EDID) is set up by the hotplug path below
 			 * and the compositor's own modeset; re-arming it would re-apply the
 			 * previous sink's mode.
 			 */
 			crc = crc32_le(~0, &msg->data[4], length);
 			other = have_edid_crc && crc != last_edid_crc;
+			first = !have_edid_crc;
 			last_edid_crc = crc;
 			have_edid_crc = true;
+
+			/*
+			 * #43: a different sink (or the first one) -> amdgpu redetects via
+			 * its HPD path. The same sink re-announcing (after any modeset, a
+			 * TV input switch, a session switch) is the re-arm's job below: a
+			 * hotplug event there makes the compositor reprobe and modeset,
+			 * which makes the TV re-announce again (a storm at session start).
+			 */
+			if (first || other) {
+				mutex_lock(&hotplug_lock);
+				if (hotplug_handler)
+					hotplug_handler(hotplug_data);
+				mutex_unlock(&hotplug_lock);
+			}
 			if (other) {
 				if (cancel_delayed_work(&rearm_work) || rearm)
 					pr_info("different display, re-arm skipped\n");
@@ -1933,6 +1961,8 @@
 				pr_info("picture up (0x%02x), re-arm cancelled\n", msg->data[1]);
 		}
 
+notify_cec:
+	/* every message, EDID or not, also goes to CEC (as before #57) */
 	mutex_lock(&cec_lock);
 	if (cec_handler)
 		cec_handler(cec_data, msg);
