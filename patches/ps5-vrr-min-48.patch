PS5 VRR: never below 48 Hz, FreeSync SPD with the actual range

The VRR range came from the TV (HDMI Forum VRRmin/VRRmax, else the FreeSync block),
often 40 Hz at the low end, where OLED TVs flicker visibly when the refresh rate swings
(hsgodd). The low end is now at least 48 Hz, the PS5 system's own VRR floor (Lawson's
notes): below it, frames are doubled at 120 Hz modes, and 60 Hz modes keep a fixed 60 Hz.
A TV with a higher minimum keeps its own. The FreeSync SPD sent in follow mode had a
fixed 40 Hz minimum; it now sends the range actually used.
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -1164,12 +1164,20 @@
 MODULE_PARM_DESC(vrr_measure, "Log the measured frame intervals every 2 s while VRR is on, for debugging (default off)");
 
 #define VRR_FOLLOW_STEP_MS	250	/* between the follow steps (tested up to 1000) */
+/*
+ * VRR never goes below 48 Hz, the PS5 system's own floor: below
+ * that, frames are doubled at 120 Hz modes, and 60 Hz modes keep a fixed 60 Hz. TVs' own
+ * minimum is often 40 Hz, where OLEDs flicker visibly. A TV whose minimum is
+ * higher keeps it.
+ */
+#define VRR_MIN_HZ		48
 #define VRR_FOLLOW_SETTLE_MS	500	/* after the last step, before the picture comes back */
 
 static bool vrr_requested;		/* VRR switched on, as last set up */
 static bool vrr_follow;			/* ... and the chip goes to follow mode */
 static bool vrr_follow_pending;		/* the setup's unmute waits for the follow block */
 static unsigned int vrr_follow_hz = 60;
+static unsigned int vrr_min_hz = VRR_MIN_HZ;	/* the range's low end, also sent in the FreeSync SPD */
 static atomic_t vrr_follow_gen = ATOMIC_INIT(0);	/* bumped by every setup and VRR switch */
 
 static u8 vrr_edid[512];
@@ -1260,6 +1268,10 @@
 	} else {
 		return -ENODATA;
 	}
+	*min_hz = max(*min_hz, VRR_MIN_HZ);
+	if (*max_hz <= *min_hz + 10)
+		return -ENODATA;
+	WRITE_ONCE(vrr_min_hz, *min_hz);
 	return 0;
 }
 EXPORT_SYMBOL(ps5_hdmi_vrr_range);
@@ -1337,7 +1349,7 @@
 	if (!READ_ONCE(vrr_follow))
 		goto out;
 	/* FreeSync SPD (AMD OUI; supported, enabled, active; min, max) in the SPD slot */
-	spd[10] = 40;
+	spd[10] = READ_ONCE(vrr_min_hz);
 	spd[11] = vrr_follow_hz;
 	for (i = 0; i < 12; i++)
 		sum += spd[i];
