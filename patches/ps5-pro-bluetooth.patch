PS5 Pro internal Bluetooth: route Viola HCI and wait for first-probe readiness

The PS5 Pro's MediaTek 0e8d:3605 Bluetooth function is on USB interface 3.
It needs a function-on WMT request for that interface, HCI control requests
routed to wIndex 3, and ACL traffic on bulk OUT 0x0d.  Only interface 3 is
bound; the separate MediaTek ISO interface is not claimed.  Runtime USB
autosuspend remains disabled because suspending this device can kill the
Salina xHCI controller.

The previous patch was sufficient after reloading btusb, but cold boot could
leave a ghost hci0 because the first HCI Reset raced the controller becoming
ready:

  Bluetooth: hci0: Opcode 0x0c03 failed: -16

Add one bounded readiness check after the initial IF3 activation.  It retries
HCI Reset only for EBUSY/Command Disallowed, at most three attempts with
20-25 ms spacing, and runs once per USB probe.  Repeated BlueZ power cycles
still perform the MediaTek setup, but reset the WMT route to wIndex 0 first
and do not repeat the initial readiness check.

This replaces the diagnostic endpoint-resync experiment with the minimal
path that passed hardware testing.  The change is strictly gated to
0e8d:3605; PS5 Slim 0e8d:3603 and IW620 behavior is unchanged.

Tested on a PS5 Pro running system firmware 11.60, Viola GPU firmware, and
60 active CUs.  Four cold boots initialized on the first probe without a
btusb reload; diagnostic readiness completed on attempt 2 in 33-34 ms:

  PS5 Pro: HCI Reset ready after 2 attempt(s), 33 ms

Three Bluetooth power cycles, discovery, DualSense pairing and bonded
reconnect, gamepad/motion/touchpad/analog input, USB stability, and GPU
telemetry all passed.  The following failure signatures were absent:
Opcode 0x0c03/0x0c1a failures, WMT or USB descriptor -110, "HC died", and
xHCI host-controller failure.
---
diff --git a/drivers/bluetooth/btusb.c b/drivers/bluetooth/btusb.c
index 0491971..7e3defe 100644
--- a/drivers/bluetooth/btusb.c
+++ b/drivers/bluetooth/btusb.c
@@ -7,6 +7,7 @@
  */
 
 #include <linux/cpufeature.h>
+#include <linux/delay.h>
 #include <linux/dmi.h>
 #include <linux/module.h>
 #include <linux/usb.h>
@@ -40,6 +41,51 @@ static bool reset = true;
 
 static struct usb_driver btusb_driver;
 
+/*
+ * PS5 Pro (Viola) MediaTek Bluetooth 0e8d:3605. The HCI controller is
+ * function 2 on interface 3; ACL data must use bulk OUT 0x0d, because
+ * 0x0b accepts one transfer and then NAKs forever. The base PS5 uses
+ * 0e8d:3603 and is not affected by any of the code below.
+ */
+#define PS5_VIOLA_BT_VID	0x0e8d
+#define PS5_VIOLA_BT_PID	0x3605
+#define PS5_VIOLA_BT_IFNUM	3
+#define PS5_VIOLA_BT_ACL_OUT_EP	0x0d
+#define PS5_VIOLA_RESET_RETRIES	3
+#define PS5_VIOLA_RESET_RETRY_MIN_US	20000
+#define PS5_VIOLA_RESET_RETRY_MAX_US	25000
+#define PS5_VIOLA_RESET_TIMEOUT_MS	500
+
+static bool btusb_is_ps5_viola(struct usb_device *udev)
+{
+	return le16_to_cpu(udev->descriptor.idVendor) == PS5_VIOLA_BT_VID &&
+	       le16_to_cpu(udev->descriptor.idProduct) == PS5_VIOLA_BT_PID;
+}
+
+static int btusb_ps5_viola_wait_ready(struct hci_dev *hdev)
+{
+	struct sk_buff *skb;
+	int attempt;
+	int err;
+
+	for (attempt = 1; attempt <= PS5_VIOLA_RESET_RETRIES; attempt++) {
+		skb = __hci_cmd_sync(hdev, HCI_OP_RESET, 0, NULL,
+				     msecs_to_jiffies(PS5_VIOLA_RESET_TIMEOUT_MS));
+		if (!IS_ERR(skb)) {
+			kfree_skb(skb);
+			return 0;
+		}
+		err = PTR_ERR(skb);
+		if (err != -EBUSY && err != HCI_ERROR_COMMAND_DISALLOWED)
+			return err;
+
+		if (attempt < PS5_VIOLA_RESET_RETRIES)
+			usleep_range(PS5_VIOLA_RESET_RETRY_MIN_US,
+				     PS5_VIOLA_RESET_RETRY_MAX_US);
+	}
+	return -EBUSY;
+}
+
 #define BTUSB_IGNORE			BIT(0)
 #define BTUSB_DIGIANSWER		BIT(1)
 #define BTUSB_CSR			BIT(2)
@@ -86,6 +132,14 @@ static const struct usb_device_id btusb_table[] = {
 	{ USB_DEVICE_AND_INTERFACE_INFO(0x0471, 0x0215, 0xff, 0xff, 0xff),
 	  .driver_info = BTUSB_IGNORE },
 
+	/*
+	 * PS5 Pro (Viola) MediaTek Bluetooth, HCI on interface 3.
+	 * Runtime autosuspend of this device kills the Salina xHCI
+	 * ("HC died"), so never enable it.
+	 */
+	{ USB_DEVICE(PS5_VIOLA_BT_VID, PS5_VIOLA_BT_PID),
+	  .driver_info = BTUSB_MEDIATEK | BTUSB_NO_AUTOSUSPEND },
+
 	/* Generic Bluetooth USB device */
 	{ USB_DEVICE_INFO(0xe0, 0x01, 0x01) },
 
@@ -1031,6 +1085,7 @@ struct btusb_data {
 	unsigned long flags;
 
 	bool poll_sync;
+	bool ps5_viola_initial_reset_done;
 	int intr_interval;
 	struct work_struct  work;
 	struct work_struct  waker;
@@ -2209,6 +2264,9 @@ static struct urb *alloc_ctrl_urb(struct hci_dev *hdev, struct sk_buff *skb)
 	if (data->match_id->driver_info & BTUSB_HCI_IFACE_RECIPIENT)
 		dr->wIndex = __cpu_to_le16(
 			data->intf->cur_altsetting->desc.bInterfaceNumber);
+	else if (btusb_is_ps5_viola(data->udev) &&
+		 data->cmdreq_type == (USB_TYPE_CLASS | USB_RECIP_INTERFACE))
+		dr->wIndex = __cpu_to_le16(PS5_VIOLA_BT_IFNUM);
 	else
 		dr->wIndex = 0;
 
@@ -3048,6 +3106,7 @@ static int btusb_mtk_setup(struct hci_dev *hdev)
 {
 	struct btusb_data *data = hci_get_drvdata(hdev);
 	struct btmtk_data *btmtk_data = hci_get_priv(hdev);
+	bool viola = btusb_is_ps5_viola(data->udev);
 	int err;
 
 	/* MediaTek WMT vendor cmd requiring below USB resources to
@@ -3059,8 +3118,17 @@ static int btusb_mtk_setup(struct hci_dev *hdev)
 	btmtk_data->ctrl_anchor = &data->ctrl_anchor;
 	btmtk_data->reset_sync = btusb_mtk_reset;
 
+	/*
+	 * PS5 Pro (Viola): setup runs again on every power on
+	 * (HCI_QUIRK_NON_PERSISTENT_SETUP). The firmware/WMT handshake below
+	 * must go to wIndex 0 as on the first setup, so undo the IF3 routing
+	 * a previous setup left behind; it is switched on again at the end.
+	 */
+	if (viola)
+		data->cmdreq_type = USB_TYPE_CLASS;
+
 	/* Claim ISO data interface and endpoint */
-	if (!test_bit(BTMTK_ISOPKT_OVER_INTR, &btmtk_data->flags)) {
+	if (!viola && !test_bit(BTMTK_ISOPKT_OVER_INTR, &btmtk_data->flags)) {
 		btmtk_data->isopkt_intf = usb_ifnum_to_if(data->udev, MTK_ISO_IFNUM);
 		btusb_mtk_claim_iso_intf(data);
 	}
@@ -3069,6 +3137,44 @@ static int btusb_mtk_setup(struct hci_dev *hdev)
 	if (err)
 		return err;
 
+	if (viola) {
+		/* WMT function-on for the HCI function on interface 3 */
+		static const u8 wmt_on_if3[] = {
+			0x6f, 0xfc, 0x06, 0x01, 0x06, 0x02, 0x00, 0x00, 0x01
+		};
+		u8 *buf;
+		int ret;
+
+		buf = kmemdup(wmt_on_if3, sizeof(wmt_on_if3), GFP_KERNEL);
+		if (!buf)
+			return -ENOMEM;
+
+		ret = usb_control_msg(data->udev, usb_sndctrlpipe(data->udev, 0),
+				      0, USB_TYPE_CLASS | USB_RECIP_INTERFACE,
+				      0, PS5_VIOLA_BT_IFNUM,
+				      buf, sizeof(wmt_on_if3),
+				      USB_CTRL_SET_TIMEOUT);
+		kfree(buf);
+
+		if (ret != sizeof(wmt_on_if3)) {
+			err = ret < 0 ? ret : -EIO;
+			bt_dev_err(hdev, "PS5 Pro: IF3 WMT activation failed (%d)",
+				   err);
+			return err;
+		}
+
+		/* From here on, route all HCI commands to interface 3 */
+		data->cmdreq_type = USB_TYPE_CLASS | USB_RECIP_INTERFACE;
+		bt_dev_info(hdev, "PS5 Pro: IF3 activated, HCI routed to IF3");
+		if (!data->ps5_viola_initial_reset_done) {
+			err = btusb_ps5_viola_wait_ready(hdev);
+			if (err)
+				return err;
+
+			data->ps5_viola_initial_reset_done = true;
+		}
+	}
+
 	switch (btmtk_data->dev_id) {
 	case 0x7922:
 	case 0x7925:
@@ -3103,8 +3209,16 @@ static int btusb_mtk_setup(struct hci_dev *hdev)
 
 static int btusb_mtk_shutdown(struct hci_dev *hdev)
 {
+	struct btusb_data *data = hci_get_drvdata(hdev);
 	int ret;
 
+	/*
+	 * PS5 Pro (Viola): the WMT function-off below belongs to wIndex 0
+	 * like the WMT handshake in setup; setup re-enables IF3 routing.
+	 */
+	if (btusb_is_ps5_viola(data->udev))
+		data->cmdreq_type = USB_TYPE_CLASS;
+
 	ret = btmtk_usb_shutdown(hdev);
 
 	/* Release MediaTek iso interface after shutdown */
@@ -4219,6 +4333,11 @@ static int btusb_probe(struct usb_interface *intf,
 
 	BT_DBG("intf %p id %p", intf, id);
 
+	/* PS5 Pro (Viola): only interface 3 carries the HCI controller */
+	if (btusb_is_ps5_viola(interface_to_usbdev(intf)) &&
+	    intf->cur_altsetting->desc.bInterfaceNumber != PS5_VIOLA_BT_IFNUM)
+		return -ENODEV;
+
 	if ((id->driver_info & BTUSB_IFNUM_2) &&
 	    (intf->cur_altsetting->desc.bInterfaceNumber != 0) &&
 	    (intf->cur_altsetting->desc.bInterfaceNumber != 2))
@@ -4267,6 +4386,32 @@ static int btusb_probe(struct usb_interface *intf,
 	if (err)
 		goto err_free_data;
 
+	/* PS5 Pro (Viola): ACL data must use the second bulk OUT endpoint */
+	if (btusb_is_ps5_viola(interface_to_usbdev(intf))) {
+		struct usb_host_interface *alt = intf->cur_altsetting;
+		int i;
+
+		for (i = 0; i < alt->desc.bNumEndpoints; i++) {
+			struct usb_endpoint_descriptor *ep = &alt->endpoint[i].desc;
+
+			if (ep->bEndpointAddress == PS5_VIOLA_BT_ACL_OUT_EP &&
+			    usb_endpoint_is_bulk_out(ep)) {
+				data->bulk_tx_ep = ep;
+				break;
+			}
+		}
+
+		if (i == alt->desc.bNumEndpoints) {
+			dev_err(&intf->dev, "PS5 Pro: ACL bulk OUT 0x%02x missing\n",
+				PS5_VIOLA_BT_ACL_OUT_EP);
+			err = -ENODEV;
+			goto err_free_data;
+		}
+
+		dev_info(&intf->dev, "PS5 Pro: ACL bulk OUT 0x%02x selected\n",
+			 PS5_VIOLA_BT_ACL_OUT_EP);
+	}
+
 	/* PS5 MediaTek (0e8d:3603): the chip only drains ACL data from the
 	 * second bulk OUT endpoint (0x02), the one paired with bulk IN 0x82.
 	 * (WizGery/ps5-mediatek-fixes 0003, ported to the 7.3 probe code.)
