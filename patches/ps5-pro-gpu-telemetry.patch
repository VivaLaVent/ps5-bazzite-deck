PS5 Pro: GPU load and metrics with the Viola firmware

After mfoster978's PR #29, rebased on the #66 port (which already reports the Pro's GPU load
through amdgpu's SMU sensor):
 - with the Viola firmware the overlay doesn't create its own gpu_busy_percent: amdgpu's works
   there, the second file failed with -EEXIST, and removing it at teardown removed amdgpu's
 - gpu_metrics is unsupported with the Viola firmware: there's no SMU metrics table, every read
   failed, and MangoHud then overwrote the load and temperature it had read with zeros
Base PS5, Slim and a Pro on the Cyan Skillfish firmware are unchanged.
---

--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -912,7 +912,12 @@
 #ifdef CONFIG_X86_PS5
 	/* lets the HDMI bridge driver re-arm the output when the sink re-announces */
 	ps5_hdmi_register_drm(adev_to_drm(adev));
-	if (device_create_file(adev->dev, &ps5_dev_attr_gpu_busy))
+	/*
+	 * With the Viola firmware amdgpu's own gpu_busy_percent works (its SMU load
+	 * sensor), and a second file of that name failed with -EEXIST; removing it
+	 * at teardown then removed amdgpu's.
+	 */
+	if (!amdgpu_ps5_viola_fw(adev) && device_create_file(adev->dev, &ps5_dev_attr_gpu_busy))
 		drm_info(adev_to_drm(adev), "PS5: gpu_busy_percent not created (already there?)\n");
 	{
 		int t;
@@ -978,7 +983,8 @@
 
 #ifdef CONFIG_X86_PS5
 	ps5_hdmi_unregister_drm(adev_to_drm(adev));
-	device_remove_file(adev->dev, &ps5_dev_attr_gpu_busy);
+	if (!amdgpu_ps5_viola_fw(adev))
+		device_remove_file(adev->dev, &ps5_dev_attr_gpu_busy);
 	if (ps5_hwmon) {
 		hwmon_device_unregister(ps5_hwmon);
 		ps5_hwmon = NULL;
--- a/drivers/gpu/drm/amd/pm/amdgpu_pm.c
+++ b/drivers/gpu/drm/amd/pm/amdgpu_pm.c
@@ -2702,7 +2702,8 @@
 			dev_attr->store = NULL;
 		}
 	} else if (DEVICE_ATTR_IS(gpu_metrics)) {
-		if (gc_ver < IP_VERSION(9, 1, 0))
+		/* Viola: no SMU metrics table, every read fails; MangoHud then shows zeros */
+		if (amdgpu_ps5_viola_fw(adev) || gc_ver < IP_VERSION(9, 1, 0))
 			*states = ATTR_STATE_UNSUPPORTED;
 	} else if (DEVICE_ATTR_IS(pp_power_profile_mode)) {
 		if (amdgpu_dpm_get_power_profile_mode(adev, NULL) == -EOPNOTSUPP)
