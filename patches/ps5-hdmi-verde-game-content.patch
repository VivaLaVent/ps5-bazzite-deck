PS5 HDMI (Verde): IT content and content type "game" in the AVI InfoFrame

FLAVA3 sets ITC and CN = game (0x7226 bit 7, 0x7228 bits 5:4), so TVs pick
their game / low-latency picture mode. Verde builds its AVI InfoFrame as one
block at 0x3058 (version 2, length 13, checksum, PB1..PB5); stock sends PB3
0x08 (full RGB range, which also confirms the FLAVA3 range fix) and PB5 0x40.
Set ITC (PB3 0x88) and CN = game (PB5 0x70), checksums adjusted by -0xb0
(verified: header + payload sum to 0 for all three modes).
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -1170,6 +1170,13 @@
 	i2c_exec();
 }
 
+/*
+ * Verde AVI InfoFrame at 0x3058: version 2, length 13, checksum, PB1 (RGB),
+ * PB2 0x28 (16:9), PB3, VIC, PB5. Stock sends PB3 0x08 (full RGB range) and
+ * PB5 0x40; like FLAVA3 (ITC + content type "game" in 0x7226/0x7228) we set
+ * ITC (PB3 bit 7) and CN = game (PB5 bits 5:4), checksums adjusted by -0xb0,
+ * so TVs pick their game/low-latency picture mode on Verde consoles too.
+ */
 static void setHdmiBasicVideoConfigVerde(const struct drm_display_mode *mode)
 {
 	u8 vic = drm_match_cea_mode(mode);
@@ -1177,11 +1184,11 @@
 	i2c_init(0);
 	i2c_begin_block();
 	if (vic == 16) {
-		i2c_write_data(0x3058, (u8[]){0x02, 0x0d, 0xef, 0x00, 0x28, 0x08, 0x10, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 18);
+		i2c_write_data(0x3058, (u8[]){0x02, 0x0d, 0x3f, 0x00, 0x28, 0x88, 0x10, 0x70, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 18);
 	} else if (mode->hdisplay == 2560 && mode->vdisplay == 1440) {
-		i2c_write_data(0x3058, (u8[]){0x02, 0x0d, 0xff, 0x00, 0x28, 0x08, 0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 18);
+		i2c_write_data(0x3058, (u8[]){0x02, 0x0d, 0x4f, 0x00, 0x28, 0x88, 0x00, 0x70, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 18);
 	} else if (vic == 97) {
-		i2c_write_data(0x3058, (u8[]){0x02, 0x0d, 0x9e, 0x00, 0x28, 0x08, 0x61, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 18);
+		i2c_write_data(0x3058, (u8[]){0x02, 0x0d, 0xee, 0x00, 0x28, 0x88, 0x61, 0x70, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 18);
 	}
 	i2c_write_data(0x31d0, (u8[]){0x01, 0x19, 0x5f, 0x53, 0x43, 0x45, 0x49, 0x00, 0x00, 0x00, 0x00, 0x50, 0x53, 0x35, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x08}, 28);
 	i2c_end_block();
