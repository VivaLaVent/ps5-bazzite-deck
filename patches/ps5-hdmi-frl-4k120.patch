+		i2c_write(0x7074, 0x00);
+		i2c_write(0x7203, 0x60);
+		i2c_write(0x7011, 0xd5);
+	} else if (vic == 97 || hdmi_mode_is_hi_rate(mode)) {
 		i2c_write(0x7072, 0x01);
 		i2c_write(0x7074, 0x07);
 		i2c_write(0x7206, 0x80);
@@ -1184,7 +1274,8 @@
 	const char *src;
 	int lo, hi;
 
-	return ps5_hdmi_vrr_possible() && !ps5_hdmi_vrr_range(&lo, &hi, &src);
+	/* not in FRL modes: 4K120 VRR runs on Sony's FRL setup without them */
+	return ps5_hdmi_vrr_possible() && !setup_frl && !ps5_hdmi_vrr_range(&lo, &hi, &src);
 }
 
