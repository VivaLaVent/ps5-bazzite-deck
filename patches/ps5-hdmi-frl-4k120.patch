@@ -1311,16 +1402,26 @@
 static void setHdmiVideoConfigFlava3(const struct drm_display_mode *mode,
 				     unsigned int bpc, bool yuv422)
 {
+	setup_frl = ps5_mode_frl(drm_match_cea_mode(mode));
 	configParamFlava3Pre();
 	configLinkTrainingFlava3();
 	setHdmiBasicVideoConfigFlava3(mode, bpc, yuv422);
 	initHdmiPhyForFlava3_1st();
 	initHdmiPhyForFlava3_2nd();
+	if (ps5_mode_frl(drm_match_cea_mode(mode))) {
+		sendSpdFlava3();
+		sceSetFrlLinkUpSequence(drm_match_cea_mode(mode));
+	}
 	mask_7203();
 	/* VRR: the VSync block (normal values) at stock's position, before the additional config */
 	if (vrr_stock_setup())
 		configVSyncSettingFlava3();
-	setVideoAdditionalConfigFlava3(mode);
+	if (ps5_mode_frl(drm_match_cea_mode(mode))) {
+		setVideoAdditionalConfigFrlFlava3();
+		pr_info("hdmi: %dx%d@%d over FRL\n", mode->hdisplay, mode->vdisplay, drm_mode_vrefresh(mode));
+	} else {
+		setVideoAdditionalConfigFlava3(mode);
+	}
 	vrr_follow_after_setup(mode);
 }
 
