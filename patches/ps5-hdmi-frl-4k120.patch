--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -708,6 +708,7 @@
 }
 
 static bool vrr_stock_setup(void);
+static bool setup_frl;		/* the running setup is the 4K120 FRL one */
 
 static void configVSyncSettingFlava3(void)
 {
@@ -895,6 +896,84 @@
 MODULE_PARM_DESC(rgb_range, "AVI RGB quantization range: 1 full (default), 2 limited, 0 default (TV decides)");
 static bool avi_rgb;
 
+/*
+ * 4K120 over HDMI 2.1 FRL (Sony's 13.60 setup for mode id 211): the TV
+ * mode (VIC 118) gets Sony's 4K120 mode index 0x0b (4K100, 0x0a, isn't offered); the chip trains the FRL
+ * link itself once the output is started with 5/3 02; the InfoFrames are updated by event
+ * sequence 0x30, which the chip runs when the FRL link is up. The GPU-to-chip DP link
+ * (HBR3 x4) carries 4K120 as YCbCr 4:2:2, amdgpu's own fallback when RGB doesn't fit.
+ * Offered on FLAVA3 when the TV lists 4K120 itself; hdmi.frl_4k120=0 never offers it.
+ */
+static bool frl_4k120 = true;
+module_param(frl_4k120, bool, 0644);
+MODULE_PARM_DESC(frl_4k120, "Offer 3840x2160 at 120 Hz over HDMI 2.1 FRL on FLAVA3 consoles (default on; 0 never offers it)");
+
+static bool ps5_mode_frl(u8 vic)
+{
+	return frl_4k120 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 && vic == 118;
+}
+
+/* Sony's 4K mode index (0x7227 / 0x7070): 0x0a = 4K100, 0x0b = 4K120 */
+static u8 ps5_frl_index(u8 vic)
+{
+	return vic == 118 ? 0x0b : 0x0a;
+}
+
+/* Source Product Description "SCEI" / "PS5", sent by the PS5 OS in FRL modes */
+static void sendSpdFlava3(void)
+{
+	i2c_init(1);
+	i2c_begin_block();
+	i2c_write_data(0x7244, (u8[]){'S', 'C', 'E', 'I'}, 4);
+	i2c_write_data(0x724c, (u8[]){'P', 'S', '5', 0x00, 0x00}, 5);
+	i2c_write(0x725c, 0x08);
+	i2c_write(0x7204, 0x20);
+	i2c_end_block();
+	i2c_waitclear(0x7204, 0x80);
+	i2c_exec();
+}
+
+/* event sequence 0x30, run by the chip once the FRL link is up: AVI with the VIC, IT content, game */
+static void sceSetFrlLinkUpSequence(u8 vic)
+{
+	u8 data[] = {0x30, 0x5b, 0x09, 0x00,
+		     0x02, 0x08, 0x02, 0x01, 0x01, 0x70, 0x11, 0x07,
+		     0x03, 0x08, 0x03, 0x01, 0x00, 0x70, 0x11, 0xff,
+		     0x02, 0x0c, 0x02, 0x02, 0x01, 0x72, 0x04, 0x60, 0x01, 0x70, 0x11, 0x07,
+		     0x03, 0x08, 0x03, 0x01, 0x00, 0x70, 0x11, 0xff,
+		     0x02, 0x11, 0x02, 0x03, 0x01, 0x72, 0x04, 0x60, 0x02, 0x72, 0x31, 0x00, 0x00,
+		     0x01, 0x72, 0x27, vic,
+		     0x02, 0x09, 0x03, 0x01, 0x01, 0x72, 0x26, 0x00, 0x80,
+		     0x02, 0x09, 0x03, 0x01, 0x01, 0x72, 0x28, 0x00, 0x30,
+		     0x02, 0x08, 0x02, 0x01, 0x01, 0x72, 0x04, 0x40,
+		     0x03, 0x08, 0x03, 0x01, 0x00, 0x72, 0x04, 0x40};
+
+	i2c_init(0);
+	i2c_cmd_4_16(data, sizeof(data));
+	i2c_exec();
+}
+
+/* FRL replacement for setVideoAdditionalConfigFlava3: no TMDS scrambling/SCDC, start in FRL mode */
+static void setVideoAdditionalConfigFrlFlava3(void)
+{
+	i2c_init(1);
+	i2c_begin_block();
+	i2c_write(0x705f, 0x80);
+	i2c_write(0x7419, 0x05);
+	i2c_write(0x740a, 0xff);
+	i2c_end_block();
+	i2c_waitclear(0x740a, 0xff);
+	i2c_begin_block();
+	i2c_write(0x7404, 0x00);
+	i2c_write(0x7a88, 0xff);
+	i2c_end_block();
+	i2c_waitclear(0x7a84, 0x01);
+	i2c_write(0x7a8b, 0x05);
+	i2c_cmd_5_3(0x02);
+	i2c_exec();
+	scrambling = false;
+}
+
 static void setHdmiBasicVideoConfigFlava3(const struct drm_display_mode *mode,
 					  unsigned int bpc, bool yuv422)
 {
@@ -926,6 +1005,12 @@
 		/* Set VIC and content type */
 		i2c_write_data(0x7227, (u8[]){0x06, 0x00}, 2);
 		i2c_write_data(0x7070, (u8[]){0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 6);
+	} else if (ps5_mode_frl(vic)) {
+		/* 4K120 over FRL: Sony's mode index */
+		u8 idx = ps5_frl_index(vic);
+
+		i2c_write_data(0x7227, (u8[]){idx, 0x00}, 2);
+		i2c_write_data(0x7070, (u8[]){idx, idx, 0x00, 0x00, 0x00, 0x00}, 6);
 	}
 	i2c_write(0x70c0, 0xdc);
 	i2c_write(0x621b, 0x00);
@@ -949,7 +1034,12 @@
 	}
 	i2c_write(0x10e7, 0xff);
 	i2c_write(0x7202, 0x20);
-	if (vic == 97 || hdmi_mode_is_hi_rate(mode)) {
