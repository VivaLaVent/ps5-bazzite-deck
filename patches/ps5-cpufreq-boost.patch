PS5 cpufreq: boost off and cpufreq stats (rmux, ps5-linux-patches-1 b465697, ported)

Boost off used the generic cpufreq_boost_set_sw, which kept the boost frequencies reachable;
the driver now lowers the ceiling to the highest regular P-state (3.2 GHz) itself. At init the
CPU is put in P0 and policy->cur set, so the current frequency and the cpufreq statistics are
right from the start. Same logic as rmux's commit, on this driver's SMU send.
---

--- a/drivers/cpufreq/ps5-cpufreq.c
+++ b/drivers/cpufreq/ps5-cpufreq.c
@@ -106,26 +106,50 @@
 	{ .frequency = CPUFREQ_TABLE_END },
 };
 
+static int ps5_cpufreq_set_pstate(u32 pstate)
+{
+	u32 arg = PS5_CORE_MASK_ALL | FIELD_PREP(PS5_PSTATE_MASK, pstate);
+
+	return ps5_smu_send(PS5_SMU_MSG_SET_PSTATE, arg, NULL);
+}
+
 static int ps5_cpufreq_target_index(struct cpufreq_policy *policy,
 				    unsigned int index)
 {
 	u32 pstate = ps5_freq_table[index].driver_data;
-	u32 arg;
 
 	if (pstate == 0xff)
 		return mp1_boost_enter(PS5_CPU_MHZ_FLOOR, PS5_CPU_MHZ_CEIL,
 					PS5_GPU_MHZ_FLOOR, PS5_GPU_MHZ_CEIL);
 
-	arg = PS5_CORE_MASK_ALL | FIELD_PREP(PS5_PSTATE_MASK, pstate);
-	return ps5_smu_send(PS5_SMU_MSG_SET_PSTATE, arg, NULL);
+	return ps5_cpufreq_set_pstate(pstate);
+}
+
+/*
+ * Boost off lowers the ceiling to the highest regular P-state; the core then
+ * moves the policy below the boost frequencies.
+ */
+static int ps5_cpufreq_set_boost(struct cpufreq_policy *policy, int state)
+{
+	policy->cpuinfo.max_freq = (state ? PS5_CPU_MHZ_CEIL : PS5_CPU_MHZ_FLOOR) * 1000;
+
+	return 0;
 }
 
 static int ps5_cpufreq_cpu_init(struct cpufreq_policy *policy)
 {
+	int ret;
+
+	/* start in a known state (P0, no boost), so cur and the stats are right */
+	ret = ps5_cpufreq_set_pstate(0);
+	if (ret)
+		return ret;
+
 	cpumask_copy(policy->cpus, cpu_present_mask);
 	policy->freq_table = ps5_freq_table;
 	policy->cpuinfo.transition_latency = PS5_TRANSITION_LATENCY_NS;
 	policy->boost_supported = true;
+	policy->cur = PS5_CPU_MHZ_FLOOR * 1000;
 
 	return 0;
 }
@@ -136,7 +160,7 @@
 	.verify		= cpufreq_generic_frequency_table_verify,
 	.target_index	= ps5_cpufreq_target_index,
 	.init		= ps5_cpufreq_cpu_init,
-	.set_boost	= cpufreq_boost_set_sw,
+	.set_boost	= ps5_cpufreq_set_boost,
 	.boost_enabled	= false,
 };
 
