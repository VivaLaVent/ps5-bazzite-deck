PS5 VRR: stock PHY tail and VSync block in every setup again

VRR worked in v1.6.3 and not in v1.7.0 (Gilles, LG C4). In v1.6.3, hdmi.vrr_test=1 also
made every setup use stock's full PHY tail (lane selectors 0x7030/0x7026, test 19) and
write the VSync block with normal values at stock's position before the additional
config (test 12). The v1.7.0 cleanup dropped both with the test code, and the chip's
follow mode no longer took. Both are back, on FLAVA3 with a TV that has a VRR range.
Also no wait-until-clear on the FreeSync SPD strobe: when the chip isn't outputting, the
console's controller stayed stuck in that wait and the whole console hung (v1.7.0).
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -707,6 +707,8 @@
 	i2c_exec();
 }
 
+static bool vrr_stock_setup(void);
+
 static void configVSyncSettingFlava3(void)
 {
 	i2c_init(1);
@@ -792,6 +794,34 @@
 	i2c_write(0x7025, 0x70);
 	i2c_write(0x7030, 0x36);
 	i2c_write(0x7025, 0x77);
+	if (vrr_stock_setup()) {
+		/* VRR: stock's full PHY tail (lane selectors), part of every setup VRR worked with */
+		static const u8 tail[][2] = {
+			{0x19, 0xdd}, {0x29, 0xdd}, {0x39, 0xef},
+		};
+		int i;
+
+		for (i = 0; i < ARRAY_SIZE(tail); i++) {
+			i2c_write(0x7030, tail[i][0]);
+			i2c_write(0x7026, tail[i][1]);
+		}
+		i2c_write(0x7030, 0x4a);
+		i2c_write(0x7024, 0x24);
+		i2c_write(0x7030, 0x1a);
+		i2c_write(0x7026, 0xcc);
+		i2c_write(0x7030, 0x2a);
+		i2c_write(0x7026, 0xdd);
+		i2c_write(0x7030, 0x3a);
+		i2c_write(0x7026, 0xef);
+		i2c_write(0x7030, 0x4b);
+		i2c_write(0x7024, 0x24);
+		i2c_write(0x7030, 0x1b);
+		i2c_write(0x7026, 0xcc);
+		i2c_write(0x7030, 0x2b);
+		i2c_write(0x7026, 0xdd);
+		i2c_write(0x7030, 0x3b);
+		i2c_write(0x7026, 0xef);
+	}
 	i2c_end_block();
 	i2c_exec();
 }
@@ -1143,6 +1173,20 @@
 }
 EXPORT_SYMBOL(ps5_hdmi_vrr_range);
 
+/*
+ * VRR worked when every setup used stock's
+ * full PHY tail and write the VSync block (normal values) at stock's position; without them
+ * dropped both with the test code and the chip no longer followed. Both are back, for
+ * FLAVA3 with a TV that has a VRR range.
+ */
+static bool vrr_stock_setup(void)
+{
+	const char *src;
+	int lo, hi;
+
+	return ps5_hdmi_vrr_possible() && !ps5_hdmi_vrr_range(&lo, &hi, &src);
+}
+
 /* one I2C program to the chip, without the shared i2c_ctx (runs from a work item) */
 static int vrr_icc(const u8 *body, int n)
 {
@@ -1205,7 +1249,7 @@
 	for (i = 0; i < 12; i++)
 		sum += spd[i];
 	spd[3] = (256 - (sum & 0xff)) & 0xff;
-	b[n++] = 0x01; b[n++] = 0; b[n++] = 0; b[n++] = 4;
+	b[n++] = 0x01; b[n++] = 0; b[n++] = 0; b[n++] = 3;
 	b[n++] = 0x02; b[n++] = 4 + 3 + 30; b[n++] = 0x02; b[n++] = 1;	/* 0x7240 = SPD */
 	b[n++] = 30; b[n++] = 0x72; b[n++] = 0x40;
 	memcpy(b + n, spd, 30); n += 30;
@@ -1213,10 +1257,14 @@
 	b[n++] = 1; b[n++] = 0x72; b[n++] = 0x03; b[n++] = 0x20; b[n++] = 0x20;
 	b[n++] = 0x02; b[n++] = 8; b[n++] = 0x02; b[n++] = 1;		/* 0x7204 = 0x20 */
 	b[n++] = 1; b[n++] = 0x72; b[n++] = 0x04; b[n++] = 0x20;
-	b[n++] = 0x03; b[n++] = 8; b[n++] = 0x03; b[n++] = 1;		/* until it's taken */
-	b[n++] = 0; b[n++] = 0x72; b[n++] = 0x04; b[n++] = 0x20;
+	/*
+	 * no wait-until-clear on the strobe here. If the chip isn't outputting, the
+	 * bit never clears and the console's controller stays stuck in that wait:
+	 * (follow mode not taking) the whole console hung, SSH included.
+	 */
 	b[1] = n & 0xff; b[2] = n >> 8;
 	ret = vrr_icc(b, n);
+	msleep(20);
 	for (i = 0; i < ARRAY_SIZE(steps) && !ret; i++) {
 		msleep(VRR_FOLLOW_STEP_MS);
 		if (!READ_ONCE(vrr_follow))
@@ -1269,6 +1317,9 @@
 	initHdmiPhyForFlava3_1st();
 	initHdmiPhyForFlava3_2nd();
 	mask_7203();
+	/* VRR: the VSync block (normal values) at stock's position, before the additional config */
+	if (vrr_stock_setup())
+		configVSyncSettingFlava3();
 	setVideoAdditionalConfigFlava3(mode);
 	vrr_follow_after_setup(mode);
 }
