+/* ps5-linux-patches #53: HDMI CEC. The CEC driver gets every bridge notification. */
+static DEFINE_MUTEX(cec_lock);
+static void (*cec_handler)(void *data, const struct icc_msg *msg);
+static void *cec_data;
+
+void hdmi_set_cec_handler(void (*handler)(void *data, const struct icc_msg *msg),
+			  void *data)
+{
+	mutex_lock(&cec_lock);
+	cec_handler = handler;
+	cec_data = data;
+	mutex_unlock(&cec_lock);
+}
+EXPORT_SYMBOL(hdmi_set_cec_handler);
+
 /*
  * Re-arm after the sink re-announces itself.
  *
@@ -1764,5 +1779,10 @@
 			if (cancel_delayed_work(&rearm_work))
 				pr_info("picture up (0x%02x), re-arm cancelled\n", msg->data[1]);
 		}
+
+	mutex_lock(&cec_lock);
+	if (cec_handler)
+		cec_handler(cec_data, msg);
+	mutex_unlock(&cec_lock);
 }
