PS5 VRR: a running follow block stops when a newer setup starts

The follow block runs from a work item about 2 s after a setup. If VRR is switched again
or the mode changes meanwhile (e.g. 4K60 -> 4K120), the old block kept writing its steps
into the new setup. A generation counter, bumped by every VRR mode decision, makes it
stop; the newer setup runs its own follow block.
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -1170,6 +1170,7 @@
 static bool vrr_follow;			/* ... and the chip goes to follow mode */
 static bool vrr_follow_pending;		/* the setup's unmute waits for the follow block */
 static unsigned int vrr_follow_hz = 60;
+static atomic_t vrr_follow_gen = ATOMIC_INIT(0);	/* bumped by every setup and VRR switch */
 
 static u8 vrr_edid[512];
 static int vrr_edid_len;
@@ -1331,6 +1332,7 @@
 	u8 spd[30] = { 0x83, 0x01, 0x08, 0, 0x1a, 0, 0, 0, 0, 0x07 };
 	u8 b[64];
 	int i, n = 0, ret, sum = 0;
+	int gen = atomic_read(&vrr_follow_gen);
 
 	if (!READ_ONCE(vrr_follow))
 		goto out;
@@ -1358,7 +1360,8 @@
 	msleep(20);
 	for (i = 0; i < ARRAY_SIZE(steps) && !ret; i++) {
 		msleep(VRR_FOLLOW_STEP_MS);
-		if (!READ_ONCE(vrr_follow))
+		/* VRR switched off, or a newer setup started: that one runs its own follow block */
+		if (!READ_ONCE(vrr_follow) || atomic_read(&vrr_follow_gen) != gen)
 			goto out;
 		ret = vrr_icc_write(0x01, steps[i].reg, steps[i].v, steps[i].len);
 	}
@@ -1374,6 +1377,7 @@
 
 void sceHdmiSetVrrMode(bool on)
 {
+	atomic_inc(&vrr_follow_gen);
 	vrr_requested = on;
 	WRITE_ONCE(vrr_follow, on && ps5_hdmi_vrr_possible());
 	if (!vrr_follow) {
