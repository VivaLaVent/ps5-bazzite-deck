-	FRL_STEP(frl_send_hdcp_mode(hdcp));
-	FRL_STEP(frl_stop_hdcp());
-	FRL_STEP(FRL_SEND(disable_encode));
-	/* Share the initialization that applies the firmware's lane configuration. */
-	FRL_STEP(initIsrForFlava3());
-	FRL_STEP(initDpForFlava3(10));
-	FRL_STEP(FRL_SEND(vsync));
-	FRL_STEP(FRL_SEND(audio_mute));
-	FRL_STEP(FRL_SEND(scdc_read_prep));
-	FRL_STEP(frl_read_tmds_config(&tmds_config));
-	if (tmds_config)
-		FRL_STEP(frl_scdc_write_stopped(0x20, 0x00));
-	FRL_STEP(FRL_SEND(pre));
-	FRL_STEP(FRL_SEND(link_training));
-	FRL_STEP(setHdmiBasicVideoConfigFlava3(mode, config.bpc, config.format == PS5_HDMI_422, &config, bt2020));
-	FRL_STEP(FRL_SEND(phy_1st));
-	FRL_STEP(FRL_SEND(phy_2nd));
-	/* Upload metadata before startup; latch waits require live output. */
-	if (!frame) {
-		hdmi_drm_infoframe_init(&sdr);
-		ret = hdmi_drm_infoframe_pack_only(&sdr, hdr_data, sizeof(hdr_data));
-	} else {
-		ret = hdmi_drm_infoframe_pack_only(frame, hdr_data, sizeof(hdr_data));
-	}
-	if (ret != (int)sizeof(hdr_data)) {
-		ret = -EINVAL;
-		goto fail;
-	}
