+void amdgpu_dm_ps5_usbc_fini(struct amdgpu_display_manager *dm)
+{
+	amdgpu_dm_ps5_usbc_stop(dm);
+	if (dm->ps5_usbc_connector) {
+		ps5_usbc_unregister_notifier(&dm->ps5_usbc_notifier);
+		dm->ps5_usbc_connector = NULL;
+	}
+	ps5_hdmi_set_connector(NULL);
+}
