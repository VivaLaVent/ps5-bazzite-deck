+/* the TV's VRR range: HDMI Forum VSDB (VRRmin/VRRmax), else the AMD FreeSync VSDB */
+int ps5_hdmi_vrr_range(int *min_hz, int *max_hz, const char **src)
+{
+	int amd_min = 0, amd_max = 0, hf_min = 0, hf_max = 0;
+	int ext, n, i, len;
+	unsigned long flags;
+	u8 *e;
+
+	e = kmalloc(sizeof(vrr_edid), GFP_KERNEL);
+	if (!e)
+		return -ENOMEM;
+	spin_lock_irqsave(&vrr_edid_lock, flags);
+	len = vrr_edid_len;
+	memcpy(e, vrr_edid, len);
+	spin_unlock_irqrestore(&vrr_edid_lock, flags);
+
+	if (len < 128) {
+		kfree(e);
+		return -ENODATA;
+	}
+
+	n = e[0x7e];
+	for (ext = 1; ext <= n && (ext + 1) * 128 <= len; ext++) {
+		const u8 *b = &e[ext * 128];
+		int d = b[2];
+
+		if (b[0] != 0x02 || d < 4 || d > 127)
+			continue;
+		for (i = 4; i < d; i += 1 + (b[i] & 0x1f)) {
+			int tag = b[i] >> 5, l = b[i] & 0x1f;
+			const u8 *p = &b[i + 1];
+
+			if (tag != 3 || l < 3 || i + 1 + l > d)
+				continue;
+			if (p[0] == 0x1a && p[1] == 0x00 && p[2] == 0x00 && l >= 7) {
+				amd_min = p[5];
+				amd_max = p[6];
+			} else if (p[0] == 0xd8 && p[1] == 0x5d && p[2] == 0xc4 && l >= 10) {
+				hf_min = p[8] & 0x3f;
+				hf_max = ((p[8] & 0xc0) << 2) | p[9];
+			}
+		}
+	}
+	kfree(e);
+
+	/* VRRmax 0 is open-ended: use the FreeSync maximum, else 120 Hz, this chip's highest. */
+	if (hf_min >= 1 && hf_max == 0)
+		hf_max = amd_max > hf_min + 10 ? amd_max : 120;
+
+	if (hf_min >= 1 && hf_max > hf_min + 10) {
+		*min_hz = hf_min; *max_hz = hf_max; *src = "HDMI VRR range";
+	} else if (amd_min >= 1 && amd_max > amd_min + 10) {
+		/* HDMI VRR only, as on the PS5 system: FreeSync-only monitors resynced on every change and blanked. */
+		*src = "the display announces only FreeSync, no HDMI VRR";
+		return -ENODATA;
+	} else {
+		return -ENODATA;
+	}
+	*min_hz = max(*min_hz, VRR_MIN_HZ);
+	if (*max_hz <= *min_hz + 10)
+		return -ENODATA;
+	WRITE_ONCE(vrr_min_hz, *min_hz);
+	return 0;
+}
