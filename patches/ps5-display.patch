+static void dm_ps5_set_hdr_timing(struct dc_crtc_timing *timing,
+				  const struct drm_display_mode *mode,
+				  const struct drm_connector_state *state)
+{
+	const struct drm_display_info *info;
+	struct hdmi_drm_infoframe frame;
+	u8 vic = drm_match_cea_mode(mode);
+
+	if (!state || !state->connector)
+		return;
+	info = &state->connector->display_info;
+	/*
+	 * Unlike upstream, independent of the requested colour depth: on the PS5
+	 * "max bpc" is 8 (the only RGB depth the bridges take), and HDR10 always
+	 * goes out as 12 bpc 4:2:2.
