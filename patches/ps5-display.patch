+		pr_warn("VRR: switching the HDMI chip over failed (%d)\n", ret);
+	else
+		pr_info("VRR: on, %u-%u Hz\n", spd[10], vrr_follow_hz);
+	msleep(VRR_FOLLOW_SETTLE_MS);
