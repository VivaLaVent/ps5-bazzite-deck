-/* Character/line accounting follows AMD's uncompressed FRL capacity model. */
-static bool frl_capacity(const struct drm_display_mode *mode, u8 format, u8 bpc,
-			 u8 rate, u32 *required_kbps, u32 *capacity_kbps)
-{
-	static const u8 lanes[] = { 0, 3, 3, 4, 4, 4, 4 };
-	static const u8 gbps[] = { 0, 3, 6, 6, 8, 10, 12 };
-	u64 clock, chars, available, overhead, audio, blank, active, free, savings;
-	u64 capacity, active_ps, blank_ps, reference_ps, borrowed, average;
-	u32 numerator, denominator;
-
-	if (!rate || rate > 6 || mode->clock <= 0 || mode->clock > 2000000 ||
-	    mode->hdisplay <= 0 || mode->htotal <= mode->hdisplay ||
-	    mode->htotal > 65535 || (bpc != 8 && bpc != 10 && bpc != 12))
-		return false;
-	switch (format) {
-	case PS5_HDMI_RGB:
-	case PS5_HDMI_444:
-		numerator = bpc;
-		denominator = 8;
-		break;
-	case PS5_HDMI_422:
-		/* HDMI packs 4:2:2 in 12-bit containers even at 8/10 bpc. */
-		numerator = denominator = 1;
-		break;
-	case PS5_HDMI_420:
-		numerator = bpc;
-		denominator = 16;
-		break;
-	default:
-		return false;
-	}
-	/* Pixel +0.5%, link -300 ppm, superblock/FEC/map overhead +0.3%. */
-	clock = DIV_ROUND_UP_ULL((u64)mode->clock * 1005, 1000);
-	overhead = DIV_ROUND_UP_ULL((u64)(lanes[rate] * 10 + 345) * 1000000,
-				   10 * (2040 + lanes[rate])) + 3000;
-	chars = (u64)gbps[rate] * 1000000 * lanes[rate] * 9997;
-	capacity = div64_u64(chars * (1000000 - overhead), 180000000000ULL);
-	chars = div64_u64(chars * mode->htotal, clock * 180000);
-	available = div64_u64(chars * (1000000 - overhead), 1000000);
-	/* Reserve eight-channel 192 kHz LPCM plus ACR and audio tolerance. */
-	audio = DIV_ROUND_UP_ULL(195195ULL * mode->htotal, clock * 1000);
-	blank = DIV_ROUND_UP_ULL((u64)(mode->htotal - mode->hdisplay) * numerator,
-				 denominator);
-	active = DIV_ROUND_UP_ULL((u64)mode->hdisplay * numerator, denominator);
-	if (blank < 32 * (1 + audio))
-		return false;
-	free = blank > 32 * (1 + audio) + 7 ? blank - 32 * (1 + audio) - 7 : 0;
-	savings = free * 7 / 8;
-	savings = savings > 4 ? savings - 4 : 0;
-	chars = DIV_ROUND_UP_ULL(active * 3, 2) + blank - savings;
-	if (!capacity || chars > available)
-		return false;
-	/* Check scheduling against the 400-tribyte borrowing limit. */
-	active_ps = DIV_ROUND_UP_ULL(DIV_ROUND_UP_ULL(active * 3, 2) * 1000000000,
-				    capacity);
-	blank_ps = DIV_ROUND_UP_ULL(blank * 1000000000, capacity);
-	reference_ps = div64_u64((u64)(mode->htotal - mode->hdisplay) * 1000000000, clock);
-	if (blank_ps > reference_ps)
-		return false;
-	reference_ps = div64_u64((u64)mode->hdisplay * 1000000000, clock);
-	average = DIV_ROUND_UP_ULL(clock * (active + blank), mode->htotal);
-	borrowed = active_ps > reference_ps ? active_ps - reference_ps : 0;
-	if (DIV_ROUND_UP_ULL(borrowed * average, 1000000000) > 400)
-		return false;
-	*required_kbps = DIV_ROUND_UP_ULL(chars * 16 * clock, mode->htotal);
-	*capacity_kbps = capacity * 16;
-	return true;
-}
