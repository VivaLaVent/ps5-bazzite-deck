+	drm_for_each_connector_iter(connector, &iter) {
+		struct amdgpu_dm_connector *aconnector;
+		struct dc_link *link;
+
+		if (connector->connector_type == DRM_MODE_CONNECTOR_WRITEBACK)
+			continue;
+		aconnector = to_amdgpu_dm_connector(connector);
+		link = aconnector->dc_link;
+		if (!link || aconnector->mst_root || link->ep_type != DISPLAY_ENDPOINT_PHY)
+			continue;
+		drm_info(dm->ddev,
+			 "PS5 display route: %s link=%u AUX index=%u (DDC%u) HPD index=%u (HPD_SOURCEID%u) BIOS USB-C=%u selected=%u\n",
+			 connector->name, link->link_index, link->ddc_hw_inst,
+			 link->ddc_hw_inst + 1, link->hpd_src, link->hpd_src + 1,
+			 link->link_id.id == CONNECTOR_ID_USBC ||
+			 link->link_enc->features.flags.bits.DP_IS_USB_C, link->ps5_usbc);
+		if (link->ps5_usbc) {
+			usbc = aconnector;
+			usbc_count++;
+		} else if (dc_is_dp_signal(link->connector_signal) ||
+			   dc_is_hdmi_signal(link->connector_signal)) {
+			hdmi = connector;
+			hdmi_count++;
+		}
+	}
+	drm_connector_list_iter_end(&iter);
+	if (hdmi_count == 1)
+		ps5_hdmi_set_connector(hdmi);
+	if (usbc_count != 1 || hdmi_count != 1) {
+		drm_warn(dm->ddev,
+			 "PS5 USB-C disabled: routing is ambiguous (USB-C=%u HDMI=%u); verify VBIOS and set usbc_dp.aux/usbc_dp.hpd\n",
+			 usbc_count, hdmi_count);
+		return;
+	}
+
+	dm->ps5_usbc_connector = usbc;
+	spin_lock_init(&dm->ps5_usbc_work_lock);
+	INIT_DELAYED_WORK(&dm->ps5_usbc_work, amdgpu_dm_ps5_usbc_work);
+	dm->ps5_usbc_notifier.notifier_call = amdgpu_dm_ps5_usbc_notify;
+	ret = ps5_usbc_register_notifier(&dm->ps5_usbc_notifier);
+	if (ret) {
+		drm_warn(dm->ddev, "PS5 USB-C notifier registration failed: %d\n", ret);
+		dm->ps5_usbc_connector = NULL;
+		return;
+	}
+	amdgpu_dm_ps5_usbc_start(dm);
+}
