-int ps5_hdmi_apply_plan(const struct ps5_hdmi_plan *plan)
-{
-	const struct drm_display_mode *mode = &plan->mode;
-	struct ps5_hdmi_frl_config config = plan->config;
-	const struct hdmi_drm_infoframe *frame = plan->hdr ? &plan->metadata : NULL;
