-	WRITE_ONCE(frl_output_active, true);
-	FRL_STEP(frl_send_start(start));
-	WRITE_ONCE(hdcp_abort_until, jiffies + msecs_to_jiffies(HDCP_ABORT_MS));
-	FRL_STEP(FRL_SEND(spd));
