+/*
+ * Does this sink talk SCDC? True for an HDMI Forum VSDB (OUI C4-5D-D8) with
+ * SCDC_Present, and also for a sink that lists 4K modes (VIC 93+) or 4:2:0-only
+ * modes: an HDMI 2.x TV that has fallen back to its HDMI 1.4 EDID still does
+ * that, and it needs the SCDC Source Version to come back. A 1080p HDMI 1.4
+ * TV lists neither, and never gets SCDC traffic.
+ */
+static bool edid_has_scdc(const u8 *e, int len)
+{
+	int ext, i, j;
+
+	if (len < 256)
+		return false;
+	for (ext = 1; ext <= e[0x7e] && (ext + 1) * 128 <= len; ext++) {
+		const u8 *b = &e[ext * 128];
+		int d = b[2];
+
+		if (b[0] != 0x02 || d < 4 || d > 127)
+			continue;
+		for (i = 4; i < d; i += 1 + (b[i] & 0x1f)) {
+			int tag = b[i] >> 5, l = b[i] & 0x1f;
+			const u8 *p = &b[i + 1];
+
+			if (i + 1 + l > d)
+				break;
+			if (tag == 3 && l >= 7 && p[0] == 0xd8 && p[1] == 0x5d && p[2] == 0xc4 &&
+			    (p[5] & 0x80))
+				return true;				/* SCDC_Present */
+			if (tag == 2)
+				for (j = 0; j < l; j++)
+					if ((p[j] & 0x7f) >= 93)
+						return true;			/* a 4K mode */
+			if (tag == 7 && l >= 1 && p[0] == 14)
+				return true;				/* 4:2:0-only modes */
+		}
+	}
+	return false;
