-	recovery->requested = crtc_state->mode;
-	recovery->candidate = crtc_state->mode;
-	recovery->hdr = hdr;
-	if (hdr)
-		memcpy(&recovery->metadata, blob->data, sizeof(recovery->metadata));
-	recovery->max_bpc = state->max_requested_bpc;
-	recovery->colorspace = state->colorspace;
-	recovery->broadcast_rgb = state->hdmi.broadcast_rgb;
-	recovery->status.generation = conn->ps5_hdmi_plan_valid ?
-		conn->ps5_hdmi_plan.generation : ps5_hdmi_connection_generation();
-	recovery->status.requested_width = crtc_state->mode.hdisplay;
-	recovery->status.requested_height = crtc_state->mode.vdisplay;
-	recovery->status.requested_millihz = dm_ps5_mode_millihz(&crtc_state->mode);
-	recovery->status.hdr = blob != NULL;
-	dm_ps5_recovery_put(conn->ps5_hdmi_recovery);
-	conn->ps5_hdmi_recovery = recovery;
-	conn->ps5_hdmi_attempt = 0;
-	return 0;
-}
-
-/* A deadline stops new attempts; an in-flight firmware request must finish. */
-static u32 dm_ps5_recovery_reserve(struct dm_ps5_recovery *recovery,
-				  const struct drm_display_mode *mode)
-{
-	unsigned long flags;
-	u32 attempt = 0;
-
-	spin_lock_irqsave(&recovery->lock, flags);
-	if (recovery->state != PS5_HDMI_PENDING && recovery->state != PS5_HDMI_FAILED)
-		goto out;
-	if (!recovery->attempts) {
-		/* Numbered at the first real attempt, so check-only commits are not counted. */
-		recovery->status.request = ps5_hdmi_recovery_next_request();
-		recovery->deadline = jiffies + msecs_to_jiffies(PS5_HDMI_RECOVERY_MS);
-	}
-	if (recovery->attempts >= PS5_HDMI_RECOVERY_ATTEMPTS ||
-	    time_after_eq(jiffies, recovery->deadline)) {
-		recovery->state = PS5_HDMI_EXHAUSTED;
-	} else {
-		attempt = ++recovery->attempts;
-		recovery->state = PS5_HDMI_RUNNING;
-		recovery->candidate = *mode;
-	}
-out:
-	spin_unlock_irqrestore(&recovery->lock, flags);
-	return attempt;
-}
-
-static bool dm_ps5_recovery_start(struct dm_connector_state *conn)
-{
-	struct dm_ps5_recovery *recovery = conn->ps5_hdmi_recovery;
-	unsigned long flags;
-	bool start;
-
-	if (!recovery)
-		return true;
-	if (recovery->status.generation != ps5_hdmi_connection_generation())
-		return false;
-	if (!conn->ps5_hdmi_attempt)
-		conn->ps5_hdmi_attempt = dm_ps5_recovery_reserve(recovery, &recovery->requested);
-	spin_lock_irqsave(&recovery->lock, flags);
-	start = conn->ps5_hdmi_attempt && conn->ps5_hdmi_attempt == recovery->attempts &&
-		recovery->state == PS5_HDMI_RUNNING;
-	spin_unlock_irqrestore(&recovery->lock, flags);
-	dm_ps5_recovery_report(recovery);
-	return start;
-}
-
-static void dm_ps5_recovery_complete(struct dm_connector_state *conn,
-				     const struct dc_stream_state *stream, int error)
-{
-	struct dm_ps5_recovery *recovery = conn->ps5_hdmi_recovery;
-	struct drm_display_mode mode, candidate;
-	unsigned long flags;
-	bool same_connection, frl;
-
-	if (!recovery)
-		return;
-	same_connection = recovery->status.generation == ps5_hdmi_connection_generation();
-	frl = conn->ps5_hdmi_plan_valid && conn->ps5_hdmi_plan.frl;
-	spin_lock_irqsave(&recovery->lock, flags);
-	if (!conn->ps5_hdmi_attempt || conn->ps5_hdmi_attempt != recovery->attempts) {
-		spin_unlock_irqrestore(&recovery->lock, flags);
-		return;
-	}
-	recovery->status.error = error;
-	if (!same_connection) {
-		recovery->state = PS5_HDMI_CANCELLED;
-	} else if (recovery->state != PS5_HDMI_EXHAUSTED) {
-		/* A TMDS error retries the same mode; it never lowers the refresh rate. */
-		if (!error)
-			recovery->state = PS5_HDMI_READY;
-		else if (frl || (ps5_hdmi_recovery_enabled() &&
-				 ++recovery->tmds_retries <= PS5_HDMI_TRANSIENT_RETRIES))
-			recovery->state = PS5_HDMI_FAILED;
-		else
-			recovery->state = PS5_HDMI_EXHAUSTED;
-	}
-	candidate = recovery->candidate;
-	if (!error && same_connection) {
-		dm_ps5_mode_from_timing(&stream->timing, &mode);
-		recovery->status.actual_width = mode.hdisplay;
-		recovery->status.actual_height = mode.vdisplay;
-		recovery->status.actual_millihz = dm_ps5_mode_millihz(&mode);
-		recovery->status.bpc = amdgpu_dm_convert_dc_color_depth_into_bpc(
-			stream->timing.display_color_depth);
-		recovery->status.format = stream->timing.pixel_encoding == PIXEL_ENCODING_RGB ?
-			PS5_HDMI_RGB : stream->timing.pixel_encoding == PIXEL_ENCODING_YCBCR444 ?
-			PS5_HDMI_444 : stream->timing.pixel_encoding == PIXEL_ENCODING_YCBCR420 ?
-			PS5_HDMI_420 : PS5_HDMI_422;
-		recovery->status.frl = frl;
-	}
-	spin_unlock_irqrestore(&recovery->lock, flags);
-	if (error && same_connection && frl)
-		dm_ps5_recovery_reject(recovery, &candidate, &conn->ps5_hdmi_plan);
-	dm_ps5_recovery_report(recovery);
-}
