+	 * No wait-until-clear on the strobe here. If the chip isn't outputting, the
+	 * bit never clears and the console's controller stays stuck in that wait:
+	 * (follow mode not taking) the whole console hung, SSH included.
+	 */
+	b[1] = n & 0xff; b[2] = n >> 8;
