+static int dm_ps5_commit_mode(struct drm_connector *connector, const struct drm_display_mode *mode)
+{
+	struct drm_device *ddev = connector->dev;
+	struct drm_atomic_commit *state = drm_atomic_commit_alloc(ddev);
+	struct drm_crtc *crtc = connector->state->crtc;
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_plane_state *plane_state;
+	int ret;
+
+	if (!state)
+		return -ENOMEM;
+	state->acquire_ctx = ddev->mode_config.acquire_ctx;
+	conn_state = drm_atomic_get_connector_state(state, connector);
+	ret = PTR_ERR_OR_ZERO(conn_state);
+	if (ret)
+		goto out;
+	crtc_state = drm_atomic_get_crtc_state(state, crtc);
+	ret = PTR_ERR_OR_ZERO(crtc_state);
+	if (ret)
+		goto out;
+	ret = drm_atomic_set_mode_for_crtc(crtc_state, mode);
+	if (ret)
+		goto out;
+	crtc_state->mode_changed = true;
+	plane_state = drm_atomic_get_plane_state(state, crtc->primary);
+	ret = PTR_ERR_OR_ZERO(plane_state);
+	if (ret)
+		goto out;
+	ret = drm_atomic_commit(state);
+out:
+	drm_atomic_commit_put(state);
+	return ret;
+}
+
+static void dm_ps5_frl_fallback_work_func(struct work_struct *work)
+{
+	struct drm_device *dev = READ_ONCE(ps5_frl_fallback_dev);
+	struct drm_connector_list_iter iter;
+	struct drm_connector *connector;
+	bool changed = false;
+
+	if (!dev)
+		return;
+	drm_modeset_lock_all(dev);
+	drm_connector_list_iter_begin(dev, &iter);
+	drm_for_each_connector_iter(connector, &iter) {
+		const struct drm_display_mode *cur, *mode, *best = NULL;
+		int ret;
+
+		if (connector->connector_type == DRM_MODE_CONNECTOR_WRITEBACK ||
+		    !ps5_dm_is_hdmi_connector(to_amdgpu_dm_connector(connector)) ||
+		    connector->status != connector_status_connected ||
+		    !connector->state || !connector->state->crtc ||
+		    !connector->state->crtc->state->active)
+			continue;
+		cur = &connector->state->crtc->state->mode;
+		if (drm_match_cea_mode(cur) != 118)
+			continue;
+		changed = true;
+		list_for_each_entry(mode, &connector->modes, head) {
+			if (mode->hdisplay != cur->hdisplay || mode->vdisplay != cur->vdisplay ||
+			    mode->flags & DRM_MODE_FLAG_INTERLACE || drm_match_cea_mode(mode) == 118 ||
+			    !isHdmiModeValid(mode, amdgpu_force_1080p))
+				continue;
+			if (!best || drm_mode_vrefresh(mode) > drm_mode_vrefresh(best))
+				best = mode;
+		}
+		if (!best) {
+			drm_warn(dev, "PS5: 4K120 withheld and no mode to fall back to\n");
+			continue;
+		}
+		drm_info(dev, "PS5: 4K120 withheld, falling back to " DRM_MODE_FMT "\n", DRM_MODE_ARG(best));
+		ret = dm_ps5_commit_mode(connector, best);
+		if (ret)
+			drm_warn(dev, "PS5: fallback modeset failed: %d\n", ret);
+	}
+	drm_connector_list_iter_end(&iter);
+	drm_modeset_unlock_all(dev);
+	if (changed)
+		drm_kms_helper_hotplug_event(dev);
+}
