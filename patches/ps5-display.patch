-static u16 frl_failure_bit(u8 format, u8 bpc)
-{
-	if (format > PS5_HDMI_420 || (bpc != 8 && bpc != 10 && bpc != 12))
-		return 0;
-	return BIT(format * 3 + (bpc - 8) / 2);
-}
