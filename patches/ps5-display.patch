+/*
+ * FLAVA3 places a 1440p picture as if the signal had the timing of the
+ * standard 2560x1440@60 (VESA DMT / CVT-RB, +hsync -vsync): horizontally it
+ * starts the picture 112 px after the rising edge of hsync (32 px pulse +
+ * 80 px back porch), vertically 33 lines after the vsync pulse. A sync with
+ * the other polarity moves the picture by the pulse width: -hsync 32 px to
+ * the left (Elgato 4K X), +vsync 5 lines up (LG TVs' 1440p120). So give both
+ * syncs the standard shape and polarity. The standard timings offered above
+ * already have it; this is the safety net for the sink's and desktop modes.
+ */
+#define PS5_FLAVA3_1440P_HSW	32
+#define PS5_FLAVA3_1440P_HBP	80
+#define PS5_FLAVA3_1440P_VBP	33
+
+static bool ps5_set_sync(int disp, int total, int bp, int width, u16 *start, u16 *end)
+{
+	int new_end = total - bp;
+	int new_start = new_end - width;
+
+	if (width <= 0 || new_start <= disp ||
+	    (new_start == *start && new_end == *end))
+		return false;
+	*start = new_start;
+	*end = new_end;
+	return true;
