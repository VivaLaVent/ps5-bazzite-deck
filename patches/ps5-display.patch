diff --git a/drivers/ps5/usbc_dp.c b/drivers/ps5/usbc_dp.c
new file mode 100644
index 000000000..ae99d4c2c
--- /dev/null
+++ b/drivers/ps5/usbc_dp.c
@@ -0,0 +1,307 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* PS5 USB-C DisplayPort policy. The port controller owns PD negotiation and the mux. */
+
+#define pr_fmt(fmt) "ps5-usbc: " fmt
+
+#include <linux/module.h>
+#include <linux/delay.h>
+#include <linux/notifier.h>
+#include <linux/ps5.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <drm/display/drm_dp.h>
+
+#define PS5_USBC_PORT 0
+#define USBC_GET_DEV_CONN_STATE 0x0c
+#define USBC_SET_PDCON_OP_MODE 0x10
+#define USBC_GET_PDCON_OP_MODE 0x11
+#define USBC_NOTIFY_SOC_WORKING 0x15
+#define USBC_SET_SUPPORTED_DEVICES 0x19
+#define USBC_MODE_NORMAL 5
+
+/* Prepare the FAT port before attachment can negotiate DP and assert HPD.
+ * AMDGPU calls this policy only after selecting a unique USB-C/HDMI route;
+ * real HPD and DRM detection/modesetting still control the video stream.
+ * enable=0 keeps the port controller policy untouched for diagnostics.
+ */
+/*
+ * Off by default programming the port's DP
+ * policy can reset a device on the front USB-C port, e.g. a boot drive there. USB-C
+ * displays and PSVR2: usbc_dp.enable=1 in cmdline.txt.
+ */
+static bool enable;
+module_param(enable, bool, 0444);
+MODULE_PARM_DESC(enable, "Prepare FAT USB-C DP policy (Sony/Genesys RAM allowlist and NORMAL mode) for USB-C displays/PSVR2 (default: off; it can reset a device on the front USB-C port)");
+
+static unsigned int dp_lanes = 4;
+module_param(dp_lanes, uint, 0444);
+MODULE_PARM_DESC(dp_lanes, "Maximum source lane budget: 4 (default), or 2; actual link is negotiated independently of controller mode");
+
+static unsigned int pdcon_mode = USBC_MODE_NORMAL;
+module_param(pdcon_mode, uint, 0444);
+MODULE_PARM_DESC(pdcon_mode, "USB-C controller operating mode: 5=NORMAL, 3=DETECT_ONLY, 4=USB_CHARGING (default: 5)");
+
+static bool probe_without_hpd;
+module_param(probe_without_hpd, bool, 0444);
+MODULE_PARM_DESC(probe_without_hpd, "Probe native AUX with low HPD; connect only after a valid DPCD reply (default: off)");
+
+static u8 saved_mode;
+static bool saved_mode_valid;
+
+static int aux = 1;
+module_param(aux, int, 0444);
+MODULE_PARM_DESC(aux, "Zero-based USB-C AUX index (default: 1 on FAT; -1: use VBIOS USB-C flag)");
+static int hpd = 1;
+module_param(hpd, int, 0444);
+MODULE_PARM_DESC(hpd, "Zero-based USB-C HPD index (default: 1 on FAT; -1: use VBIOS USB-C flag)");
+
+bool ps5_usbc_dp_matches_link(unsigned int aux_index, unsigned int hpd_index,
+			      bool bios_usbc)
+{
+	if (aux == -1 && hpd == -1)
+		return bios_usbc;
+	if (aux < 0 || aux > 5 || hpd < 0 || hpd > 5)
+		return false;
+	return aux_index == (unsigned int)aux && hpd_index == (unsigned int)hpd;
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_dp_matches_link);
+
+static BLOCKING_NOTIFIER_HEAD(ps5_usbc_notifiers);
+
+static int check_reply(const struct icc_msg *msg, const struct icc_msg *request,
+		       size_t reply_size)
+{
+	if (msg->magic != 0x42 || msg->unk_04 != 3 || msg->id != request->id ||
+	    msg->service_id != request->service_id ||
+	    msg->msg_type != (request->msg_type | 0x4000) ||
+	    msg->length < sizeof(*msg) + 2 + reply_size ||
+	    msg->length > ICC_MSG_MAX_SIZE)
+		return -EPROTO;
+	if (get_unaligned_le16(msg->data)) {
+		pr_warn_ratelimited("service %#x command %#x failed: controller status %#x\n",
+				    request->service_id, request->msg_type,
+				    get_unaligned_le16(msg->data));
+		return -EREMOTEIO;
+	}
+	return 0;
+}
+
+static int checked_query_data(u8 service, u16 command, const u8 *data,
+			      size_t data_size, size_t reply_size, u8 *payload)
+{
+	/* The three supported-device records need 32 payload + 12 header bytes. */
+	u8 query[44] = {};
+	struct icc_msg *request = (struct icc_msg *)query;
+	u8 *buffer;
+	struct icc_msg *msg;
+	int ret;
+
+	if (data_size > sizeof(query) - sizeof(*request))
+		return -EMSGSIZE;
+	buffer = kzalloc(ICC_MSG_MAX_SIZE, GFP_KERNEL);
+	if (!buffer)
+		return -ENOMEM;
+	msg = (struct icc_msg *)buffer;
+	request->service_id = service;
+	request->msg_type = command;
+	request->length = max_t(size_t, ICC_MSG_MIN_SIZE,
+				    sizeof(*request) + data_size);
+	memcpy(request->data, data, data_size);
+
+	/* Separate storage preserves the transaction ID assigned by icc_send(). */
+	ret = icc_query(query, buffer);
+	if (!ret)
+		ret = check_reply(msg, request, reply_size);
+	if (!ret && reply_size)
+		memcpy(payload, msg->data + 2, reply_size);
+	kfree(buffer);
+	return ret;
+}
+
+static int checked_query(u8 service, u16 command, u8 first, u8 second,
+			 size_t reply_size, u8 *payload)
+{
+	u8 data[] = { first, second };
+
+	return checked_query_data(service, command, data, sizeof(data),
+				  reply_size, payload);
+}
+
+static int usbc_set_supported_devices(void)
+{
+	/* ICC 0x19 replaces the RAM table, so retain both firmware Sony rows.
+	 * Wire records are LE16 VID, LE16 PID min/max, LE32 flags (10 bytes).
+	 * flags bit 0 = PDOnly, bit 1 = Caesar. Genesys identifies the tested
+	 * USB-C/DP cable candidate; its exact PD PID has not been captured.
+	 * No NVS write is performed. A fresh Type-C attachment may be needed
+	 * if PDCON already negotiated USB before this policy was installed.
+	 */
+	static const u8 devices[] = {
+		PS5_USBC_PORT, 3,
+		0x4c, 0x05, 0xde, 0x0c, 0xde, 0x0c, 0x02, 0, 0, 0,
+		0x4c, 0x05, 0x6b, 0x0d, 0x75, 0x0d, 0, 0, 0, 0,
+		0xe3, 0x05, 0, 0, 0xff, 0xff, 0, 0, 0, 0,
+	};
+	int ret;
+
+	BUILD_BUG_ON(sizeof(struct icc_msg) != 12);
+	BUILD_BUG_ON(sizeof(devices) != 32);
+	ret = checked_query_data(ICC_SERVICE_ID_USBC,
+				 USBC_SET_SUPPORTED_DEVICES, devices,
+				 sizeof(devices), 0, NULL);
+	if (!ret)
+		pr_info("USB-C controller accepted Sony + Genesys supported-device RAM policy\n");
+	return ret;
+}
+
+static int usbc_query(u16 command, u8 argument, size_t reply_size, u8 *buffer)
+{
+	return checked_query(ICC_SERVICE_ID_USBC, command, PS5_USBC_PORT,
+			     argument, reply_size, buffer);
+}
+
+bool ps5_usbc_dp_enabled(void)
+{
+	return enable;
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_dp_enabled);
+
+bool ps5_usbc_dp_probe_without_hpd(void)
+{
+	return probe_without_hpd;
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_dp_probe_without_hpd);
+
+bool ps5_usbc_dp_receiver_present(const u8 *dpcd, size_t length)
+{
+	u8 lanes;
+
+	if (length != DP_RECEIVER_CAP_SIZE)
+		return false;
+	/* Accept known DP revisions and the 8b/10b rates supported by this GPU. */
+	if (!((dpcd[DP_DPCD_REV] >= 0x10 && dpcd[DP_DPCD_REV] <= 0x14) ||
+	      (dpcd[DP_DPCD_REV] >= 0x20 && dpcd[DP_DPCD_REV] <= 0x21)))
+		return false;
+	switch (dpcd[DP_MAX_LINK_RATE]) {
+	case DP_LINK_BW_1_62:
+	case DP_LINK_BW_2_7:
+	case DP_LINK_BW_5_4:
+	case DP_LINK_BW_8_1:
+		break;
+	default:
+		return false;
+	}
+	lanes = dpcd[DP_MAX_LANE_COUNT] & DP_MAX_LANE_COUNT_MASK;
+	return lanes == 1 || lanes == 2 || lanes == 4;
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_dp_receiver_present);
+
+int ps5_usbc_dp_get_mode(u8 *mode)
+{
+	return usbc_query(USBC_GET_PDCON_OP_MODE, 0, 1, mode);
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_dp_get_mode);
+
+int ps5_usbc_dp_enable(void)
+{
+	u8 expected = pdcon_mode;
+	u8 observed;
+	unsigned int attempt;
+	int ret;
+
+	if (!enable)
+		return 0;
+	if (!spcie_is_initialized())
+		return -EPROBE_DEFER;
+	if ((dp_lanes != 2 && dp_lanes != 4) || pdcon_mode > 255)
+		return -EINVAL;
+	/* Save the baseline before any setter, including a failed transition. */
+	if (!saved_mode_valid) {
+		ret = ps5_usbc_dp_get_mode(&saved_mode);
+		if (ret)
+			return ret;
+		saved_mode_valid = true;
+	}
+
+	/* Install the partner policy before power/Working can negotiate DP. */
+	ret = usbc_set_supported_devices();
+	if (ret)
+		return ret;
+
+	/* VBUS is device 2, as in the supplied controller bring-up sequence. */
+	ret = checked_query(ICC_SERVICE_ID_DEVICE, 0, 2, 1, 0, NULL);
+	if (ret)
+		return ret;
+	ret = usbc_query(USBC_NOTIFY_SOC_WORKING, 0, 0, NULL);
+	if (ret)
+		return ret;
+	/* Keep the supplied firmware sequence's SOC notification settling delay. */
+	msleep(200);
+
+	ret = usbc_query(USBC_SET_PDCON_OP_MODE, expected, 0, NULL);
+	if (ret)
+		return ret;
+	/* A successful setter reply does not mean the transition has completed. */
+	for (attempt = 0; attempt < 40; attempt++) {
+		ret = ps5_usbc_dp_get_mode(&observed);
+		if (ret)
+			return ret;
+		if (observed == expected) {
+			pr_info("USB-C controller mode %u confirmed; native HPD/AUX must still be verified\n",
+				observed);
+			return 0;
+		}
+		msleep(50);
+	}
+	return -ETIMEDOUT;
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_dp_enable);
+
+void ps5_usbc_dp_disable(void)
+{
+	int ret;
+
+	if (!enable || !saved_mode_valid || !spcie_is_initialized())
+		return;
+	ret = usbc_query(USBC_SET_PDCON_OP_MODE, saved_mode, 0, NULL);
+	if (ret)
+		pr_warn("failed to restore USB-C controller mode %u: %d\n", saved_mode, ret);
+	else
+		saved_mode_valid = false;
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_dp_disable);
+
+int ps5_usbc_dp_get_state(struct ps5_usbc_state *state)
+{
+	/* The first two payload bytes are the controller result, not connection data. */
+	return usbc_query(USBC_GET_DEV_CONN_STATE, 0, sizeof(*state), (u8 *)state);
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_dp_get_state);
+
+unsigned int ps5_usbc_dp_lane_count(void)
+{
+	/* DC may probe before policy initialization rejects an invalid parameter. */
+	return dp_lanes == 2 ? 2 : 4;
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_dp_lane_count);
+
+int ps5_usbc_register_notifier(struct notifier_block *nb)
+{
+	return blocking_notifier_chain_register(&ps5_usbc_notifiers, nb);
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_register_notifier);
+
+void ps5_usbc_unregister_notifier(struct notifier_block *nb)
+{
+	blocking_notifier_chain_unregister(&ps5_usbc_notifiers, nb);
+}
+EXPORT_SYMBOL_GPL(ps5_usbc_unregister_notifier);
+
+void ps5_usbc_notification_handler(struct icc_msg *msg)
+{
+	/* The notification layout is firmware-specific: re-query authoritative state. */
+	blocking_notifier_call_chain(&ps5_usbc_notifiers, 0, NULL);
+}
+
+MODULE_DESCRIPTION("PlayStation 5 USB-C DisplayPort policy");
+MODULE_LICENSE("GPL");
