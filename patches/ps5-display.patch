+/*
+ * A display re-announcing (waking, input switch) wipes the bridge output, and a compositor keeping
+ * the mode never sets it up again: force an inactive/active commit pair, or blank/unblank fbcon
+ * when nobody is DRM master, unless the picture comes up first.
+ */
+static bool rearm = true;
+module_param(rearm, bool, 0644);
+MODULE_PARM_DESC(rearm, "Re-arm the HDMI output after the sink re-announces itself");
+static unsigned int rearm_settle_ms = 300;
+module_param(rearm_settle_ms, uint, 0644);
+MODULE_PARM_DESC(rearm_settle_ms, "Quiet time after the last EDID announce before re-arming");
+/*
+ * The console re-arm holds console_lock for seconds and blocks a session switch's VT change:
+ * skip it while a mode was set up within rearm_quiet_ms.
+ */
+static unsigned int rearm_quiet_ms = 5000;
+module_param(rearm_quiet_ms, uint, 0644);
+MODULE_PARM_DESC(rearm_quiet_ms, "Console re-arm only if the last video setup is this long ago (session switches)");
+static unsigned int rearm_max = 4;
+module_param(rearm_max, uint, 0644);
+MODULE_PARM_DESC(rearm_max, "Max automatic re-arms per rearm_window_s (0 = unlimited)");
+static unsigned int rearm_window_s = 120;
+module_param(rearm_window_s, uint, 0644);
+
+/* exported by drm, declared in drm's private drm_internal.h */
+bool drm_master_internal_acquire(struct drm_device *dev);
+void drm_master_internal_release(struct drm_device *dev);
+
+static DEFINE_MUTEX(rearm_dev_lock);
+static struct drm_device *rearm_dev;
+static ktime_t rearm_announce, rearm_hist[16];
+static unsigned int rearm_count;
+static bool rearm_manual;
+static void rearm_work_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(rearm_work, rearm_work_fn);
+
+static struct fb_info *rearm_fbcon_screen(struct drm_device *dev)
+{
+	struct fb_info *info;
+
+	if (!dev->fb_helper || !dev->fb_helper->info)
+		return NULL;
+	info = dev->fb_helper->info;
+	if (!drm_master_internal_acquire(dev))
+		return NULL;
+	drm_master_internal_release(dev);
+	return info;
+}
+
+static int rearm_commit_active(struct drm_device *dev, struct drm_modeset_acquire_ctx *ctx,
+			       struct drm_crtc *crtc, bool active)
+{
+	struct drm_atomic_commit *state;
+	struct drm_crtc_state *cs;
+	int ret;
+
+	state = drm_atomic_commit_alloc(dev);
+	if (!state)
+		return -ENOMEM;
+	state->acquire_ctx = ctx;
+	cs = drm_atomic_get_crtc_state(state, crtc);
+	if (IS_ERR(cs)) {
+		ret = PTR_ERR(cs);
+		goto out;
+	}
+	cs->active = active;
+	ret = drm_atomic_add_affected_connectors(state, crtc);
+	if (!ret)
+		ret = drm_atomic_commit(state);
+out:
+	drm_atomic_commit_put(state);
+	return ret;
+}
+
+static int rearm_output(struct drm_device *dev)
+{
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_list_iter it;
+	struct drm_connector *conn;
+	struct drm_crtc *crtc;
+	struct fb_info *info;
+	int ret;
+
+	info = rearm_fbcon_screen(dev);
+	if (info && ktime_ms_delta(ktime_get(), READ_ONCE(last_video_setup)) < rearm_quiet_ms) {
+		pr_info("re-arm: console just got the display (session switch?), skipped\n");
+		return 0;
+	}
+	if (info) {
+		pr_info("re-arm: blanking fb%d (no DRM master)\n", info->node);
+		console_lock();
+		ret = fb_blank(info, FB_BLANK_POWERDOWN);
+		/* always try to bring it back */
+		ret = fb_blank(info, FB_BLANK_UNBLANK) ?: ret;
+		console_unlock();
+		return ret;
+	}
+
+	DRM_MODESET_LOCK_ALL_BEGIN(dev, ctx, 0, ret);
+	crtc = NULL;
+	drm_connector_list_iter_begin(dev, &it);
+	drm_for_each_connector_iter(conn, &it) {
+		if (conn->state && conn->state->crtc && conn->state->crtc->state &&
+		    conn->state->crtc->state->active) {
+			crtc = conn->state->crtc;
+			pr_info("re-arm: cycling %s on %s\n", crtc->name, conn->name);
+			break;
+		}
+	}
+	drm_connector_list_iter_end(&it);
+	if (!crtc) {
+		pr_info("re-arm: no active output\n");
+		goto out;
+	}
+	ret = rearm_commit_active(dev, &ctx, crtc, false);
+	if (ret == -EDEADLK)
+		goto out;
+	if (ret)
+		pr_err("re-arm: inactive commit failed: %d\n", ret);
+	/* always try to bring it back, even if the off commit failed */
+	ret = rearm_commit_active(dev, &ctx, crtc, true);
+	if (ret && ret != -EDEADLK) {
+		pr_err("re-arm: active commit failed: %d, retrying\n", ret);
+		ret = rearm_commit_active(dev, &ctx, crtc, true);
+	}
+out:
+	DRM_MODESET_LOCK_ALL_END(dev, ctx, ret);
+	return ret;
+}
+
+static void rearm_work_fn(struct work_struct *work)
+{
+	ktime_t now = ktime_get();
+	unsigned int i, recent = 0;
+	bool manual;
+	int ret;
+
+	mutex_lock(&rearm_dev_lock);
+	manual = rearm_manual;
+	rearm_manual = false;
+	if (!rearm_dev)
+		goto unlock;
+	if (!manual) {
+		for (i = 0; i < ARRAY_SIZE(rearm_hist); i++)
+			if (rearm_hist[i] &&
+			    ktime_ms_delta(now, rearm_hist[i]) < rearm_window_s * 1000LL)
+				recent++;
+		if (rearm_max && recent >= rearm_max) {
+			pr_warn("re-arm: %u in the last %us, skipping\n", recent, rearm_window_s);
+			goto unlock;
+		}
+		rearm_hist[rearm_count % ARRAY_SIZE(rearm_hist)] = now;
+	}
+	rearm_count++;
+	if (manual)
+		pr_info("re-arm #%u (manual)\n", rearm_count);
+	else
+		pr_info("re-arm #%u, %lld ms after EDID announce\n", rearm_count,
+			ktime_ms_delta(now, rearm_announce));
+	ret = rearm_output(rearm_dev);
+	if (ret)
+		pr_err("re-arm failed: %d\n", ret);
+unlock:
+	mutex_unlock(&rearm_dev_lock);
+}
+
+static int rearm_trigger_set(const char *val, const struct kernel_param *kp)
+{
+	mutex_lock(&rearm_dev_lock);
+	rearm_manual = true;
+	mutex_unlock(&rearm_dev_lock);
+	mod_delayed_work(system_dfl_wq, &rearm_work, 0);
+	return 0;
+}
+static const struct kernel_param_ops rearm_trigger_ops = { .set = rearm_trigger_set };
+module_param_cb(rearm_trigger, &rearm_trigger_ops, NULL, 0200);
+MODULE_PARM_DESC(rearm_trigger, "Write anything to re-arm the HDMI output now");
+
+void ps5_hdmi_register_drm(struct drm_device *dev)
+{
+	mutex_lock(&rearm_dev_lock);
+	rearm_dev = dev;
+	mutex_unlock(&rearm_dev_lock);
+}
+EXPORT_SYMBOL(ps5_hdmi_register_drm);
+
+void ps5_hdmi_unregister_drm(struct drm_device *dev)
+{
+	mutex_lock(&rearm_dev_lock);
+	if (rearm_dev == dev)
+		rearm_dev = NULL;
+	mutex_unlock(&rearm_dev_lock);
+	cancel_delayed_work_sync(&rearm_work);
+}
+EXPORT_SYMBOL(ps5_hdmi_unregister_drm);
