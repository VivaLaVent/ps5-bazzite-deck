+static int rearm_output(struct drm_device *dev)
+{
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_list_iter it;
+	struct drm_connector *conn;
+	struct drm_crtc *crtc;
+	struct fb_info *info;
+	int ret;
+
+	info = rearm_fbcon_screen(dev);
+	if (info && ktime_ms_delta(ktime_get(), READ_ONCE(last_video_setup)) < rearm_quiet_ms) {
+		pr_info("re-arm: console just got the display (session switch?), skipped\n");
+		return 0;
+	}
+	if (info) {
+		pr_info("re-arm: blanking fb%d (no DRM master)\n", info->node);
+		console_lock();
+		ret = fb_blank(info, FB_BLANK_POWERDOWN);
+		/* always try to bring it back */
+		ret = fb_blank(info, FB_BLANK_UNBLANK) ?: ret;
+		console_unlock();
+		return ret;
+	}
+
+	DRM_MODESET_LOCK_ALL_BEGIN(dev, ctx, 0, ret);
+	crtc = NULL;
+	drm_connector_list_iter_begin(dev, &it);
+	drm_for_each_connector_iter(conn, &it) {
+		if (conn->state && conn->state->crtc && conn->state->crtc->state &&
+		    conn->state->crtc->state->active) {
+			crtc = conn->state->crtc;
+			pr_info("re-arm: cycling %s on %s\n", crtc->name, conn->name);
+			break;
+		}
+	}
+	drm_connector_list_iter_end(&it);
+	if (!crtc) {
+		pr_info("re-arm: no active output\n");
+		goto out;
+	}
+	ret = rearm_commit_active(dev, &ctx, crtc, false);
+	if (ret == -EDEADLK)
+		goto out;
+	if (ret)
+		pr_err("re-arm: inactive commit failed: %d\n", ret);
+	/* always try to bring it back, even if the off commit failed */
+	ret = rearm_commit_active(dev, &ctx, crtc, true);
+	if (ret && ret != -EDEADLK) {
+		pr_err("re-arm: active commit failed: %d, retrying\n", ret);
+		ret = rearm_commit_active(dev, &ctx, crtc, true);
+	}
+out:
+	DRM_MODESET_LOCK_ALL_END(dev, ctx, ret);
+	return ret;
+}
+
+static void rearm_work_fn(struct work_struct *work)
+{
+	ktime_t now = ktime_get();
+	unsigned int i, recent = 0;
+	bool manual;
+	int ret;
+
+	mutex_lock(&rearm_dev_lock);
+	manual = rearm_manual;
+	rearm_manual = false;
+	if (!rearm_dev)
+		goto unlock;
+	if (!manual) {
+		for (i = 0; i < ARRAY_SIZE(rearm_hist); i++)
+			if (rearm_hist[i] &&
+			    ktime_ms_delta(now, rearm_hist[i]) < rearm_window_s * 1000LL)
+				recent++;
+		if (rearm_max && recent >= rearm_max) {
+			pr_warn("re-arm: %u in the last %us, skipping\n", recent, rearm_window_s);
+			goto unlock;
+		}
+		rearm_hist[rearm_count % ARRAY_SIZE(rearm_hist)] = now;
+	}
+	rearm_count++;
+	if (manual)
+		pr_info("re-arm #%u (manual)\n", rearm_count);
+	else
+		pr_info("re-arm #%u, %lld ms after EDID announce\n", rearm_count,
+			ktime_ms_delta(now, rearm_announce));
+	ret = rearm_output(rearm_dev);
+	if (ret)
+		pr_err("re-arm failed: %d\n", ret);
+unlock:
+	mutex_unlock(&rearm_dev_lock);
+}
+
+static int rearm_trigger_set(const char *val, const struct kernel_param *kp)
+{
+	mutex_lock(&rearm_dev_lock);
+	rearm_manual = true;
+	mutex_unlock(&rearm_dev_lock);
+	mod_delayed_work(system_dfl_wq, &rearm_work, 0);
+	return 0;
+}
+static const struct kernel_param_ops rearm_trigger_ops = { .set = rearm_trigger_set };
+module_param_cb(rearm_trigger, &rearm_trigger_ops, NULL, 0200);
+MODULE_PARM_DESC(rearm_trigger, "Write anything to re-arm the HDMI output now");
+
+void ps5_hdmi_register_drm(struct drm_device *dev)
+{
+	mutex_lock(&rearm_dev_lock);
+	rearm_dev = dev;
+	mutex_unlock(&rearm_dev_lock);
+}
+EXPORT_SYMBOL(ps5_hdmi_register_drm);
+
+void ps5_hdmi_unregister_drm(struct drm_device *dev)
+{
+	mutex_lock(&rearm_dev_lock);
+	if (rearm_dev == dev)
+		rearm_dev = NULL;
+	mutex_unlock(&rearm_dev_lock);
+	cancel_delayed_work_sync(&rearm_work);
+}
+EXPORT_SYMBOL(ps5_hdmi_unregister_drm);
+
+static u32 last_edid_crc;
+static bool have_edid_crc;
+
 void hdmi_notification_handler(struct icc_msg *msg)
 {
+	u32 crc;
+	bool other, first;
+
+	/* PR #57: validate the ICC message before touching its payload */
+	if (msg->length < sizeof(*msg) + 4 || msg->length > ICC_MSG_MAX_SIZE)
+		return;
+
+	pr_debug("notify: 0x%02x (%*ph)\n", msg->data[1], 4, msg->data);
+
 		if (msg->data[1] == 0x02) {
-			fix_edid(&msg->data[4]);
-			real_edid = drm_edid_alloc(&msg->data[4], *(u16 *)&msg->data[2]);
+			const struct drm_edid *edid, *old;
+			u16 length = get_unaligned_le16(msg->data + 2);
+
+			if (length < EDID_LENGTH || length > msg->length - sizeof(*msg) - 4) {
+				pr_info_ratelimited("ignored an EDID announcement of %u bytes, keeping the previous EDID\n",
+						    length);
+				goto notify_cec;
+			}
+			{
+				u8 byte0 = msg->data[4];
+
+				fix_edid(&msg->data[4]);
+				frl_note_edid(byte0, &msg->data[4], length);
+			}
+			edid = drm_edid_alloc(&msg->data[4], length);
+			/*
+			 * Before #57 a short or broken announcement (seen around display
+			 * power changes, e.g. leaving the desktop for Game Mode) replaced
+			 * the EDID with nothing: the next detection read the bridge's own
+			 * EDID instead, a "generic display" with 1080p only (NikySantoro).
+			 * Keep the previous one.
+			 */
+			if (!edid || !drm_edid_valid(edid)) {
+				drm_edid_free(edid);
+				pr_info_ratelimited("ignored an invalid EDID announcement, keeping the previous EDID\n");
+				goto notify_cec;
+			}
+			/* PR #57: the EDID is stored under a lock and bound to one connector */
+			scoped_guard(mutex, &hdmi_edid_lock) {
+				old = real_edid;
+				real_edid = edid;
+			}
+			drm_edid_free(old);
+			sink_scdc = edid_has_scdc(&msg->data[4], length);
+			ps5_vrr_save_edid(msg);
 			pr_info("got real edid\n");
 			sceHdmiOutputMode();
 
-			mutex_lock(&hotplug_lock);
-			if (hotplug_handler)
-				hotplug_handler(hotplug_data);
-			mutex_unlock(&hotplug_lock);
+			/*
+			 * #46: the same sink re-announcing wipes the bridge output -> re-arm.
+			 * A different sink (other EDID) is set up by the hotplug path below
+			 * and the compositor's own modeset; re-arming it would re-apply the
+			 * previous sink's mode.
+			 */
+			crc = crc32_le(~0, &msg->data[4], length);
+			other = have_edid_crc && crc != last_edid_crc;
+			first = !have_edid_crc;
+			last_edid_crc = crc;
+			have_edid_crc = true;
+
+			/*
+			 * #43: a different sink (or the first one) -> amdgpu redetects via
+			 * its HPD path. The same sink re-announcing (after any modeset, a
+			 * TV input switch, a session switch) is the re-arm's job below: a
+			 * hotplug event there makes the compositor reprobe and modeset,
+			 * which makes the TV re-announce again (a storm at session start).
+			 */
+			if (first || other) {
+				mutex_lock(&hotplug_lock);
+				if (hotplug_handler)
+					hotplug_handler(hotplug_data);
+				mutex_unlock(&hotplug_lock);
+			}
+			if (other) {
+				if (cancel_delayed_work(&rearm_work) || rearm)
+					pr_info("different display, re-arm skipped\n");
+			} else if (rearm) {
+				rearm_announce = ktime_get();
+				mod_delayed_work(system_dfl_wq, &rearm_work,
+						 msecs_to_jiffies(rearm_settle_ms));
+			}
+		} else if (msg->data[1] == 0x03 ||
+			   (msg->data[1] == 0x04 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3)) {
+			/* link / picture up (Verde 0x03, FLAVA3 0x04): nothing to re-arm */
+			if (cancel_delayed_work(&rearm_work))
+				pr_info("picture up (0x%02x), re-arm cancelled\n", msg->data[1]);
 		}
+
+notify_cec:
+	/* every message, EDID or not, also goes to CEC (as before #57) */
+	mutex_lock(&cec_lock);
+	if (cec_handler)
+		cec_handler(cec_data, msg);
+	mutex_unlock(&cec_lock);
 }
 EXPORT_SYMBOL(hdmi_notification_handler);
