-static int frl_query(const u8 *body, size_t len, u8 *reply, size_t reply_len)
-{
-	struct icc_msg *msg;
-	int ret;
-
-	if (len > ICC_MSG_MAX_SIZE - sizeof(*msg) ||
-	    reply_len > ICC_MSG_MAX_SIZE - sizeof(*msg))
-		return -EINVAL;
-	msg = kzalloc(ICC_MSG_MAX_SIZE, GFP_KERNEL);
-	if (!msg)
-		return -ENOMEM;
-	msg->service_id = ICC_SERVICE_ID_HDMI;
-	msg->length = sizeof(*msg) + len;
-	memcpy(msg->data, body, len);
-	ret = icc_query((u8 *)msg, (u8 *)msg);
-	if (!ret && (msg->service_id != ICC_SERVICE_ID_HDMI || msg->msg_type != 0x4000 ||
-		     msg->length < sizeof(*msg) + max_t(size_t, reply_len, 2) ||
-		     msg->length > ICC_MSG_MAX_SIZE))
-		ret = -EPROTO;
-	if (!ret && (msg->data[0] || msg->data[1]))
-		ret = -EIO;
-	if (!ret && reply)
-		memcpy(reply, msg->data, reply_len);
-	kfree(msg);
-	return ret;
-}
-
-#define FRL_SEND(name) frl_query(msg_##name, sizeof(msg_##name), NULL, 0)
-#define FRL_STEP(expr) do { \
-	if (generation != frl_get_sink_generation()) { \
-		ret = -ENODEV; \
-		goto fail; \
-	} \
-	ret = (expr); \
-	if (ret) \
-		goto fail; \
-} while (0)
-
-static int frl_stop_hdcp(void)
-{
-	struct icc_msg *msg;
-	int ret;
-
-	msg = kzalloc(ICC_MSG_MAX_SIZE, GFP_KERNEL);
-	if (!msg)
-		return -ENOMEM;
-	msg->service_id = ICC_SERVICE_ID_GENERAL;
-	msg->msg_type = 0x1f;
-	msg->length = ICC_MSG_MIN_SIZE;
-	ret = icc_query((u8 *)msg, (u8 *)msg);
-	kfree(msg);
-	return ret;
-}
-
-/* Read converter registers without taking the sink DDC bus. */
-static int frl_reg_read(u16 reg, u8 count, u8 *out)
-{
-	const u8 body[] = {
-		0x04, 0x0c, 0x00, 0x01,
-		0x01, 0x08, 0x01, 0x01, count, reg >> 8, reg & 0xff, 0x00,
-	};
-	u8 reply[8 + 32];
-	int ret;
-
-	if (!count || count > 32)
-		return -EINVAL;
-	ret = frl_query(body, sizeof(body), reply, 8 + count);
-	if (!ret)
-		memcpy(out, reply + 8, count);
-	return ret;
-}
-
-static int frl_read_tmds_config(u8 *value)
-{
-	return frl_reg_read(0x7c00, 1, value);
-}
-
-/* Write SCDC while the converter output is stopped. */
-static int frl_scdc_write_stopped(u8 offset, u8 value)
-{
-	const u8 body[] = {
-		0x04, 0x53, 0x00, 0x08,
-		0x02, 0x0c, 0x02, 0x02, 0x01, 0x74, 0x19, 0x05, 0x01, 0x74, 0x0a, 0xff,
-		0x03, 0x08, 0x03, 0x01, 0x00, 0x74, 0x0a, 0xff,
-		0x02, 0x0c, 0x02, 0x02, 0x01, 0x74, 0x04, 0x00, 0x01, 0x7a, 0x88, 0xff,
-		0x03, 0x08, 0x03, 0x01, 0x00, 0x7a, 0x84, 0x01,
-		0x02, 0x08, 0x02, 0x01, 0x01, 0x7a, 0x8b, 0x05,
-		0x03, 0x08, 0x01, 0x01, 0x00, 0x14, 0x00, 0x00,
-		0x02, 0x0f, 0x02, 0x02, 0x01, 0x7c, 0x00, value,
-		0x04, 0x7a, 0x80, 0xa8, offset, 0x00, 0x80,
-		0x03, 0x08, 0x03, 0x01, 0x00, 0x7a, 0x84, 0x01,
-	};
-
-	BUILD_BUG_ON(sizeof(body) != 0x53);
-	return frl_query(body, sizeof(body), NULL, 0);
-}
-
-/* 5/1 controls HDCP: bit 0 HDCP off, bit 1 HDCP 2.2. */
-static int frl_send_hdcp_mode(u8 value)
-{
-	u8 body[sizeof(msg_hdcp_mode)];
-
-	memcpy(body, msg_hdcp_mode, sizeof(body));
-	/* msg_hdcp_mode is the 5/1 command with its value at byte 8. */
-	if (memcmp(body + 4, (u8[]){0x05, 0x05, 0x01, 0x01}, 4))
-		return -EINVAL;
-	body[8] = value;
-	return frl_query(body, sizeof(body), NULL, 0);
-}
-
-/* 5/3 = 02 lets the IC pick the FRL rate; a nonzero high nibble selects a rate. */
-static int frl_send_start(u8 value)
-{
-	u8 body[sizeof(msg_frl_start)];
-	size_t n = sizeof(body);
-
-	memcpy(body, msg_frl_start, n);
-	/* msg_frl_start ends with the 5/3 command. */
-	if (memcmp(body + n - 5, (u8[]){0x05, 0x05, 0x03, 0x01}, 4))
-		return -EINVAL;
-	body[n - 1] = value;
-	return frl_query(body, n, NULL, 0);
-}
-
-/*
- * 0x7019 bit 6 is set while the IC sends FRL: 43 on a trained link, 00 or 01
- * after a fallback to TMDS.
- * Returns the ms waited, or -ETIMEDOUT.
- */
-static int frl_wait_link(unsigned int timeout_ms, u8 *value)
-{
-	unsigned int waited = 0;
-	int ret;
-
-	for (;;) {
-		ret = frl_reg_read(0x7019, 1, value);
-		if (ret)
-			return ret;
-		if (*value & 0x40)
-			return waited;
-		if (waited >= timeout_ms)
-			return -ETIMEDOUT;
-		msleep(100);
-		waited += 100;
-	}
-}
-
-/* Stop and mute the output and clear the sink's FRL_Rate. */
-static int frl_cleanup(void)
-{
-	int ret, first;
-
-	allm_reset();
-	first = frl_stop_hdcp();
-	ret = FRL_SEND(disable_encode);
-	if (!first)
-		first = ret;
-	if (!ret && READ_ONCE(frl_output_active)) {
-		ret = frl_scdc_write_stopped(0x31, 0);
-		if (!ret)
-			WRITE_ONCE(frl_output_active, false);
-		if (!first)
-			first = ret;
-	}
-	WRITE_ONCE(hdcp_abort_until, jiffies);
-	mutex_lock(&frl_state_lock);
-	frl_cleanup_failed = first != 0;
-	mutex_unlock(&frl_state_lock);
-	return first;
-}
-
-/* Passive IC status reads after startup. */
-static int frl_verify_output(const struct ps5_hdmi_plan *plan)
-{
-	unsigned int i, good = 0, bad = 0;
-	u8 link, mute;
-	int ret;
-
-	if (!frl_reported_rate_valid(READ_ONCE(frl_trained_rate), plan->rate_mask))
-		return -EIO;
-	for (i = 0; i < 5; i++) {
-		if (plan->generation != frl_get_sink_generation())
-			return -ENODEV;
-		ret = frl_reg_read(0x7019, 1, &link);
-		if (ret)
-			return ret;
-		ret = frl_reg_read(0x705f, 1, &mute);
-		if (ret)
-			return ret;
-		if (plan->generation != frl_get_sink_generation())
-			return -ENODEV;
-		if (link & 0x40 && !(mute & 0x80)) {
-			bad = 0;
-			if (++good == 2)
-				return 0;
-		} else {
-			good = 0;
-			if (++bad == 2)
-				return -EIO;
-		}
-		msleep(100);
-	}
-	return -ETIMEDOUT;
-}
-
-/* Register the video-latch sequence that firmware runs after FRL training. */
-static int frl_set_video_sequence(const struct ps5_hdmi_frl_config *config, bool bt2020,
-				  bool allm)
-{
-	u8 seq[128];
-	size_t len;
-
-	i2c_init(0);
-	i2c_write(0x7011, 0x07);
-	i2c_waitclear(0x7011, 0xff);
-	/* With ALLM, latch and resend the HF-VSIF after training. */
-	i2c_begin_block();
-	i2c_write(0x7204, allm ? 0xe0 : 0x60);
-	i2c_write(0x7011, allm ? 0x0f : 0x07);
-	i2c_end_block();
-	i2c_waitclear(0x7011, 0xff);
-	i2c_begin_block();
-	i2c_write(0x7204, allm ? 0xe0 : 0x60);
-	i2c_write_data(0x7231, (u8[]){0, 0}, 2);
-	i2c_write(0x7227, config->vic);
-	i2c_end_block();
-	i2c_mask(0x7226, 0x00, 0x80);
-	i2c_mask(0x7228, 0x00, 0x30);
-	i2c_mask(0x7225, bt2020 ? 0xc0 : config->format == PS5_HDMI_RGB ? 0x00 : 0x80,
-		 0xc0);
-	i2c_mask(0x7226, bt2020 ? 0x60 : 0x00, 0x70);
-	if (config->format == PS5_HDMI_RGB) {
-		i2c_mask(0x7226, config->limited ? 0x04 : 0x08, 0x0c);
-		i2c_mask(0x7228, config->limited ? 0x00 : 0x40, 0xc0);
-	}
-	i2c_write(0x7204, allm ? 0xc1 : 0x41);
-	i2c_waitclear(0x7204, 0x41);
-	len = i2c_ctx.msg_cur - i2c_ctx.msg_buf;
-	if (len > sizeof(seq)) {
-		mutex_unlock(&i2c_lock);
-		return -E2BIG;
-	}
-	/* A registered sequence has an 8-bit length and its own header layout. */
-	seq[0] = 0x30;
-	seq[1] = len;
-	seq[2] = i2c_ctx.msg_hdr->count;
-	seq[3] = 0;
-	memcpy(seq + 4, i2c_ctx.msg_buf + 4, len - 4);
-	i2c_ctx.msg_cur = i2c_ctx.msg_buf + sizeof(*i2c_ctx.msg_hdr);
-	i2c_ctx.msg_hdr->count = 0;
-	i2c_cmd_4_16(seq, len);
-	return i2c_exec();
-}
-
-static int frl_upload_hdr(u8 data[], size_t len, unsigned int generation)
-{
-	i2c_init(1);
-	i2c_write_data(0x7e40, data, len);
-	if (generation != frl_get_sink_generation()) {
-		mutex_unlock(&i2c_lock);
-		return -ENODEV;
-	}
-	return i2c_exec();
-}
