-	return a->clock == b->clock && a->hdisplay == b->hdisplay &&
-	       a->hsync_start == b->hsync_start && a->hsync_end == b->hsync_end &&
-	       a->htotal == b->htotal && a->vdisplay == b->vdisplay &&
-	       a->vsync_start == b->vsync_start && a->vsync_end == b->vsync_end &&
-	       a->vtotal == b->vtotal && a->flags == b->flags &&
-	       a->picture_aspect_ratio == b->picture_aspect_ratio;
-}
-
-static u16 frl_failure_mask(const struct frl_failure_cache *cache,
-			    const struct drm_display_mode *mode, bool hdr,
-			    bool bt2020, bool rgb_limited)
-{
-	u16 mask = 0;
-	unsigned int i;
-
-	for (i = 0; i < cache->count; i++) {
-		const struct frl_failed_candidate *failed = &cache->candidates[i];
-		u8 flags = hdr | bt2020 << 1 |
-			   (failed->format == PS5_HDMI_RGB ? rgb_limited : true) << 2;
-
-		if (failed->flags == flags && frl_recovery_same_mode(mode, &failed->mode))
-			mask |= frl_failure_bit(failed->format, failed->bpc);
-	}
-	return mask;
-}
-
-static bool frl_failure_add(struct frl_failure_cache *cache,
-			    const struct ps5_hdmi_plan *plan)
-{
-	u16 bit = frl_failure_bit(plan->config.format, plan->config.bpc);
-	struct frl_failed_candidate *failed;
-
-	if (!bit)
-		return false;
-	if (frl_failure_mask(cache, &plan->mode, plan->hdr, plan->bt2020,
-			     plan->config.limited) & bit)
-		return true;
-	if (cache->count == FRL_RECOVERY_LIMIT)
-		return false;
-	failed = &cache->candidates[cache->count++];
-	failed->mode = plan->mode;
-	failed->format = plan->config.format;
-	failed->bpc = plan->config.bpc;
-	failed->flags = plan->hdr | plan->bt2020 << 1 | plan->config.limited << 2;
