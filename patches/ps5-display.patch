+/* one I2C program to the chip, without the shared i2c_ctx (runs from a work item) */
+static int vrr_icc(const u8 *body, int n)
+{
+	static u8 buf[ICC_MSG_MAX_SIZE];
+	static DEFINE_MUTEX(lock);
+	struct icc_msg *msg = (struct icc_msg *)buf;
+	int ret;
+
+	mutex_lock(&lock);
+	memset(buf, 0, sizeof(buf));
+	msg->service_id = ICC_SERVICE_ID_HDMI;
+	msg->length = sizeof(*msg) + n;
+	memcpy(msg->data, body, n);
+	if (icc_trace)
+		icc_trace_dump("hdmi icc query: ", buf);
+	ret = icc_query(buf, buf);
+	if (!ret && buf[0xc])
+		ret = -EIO;
+	mutex_unlock(&lock);
+	return ret;
+}
+
+/* one block write of one register (code, then a 2/2 command) */
+static int vrr_icc_write(u8 code, u16 reg, const u8 *data, int len)
+{
+	u8 b[48];
+	int n = 0;
+
+	b[n++] = code; b[n++] = 0; b[n++] = 0; b[n++] = 1;
+	b[n++] = 0x02; b[n++] = 4 + 3 + len; b[n++] = 0x02; b[n++] = 1;
+	b[n++] = len; b[n++] = reg >> 8; b[n++] = reg & 0xff;
+	memcpy(b + n, data, len);
+	n += len;
+	b[1] = n & 0xff; b[2] = n >> 8;
+	return vrr_icc(b, n);
+}
+
+/* the unmute the setup left to the follow block (same code as sceHdmiDeviceSetVideoMute) */
