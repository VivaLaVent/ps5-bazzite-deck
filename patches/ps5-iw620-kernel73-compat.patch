NXP IW620 Wi-Fi (mwifiex, out of tree): build against Linux 7.3

Adapts the vendored NXP driver to the 7.3 cfg80211 API (mgmt_tx and related callback
signatures). Applied to ps5-linux/ps5-linux-mwifiex by build.sh, not to the kernel tree.
---

diff --git a/mlinux/moal_cfg80211.c b/mlinux/moal_cfg80211.c
index 8404ea0..19f5f61 100644
--- a/mlinux/moal_cfg80211.c
+++ b/mlinux/moal_cfg80211.c
@@ -3423,8 +3423,17 @@ int woal_cfg80211_mgmt_tx(struct wiphy *wiphy,
 			  bool dont_wait_for_ack,
 #endif
 #endif
+#if KERNEL_VERSION(7, 3, 0) <= CFG80211_VERSION_CODE
+			  u64 kcookie)
+#else
 			  u64 *cookie)
+#endif
 {
+#if KERNEL_VERSION(7, 3, 0) <= CFG80211_VERSION_CODE
+	/* Since 7.3 cfg80211 allocates the cookie and passes it by value */
+	u64 cookie_val = kcookie;
+	u64 *cookie = &cookie_val;
+#endif
 #if KERNEL_VERSION(3, 6, 0) <= CFG80211_VERSION_CODE
 	struct net_device *dev = wdev->netdev;
 #endif
@@ -3641,6 +3650,7 @@ int woal_cfg80211_mgmt_tx(struct wiphy *wiphy,
 	}
 #endif
 
+#if KERNEL_VERSION(7, 3, 0) > CFG80211_VERSION_CODE
 #if KERNEL_VERSION(3, 8, 0) > LINUX_VERSION_CODE
 	*cookie = random32() | 1;
 #else
@@ -3650,6 +3660,7 @@ int woal_cfg80211_mgmt_tx(struct wiphy *wiphy,
 	*cookie = get_random_u32() | 1;
 #endif
 #endif
+#endif
 
 #if CFG80211_VERSION_CODE >= KERNEL_VERSION(5, 3, 0)
 	if (len > sizeof(moal_802_11_action_header) &&
diff --git a/mlinux/moal_cfg80211.h b/mlinux/moal_cfg80211.h
index a8a64c5..ca42cc9 100644
--- a/mlinux/moal_cfg80211.h
+++ b/mlinux/moal_cfg80211.h
@@ -324,8 +324,12 @@ int woal_cfg80211_mgmt_tx(struct wiphy *wiphy,
 			  bool dont_wait_for_ack,
 #endif
 #endif
+#if KERNEL_VERSION(7, 3, 0) <= CFG80211_VERSION_CODE
+			  u64 cookie);
+#else
 			  u64 *cookie);
 #endif
+#endif
 
 mlan_status woal_register_cfg80211(moal_private *priv);
 
diff --git a/mlinux/moal_sta_cfg80211.c b/mlinux/moal_sta_cfg80211.c
index dd1739f..5206101 100644
--- a/mlinux/moal_sta_cfg80211.c
+++ b/mlinux/moal_sta_cfg80211.c
@@ -257,7 +257,11 @@ woal_cfg80211_remain_on_channel(struct wiphy *wiphy,
 #if CFG80211_VERSION_CODE < KERNEL_VERSION(3, 8, 0)
 				enum nl80211_channel_type channel_type,
 #endif
+#if CFG80211_VERSION_CODE >= KERNEL_VERSION(7, 3, 0)
+				unsigned int duration, u64 cookie, const u8 *mac_addr);
+#else
 				unsigned int duration, u64 *cookie, const u8 *mac_addr);
+#endif
 
 static int woal_cfg80211_cancel_remain_on_channel(struct wiphy *wiphy,
 #if CFG80211_VERSION_CODE >= KERNEL_VERSION(3, 6, 0)
@@ -7654,7 +7658,11 @@ woal_cfg80211_remain_on_channel(struct wiphy *wiphy, struct wireless_dev *wdev,
 #if CFG80211_VERSION_CODE < KERNEL_VERSION(3, 8, 0)
 				enum nl80211_channel_type channel_type,
 #endif
+#if CFG80211_VERSION_CODE >= KERNEL_VERSION(7, 3, 0)
+				unsigned int duration, u64 kcookie, const u8 *mac_addr)
+#else
 				unsigned int duration, u64 *cookie, const u8 *mac_addr)
+#endif
 #else
 /**
  * @brief Make chip remain on channel
@@ -7675,6 +7683,11 @@ woal_cfg80211_remain_on_channel(struct wiphy *wiphy, struct net_device *dev,
 				unsigned int duration, u64 *cookie)
 #endif
 {
+#if CFG80211_VERSION_CODE >= KERNEL_VERSION(7, 3, 0)
+	/* Since 7.3 cfg80211 allocates the cookie and passes it by value */
+	u64 cookie_val = kcookie;
+	u64 *cookie = &cookie_val;
+#endif
 #if CFG80211_VERSION_CODE >= KERNEL_VERSION(3, 6, 0)
 	struct net_device *dev = wdev->netdev;
 #endif
@@ -7740,6 +7753,7 @@ woal_cfg80211_remain_on_channel(struct wiphy *wiphy, struct net_device *dev,
 
 	/* remain on channel operation success */
 	/* we need update the value cookie */
+#if CFG80211_VERSION_CODE < KERNEL_VERSION(7, 3, 0)
 #if LINUX_VERSION_CODE < KERNEL_VERSION(3, 8, 0)
 	*cookie = (u64)random32() | 1;
 #else
@@ -7748,6 +7762,7 @@ woal_cfg80211_remain_on_channel(struct wiphy *wiphy, struct net_device *dev,
 #else
 	*cookie = (u64)get_random_u32() | 1;
 #endif
+#endif
 #endif
 	priv->phandle->remain_on_channel = MTRUE;
 	priv->phandle->remain_bss_index = priv->bss_index;
@@ -11202,6 +11217,7 @@ done:
  *
  *  @return            0 -- success, otherwise fail
  */
+#if CFG80211_VERSION_CODE < KERNEL_VERSION(7, 3, 0)
 static int woal_cfg80211_probe_client(struct wiphy *wiphy,
 				      struct net_device *dev, const u8 *peer,
 				      u64 *cookie)
@@ -11209,6 +11225,7 @@ static int woal_cfg80211_probe_client(struct wiphy *wiphy,
 	return -1;
 }
 #endif
+#endif
 
 /**
  *  @brief Sends deauth packet to kernel
@@ -11842,7 +11859,8 @@ mlan_status woal_register_cfg80211(moal_private *priv)
 		woal_cfg80211_ops.assoc = woal_cfg80211_associate;
 		woal_cfg80211_ops.disconnect = NULL;
 		woal_cfg80211_ops.connect = NULL;
-#ifdef UAP_SUPPORT
+#if defined(UAP_SUPPORT) && CFG80211_VERSION_CODE < KERNEL_VERSION(7, 3, 0)
+		/* probe_client was removed from cfg80211_ops in 7.3 */
 		woal_cfg80211_ops.probe_client = woal_cfg80211_probe_client;
 #endif
 	}
