# One patch per feature, applied in this order on Linux 7.3.5 + rmux's shitshow linux.patch (build.sh)
ps5-s2idle.patch      # suspend-to-idle (Dasloh, PR #4)
ps5-display.patch     # the FLAVA3/VERDE display stack: modes, 4K120, VRR, HDR, test switches, overlay sensors
ps5-gpu.patch         # GPU clock governor with a temperature limit; KFD TLB flush (#57, #77)
ps5-cpufreq.patch     # schedutil rate limit 10 ms; off on the Pro
ps5-fan.patch         # the console's firmware fan control at an 80 °C target by default, kernel curve opt-in
ps5-bluetooth.patch   # Pro, MediaTek (#71) and IW620 (#75) Bluetooth; Salina xHCI kept in D0 (#78)
ps5-gpu-reset-guard.patch   # official #81: no full GPU reset on PS5 (it fails and takes the display down)
ps5-salina-xhci.patch   # official #83: a burst of events no longer kills the Salina xHCI (Bluetooth); poller message quiet
ps5-verde-hdmi.patch   # VERDE: HDR at 10/12 bpc, RGB range and 4K over FRL, all opt-in; VRR experimental (official #81, VERDE part)
