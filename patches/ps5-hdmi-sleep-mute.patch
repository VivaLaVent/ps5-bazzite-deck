PS5 HDMI: mute and leave HDR when the output goes down

amdgpu's commit tail mutes the bridge's audio and video and re-inits the
video config when a CRTC turns on or changes mode, but did nothing when it
turned off (sleep, display off). The bridge then kept sending the HDR
InfoFrame into a dying signal and TVs flickered between HDR and "no signal"
during sleep (v1.4.0-rc4 report). Now the off path mutes audio and video and
sends the SDR InfoFrame (EOTF 0, BT.709); the on path re-sends HDR as before.
---

--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -5293,10 +5293,22 @@
 		    (old_crtc_state->active &&
 		    (!new_crtc_state->active ||
 		     drm_atomic_crtc_needs_modeset(new_crtc_state)))) {
-			if (dm_new_crtc_state->stream && dc_is_dp_signal(dm_new_crtc_state->stream->signal)) {
+			struct dc_stream_state *ps5_stream = dm_new_crtc_state->stream ?:
+							     dm_old_crtc_state->stream;
+
+			if (ps5_stream && dc_is_dp_signal(ps5_stream->signal)) {
 				sceHdmiSetAudioMute(1);
 				sceHdmiDeviceSetVideoMute(1);
-				sceHdmiInitVideoConfig();
+				if (new_crtc_state->active) {
+					sceHdmiInitVideoConfig();
+				} else {
+					/*
+					 * The output goes down (sleep, display off): stay muted
+					 * and leave HDR, otherwise the TV keeps flickering between
+					 * HDR and a lost signal until the picture comes back.
+					 */
+					sceHdmiSetHdrConfig(NULL, false);
+				}
 			}
 		}
 	}
