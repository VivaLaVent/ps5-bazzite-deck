PS5 HDMI: debug log of bridge notifications and picture setups

Logs every notification from the HDMI bridge and every picture setup (mode,
VIC, bpc, RGB or YCbCr 4:2:2), with timestamps, to see where a black screen
starts. Dynamic debug, no module option: at boot with
  dyndbg="file drivers/ps5/hdmi.c +p"
on the kernel command line, or at runtime with
  echo 'file drivers/ps5/hdmi.c +p' > /sys/kernel/debug/dynamic_debug/control
---

diff --git a/drivers/ps5/hdmi.c b/drivers/ps5/hdmi.c
index 858c203d7..242af12bd 100644
--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -128,6 +128,13 @@ static bool scrambling;
 static bool hdr_enabled;
 static bool bt2020_enabled;
 
+/*
+ * Debug log of every notification from the HDMI bridge and every picture
+ * setup, with timestamps, to see where a black screen starts. Dynamic debug:
+ * at boot with  dyndbg="file drivers/ps5/hdmi.c +p"  on the command line, or
+ * at runtime:   echo 'file drivers/ps5/hdmi.c +p' > /sys/kernel/debug/dynamic_debug/control
+ */
+
 static void i2c_init(u8 code)
 {
 	i2c_ctx.msg_cur = i2c_ctx.msg_buf;
@@ -1181,6 +1188,9 @@ EXPORT_SYMBOL(sceHdmiInitVideoConfig);
 
 void sceHdmiSetVideoConfig(const struct drm_display_mode *mode, unsigned int bpc, bool yuv422)
 {
+	pr_debug("setup: %s@%d %d kHz vic %d, %u bpc %s\n", mode->name,
+		 drm_mode_vrefresh(mode), mode->clock, drm_match_cea_mode(mode),
+		 bpc, yuv422 ? "YCbCr 4:2:2" : "RGB");
 	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3) {
 		setHdmiVideoConfigFlava3(mode, bpc, yuv422);
 	} else {
@@ -1716,6 +1726,8 @@ void hdmi_notification_handler(struct icc_msg *msg)
 	u32 crc;
 	bool other;
 
+	pr_debug("notify: 0x%02x (%*ph)\n", msg->data[1], 4, msg->data);
+
 		if (msg->data[1] == 0x02) {
 			fix_edid(&msg->data[4]);
 			real_edid = drm_edid_alloc(&msg->data[4], *(u16 *)&msg->data[2]);
