PS5 Pro: CPU and GPU frequency drivers left out

A Pro tester on v1.8.x got an endless flood: "mp1fw_sendmsg: Error : busy msgid=0x22",
"cpufreq: Failed to change cpu frequency: -16" every 2.5 s and "devfreq ps5-gpufreq: dvfs
failed with (-5)" every 0.27 s. Both drivers come from rmux's 7.3 port (upstream's kernel has
neither); on the Pro their requests to the power controller (MP1) never get through, likely
because the Pro's own SMU backend (upstream #58) uses the same controller. On a Pro (GPU
1002:13da) they now don't start, and the firmware keeps setting the clocks. Other models are
unaffected.
---

--- a/drivers/cpufreq/ps5-cpufreq.c
+++ b/drivers/cpufreq/ps5-cpufreq.c
@@ -1,5 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
+#include <linux/pci.h>
 #include <linux/bitfield.h>
 #include <linux/cpufreq.h>
 #include <linux/init.h>
@@ -141,6 +142,18 @@
 
 static int __init ps5_cpufreq_init(void)
 {
+	/*
+	 * Not on the PS5 Pro (GPU 1002:13da): its frequency requests to the power
+	 * controller (MP1 UniversalModeEntry, 0x22) come back "busy" without end there
+	 * The Pro keeps the CPU clock its firmware sets.
+	 */
+	struct pci_dev *pro = pci_get_device(PCI_VENDOR_ID_ATI, 0x13da, NULL);
+
+	if (pro) {
+		pci_dev_put(pro);
+		pr_info("PS5 Pro: CPU clock control left to the firmware\n");
+		return -ENODEV;
+	}
 	pr_info("Strawberry was here\n");
 	return cpufreq_register_driver(&ps5_cpufreq_driver);
 }
--- a/drivers/devfreq/ps5-gpufreq.c
+++ b/drivers/devfreq/ps5-gpufreq.c
@@ -286,10 +286,28 @@
 
 static struct platform_device *ps5_gpufreq_pdev;
 
+/*
+ * Not on the PS5 Pro (GPU 1002:13da). There its requests to the power controller
+ * (MP1) come back "busy" without end, flooding the log every 0.27 s (
+ * where the Pro's own SMU backend from upstream #58 talks to the same controller). The Pro
+ * keeps the clocks its firmware sets, as with the upstream kernel, which has no such driver.
+ */
+static bool ps5_gpufreq_is_pro(void)
+{
+	struct pci_dev *p = pci_get_device(PCI_VENDOR_ID_ATI, 0x13da, NULL);
+
+	pci_dev_put(p);
+	return p;
+}
+
 static int __init ps5_gpufreq_init(void)
 {
 	int ret;
 
+	if (ps5_gpufreq_is_pro()) {
+		pr_info("PS5 Pro: GPU clock control left to the firmware\n");
+		return 0;
+	}
 	pr_info("Strawberry was here\n");
 
 	ret = platform_driver_register(&ps5_gpufreq_driver);
