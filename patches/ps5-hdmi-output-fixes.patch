PS5 HDMI output fixes

1. FLAVA3: don't program the "back to unplugged" / "back to wait resolution"
   event sequences that #43 enabled (black screen at boot on some TVs).
2. Re-arm (#46) only when the same sink re-announces itself (EDID checksum);
   FLAVA3's "picture up" (0x04) cancels a pending re-arm, like Verde's 0x03.
3. 8 bits per colour only (PS5): the "max bpc" property offers 8..8 and
   every commit is capped at 8 in the DRM core; the bridges show deeper RGB
   as posterized contours. HDR on FLAVA3 is sent as 12 bpc YCbCr 4:2:2 by
   amdgpu independently of this.
4. No "scaling mode" property on the PS5: compositors (KWin) add generated
   resolutions on connectors that can scale; the bridge only has a setup for
   its own few modes.
---

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 6ddb9cfbc..d0f0c0c28 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -3329,9 +3329,16 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 		break;
 	}
 
+#ifndef CONFIG_X86_PS5
+	/*
+	 * Not on the PS5: compositors such as KWin offer extra, generated
+	 * resolutions on connectors that can scale, and the HDMI bridge only has
+	 * a setup for its own few modes.
+	 */
 	drm_object_attach_property(&aconnector->base.base,
 				dm->ddev->mode_config.scaling_mode_property,
 				DRM_MODE_SCALE_NONE);
+#endif
 
 	if (connector_type == DRM_MODE_CONNECTOR_HDMIA
 		|| (connector_type == DRM_MODE_CONNECTOR_DisplayPort && !aconnector->mst_root))
@@ -3347,10 +3354,21 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 				adev->mode_info.underscan_vborder_property,
 				0);
 
+#ifdef CONFIG_X86_PS5
+	/*
+	 * PS5: RGB at 8 bpc is the only colour depth the HDMI bridges take, so
+	 * that's all the property offers (desktops then don't list 10 bit).
+	 */
+	if (!aconnector->mst_root)
+		drm_connector_attach_max_bpc_property(&aconnector->base, 8, 8);
+
+	aconnector->base.state->max_bpc = 8;
+#else
 	if (!aconnector->mst_root)
 		drm_connector_attach_max_bpc_property(&aconnector->base, 8, 16);
 
 	aconnector->base.state->max_bpc = 16;
+#endif
 	aconnector->base.state->max_requested_bpc = aconnector->base.state->max_bpc;
 
 	if (connector_type == DRM_MODE_CONNECTOR_HDMIA) {
diff --git a/drivers/gpu/drm/drm_atomic.c b/drivers/gpu/drm/drm_atomic.c
index e5c8ef06c..cc1e40b8a 100644
--- a/drivers/gpu/drm/drm_atomic.c
+++ b/drivers/gpu/drm/drm_atomic.c
@@ -568,6 +568,15 @@ static int drm_atomic_connector_check(struct drm_connector *connector,
 	struct drm_writeback_job *writeback_job = state->writeback_job;
 	const struct drm_display_info *info = &connector->display_info;
 
+#ifdef CONFIG_X86_PS5
+	/*
+	 * The PS5's HDMI bridges take RGB at 8 bits per colour; deeper RGB comes
+	 * out as posterized "rainbow" contours. Cap every commit at 8 (HDR on
+	 * FLAVA3 is sent as 12 bpc YCbCr 4:2:2 by amdgpu independently of this).
+	 */
+	if (state->max_requested_bpc > 8)
+		state->max_requested_bpc = 8;
+#endif
 	state->max_bpc = info->bpc ? info->bpc : 8;
 	if (connector->max_bpc_property)
 		state->max_bpc = min(state->max_bpc, state->max_requested_bpc);
diff --git a/drivers/ps5/hdmi.c b/drivers/ps5/hdmi.c
index 134d686af..a1304ad48 100644
--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -2,6 +2,7 @@
 
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
+#include <linux/crc32.h>
 #include <linux/hdmi.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
@@ -539,9 +540,13 @@ static void sceControlHdmiEvent(u8 enable)
 void hdmiSystemResume(void)
 {
 	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3) {
-		/* Needed for audio to come back after a replug. */
-		sceSetBackToUnpluggedSequence();
-		sceSetBackToWaitResolutionSequence();
+		/*
+		 * Not programmed: with these event sequences the FLAVA3 bridge re-announces
+		 * the sink during the first modeset on some TVs, link training fails and the
+		 * bridge stays without video until a replug (as before ps5-linux-patches #43).
+		 */
+		// sceSetBackToUnpluggedSequence();
+		// sceSetBackToWaitResolutionSequence();
 		i2c_cmd_4_2();
 		// sceSetHdcpSequence1st();
 		// sceSetHdcpSequence2nd();
@@ -843,6 +848,7 @@ static void setHdmiBasicVideoConfigFlava3(const struct drm_display_mode *mode,
 	i2c_exec();
 }
 
+
 static void setVideoAdditionalConfigFlava3(const struct drm_display_mode *mode)
 {
 	u8 vic = drm_match_cea_mode(mode);
@@ -1523,8 +1529,14 @@ void ps5_hdmi_unregister_drm(struct drm_device *dev)
 }
 EXPORT_SYMBOL(ps5_hdmi_unregister_drm);
 
+static u32 last_edid_crc;
+static bool have_edid_crc;
+
 void hdmi_notification_handler(struct icc_msg *msg)
 {
+	u32 crc;
+	bool other;
+
 		if (msg->data[1] == 0x02) {
 			fix_edid(&msg->data[4]);
 			real_edid = drm_edid_alloc(&msg->data[4], *(u16 *)&msg->data[2]);
@@ -1537,16 +1549,29 @@ void hdmi_notification_handler(struct icc_msg *msg)
 				hotplug_handler(hotplug_data);
 			mutex_unlock(&hotplug_lock);
 
-			/* #46: the same sink re-announcing wipes the bridge output -> re-arm */
-			if (rearm) {
+			/*
+			 * #46: the same sink re-announcing wipes the bridge output -> re-arm.
+			 * A different sink (other EDID) is set up by the hotplug path above
+			 * and the compositor's own modeset; re-arming it would re-apply the
+			 * previous sink's mode.
+			 */
+			crc = crc32_le(~0, &msg->data[4], *(u16 *)&msg->data[2]);
+			other = have_edid_crc && crc != last_edid_crc;
+			last_edid_crc = crc;
+			have_edid_crc = true;
+			if (other) {
+				if (cancel_delayed_work(&rearm_work) || rearm)
+					pr_info("different display, re-arm skipped\n");
+			} else if (rearm) {
 				rearm_announce = ktime_get();
 				mod_delayed_work(system_dfl_wq, &rearm_work,
 						 msecs_to_jiffies(rearm_settle_ms));
 			}
-		} else if (msg->data[1] == 0x03) {
-			/* link up: the bridge is configured, nothing to re-arm */
+		} else if (msg->data[1] == 0x03 ||
+			   (msg->data[1] == 0x04 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3)) {
+			/* link / picture up (Verde 0x03, FLAVA3 0x04): nothing to re-arm */
 			if (cancel_delayed_work(&rearm_work))
-				pr_info("link up, re-arm cancelled\n");
+				pr_info("picture up (0x%02x), re-arm cancelled\n", msg->data[1]);
 		}
 }
 EXPORT_SYMBOL(hdmi_notification_handler);
