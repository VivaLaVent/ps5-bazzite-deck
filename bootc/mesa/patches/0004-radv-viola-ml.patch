+/* The weights in the SGPR operand of dot8x2_i8_viola_amd. Writing them with s_mov costs three SALU
+ * instructions per op, which limits the op to about a third of its rate. Put them in the constant
+ * data instead and load up to four sets of weights for the next ops in the block with one SMEM
+ * instruction. The scalar cache only delivers new weights for about half the op's rate, so ops
+ * with the same weights (the same layer for several pixels) among the next 16 share a set.
+ * These SGPRs are written by SMEM, which s_waitcnt covers. The ops read them where they were
+ * loaded, at an offset, so that they are never copied.
+ */
+std::pair<Temp, unsigned>
+get_dot8x2_i8_viola_weights(isel_context* ctx, nir_intrinsic_instr* instr)
+{
+   auto it = ctx->viola_dot_weights.find(instr);
+   if (it != ctx->viola_dot_weights.end())
+      return it->second;
+
+   /* The next ops, up to four different sets of weights. */
+   nir_intrinsic_instr* batch[16];
+   unsigned slot[16];
+   uint32_t weights[4][4] = {};
+   unsigned count = 0, num_slots = 0;
+   for (nir_instr* cur = &instr->instr; cur && count < 16; cur = nir_instr_next(cur)) {
+      if (cur->type != nir_instr_type_intrinsic ||
+          nir_instr_as_intrinsic(cur)->intrinsic != nir_intrinsic_dot8x2_i8_viola_amd ||
+          ctx->viola_dot_weights.count(nir_instr_as_intrinsic(cur)))
+         continue;
+      nir_intrinsic_instr* dot = nir_instr_as_intrinsic(cur);
+      uint32_t w[4] = {0};
+      for (unsigned c = 0; c < 3; c++)
+         w[c] = nir_scalar_as_uint(nir_scalar_resolved(dot->src[3].ssa, c));
+      unsigned s = 0;
+      while (s < num_slots && memcmp(weights[s], w, sizeof(w)))
+         s++;
+      if (s == num_slots) {
+         if (num_slots == 4)
+            break;
+         memcpy(weights[num_slots++], w, sizeof(w));
+      }
+      batch[count] = dot;
+      slot[count++] = s;
+   }
+   /* Loads of 4, 8 or 16 dwords: the ops with a third set of weights get a later batch. */
+   if (num_slots == 3) {
+      num_slots = 2;
+      unsigned kept = 0;
+      for (unsigned i = 0; i < count; i++) {
+         if (slot[i] < 2) {
+            batch[kept] = batch[i];
+            slot[kept++] = slot[i];
+         }
+      }
+      count = kept;
+   }
+
+   std::vector<uint8_t>& data = ctx->program->constant_data;
+   data.resize(align(data.size(), 16), 0);
+   uint32_t offset = data.size();
+   for (unsigned i = 0; i < num_slots; i++)
+      data.insert(data.end(), (uint8_t*)weights[i], (uint8_t*)(weights[i] + 4));
+
+   /* One descriptor per block, covering the constant data from the batch onward. */
+   Builder bld(ctx->program, ctx->block);
+   if (ctx->viola_dot_rsrc_block != instr->instr.block ||
+       offset - ctx->viola_dot_rsrc_offset > ctx->program->dev.smem_offset_max) {
+      uint32_t desc[4];
+      ac_build_raw_buffer_descriptor(ctx->options->gfx_level, ctx->program->dev.has_desc_resource_level,
+                                     0, 0, desc);
+      ctx->viola_dot_rsrc = bld.pseudo(aco_opcode::p_create_vector, bld.def(s4),
+                                     bld.pseudo(aco_opcode::p_constaddr, bld.def(s2), bld.def(s1, scc),
+                                                Operand::c32(offset)),
+                                     Operand::c32(0xffffffffu), Operand::c32(desc[3]));
+      ctx->viola_dot_rsrc_block = instr->instr.block;
+      ctx->viola_dot_rsrc_offset = offset;
+   }
+
+   aco_opcode op = num_slots == 4   ? aco_opcode::s_buffer_load_dwordx16
+                   : num_slots == 2 ? aco_opcode::s_buffer_load_dwordx8
+                                    : aco_opcode::s_buffer_load_dwordx4;
+   Temp vec = bld.tmp(RegClass(RegType::sgpr, num_slots * 4));
+   aco_ptr<Instruction> load{create_instruction(op, Format::SMEM, 2, 1)};
+   load->operands[0] = Operand(ctx->viola_dot_rsrc);
+   load->operands[1] = Operand::c32(offset - ctx->viola_dot_rsrc_offset);
+   load->definitions[0] = Definition(vec);
+   load->smem().sync = memory_sync_info(storage_none, semantic_can_reorder);
+   bld.insert(std::move(load));
+
+   for (unsigned i = 0; i < count; i++)
+      ctx->viola_dot_weights[batch[i]] = {vec, slot[i] * 4};
+   return ctx->viola_dot_weights[instr];
+}
+
+void
+visit_dot8x2_i8_viola(isel_context* ctx, nir_intrinsic_instr* instr)
+{
+   /* The first three weights are read from SGPRs (the fourth SGPR of the operand is unused), the
+    * last one from the literal.
+    */
+   for (unsigned i = 0; i < 4; i++) {
+      if (!nir_scalar_is_const(nir_scalar_resolved(instr->src[3].ssa, i))) {
+         isel_err(&instr->instr, "dot8x2_i8_viola_amd weights must be constant");
+         return;
+      }
+   }
+
+   std::pair<Temp, unsigned> weights = get_dot8x2_i8_viola_weights(ctx, instr);
+   aco_ptr<Instruction> dot{create_instruction(aco_opcode::p_dot8x2_i8_viola, Format::PSEUDO, 6, 1)};
+   dot->operands[0] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[1].ssa)));
+   dot->operands[1] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[2].ssa)));
+   dot->operands[2] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[0].ssa)));
+   dot->operands[3] = Operand(weights.first);
+   dot->operands[4] =
+      Operand::literal32(nir_scalar_as_uint(nir_scalar_resolved(instr->src[3].ssa, 3)));
+   dot->operands[5] = Operand::c32(weights.second);
+   dot->definitions[0] = Definition(get_ssa_temp(ctx, &instr->def));
+   ctx->block->instructions.emplace_back(std::move(dot));
+}
+
+void
+visit_dot4x2_i8_viola(isel_context* ctx, nir_intrinsic_instr* instr)
+{
+   /* Both weights come from SGPRs. The op also reads the SGPR after them: its product goes to the
+    * second register of the accumulator, whose value is not used.
+    */
+   Temp weights = get_ssa_temp(ctx, instr->src[3].ssa);
+   if (weights.type() != RegType::sgpr) {
+      isel_err(&instr->instr, "dot4x2_i8_viola_amd weights must be uniform");
+      return;
+   }
+
+   aco_ptr<Instruction> dot{create_instruction(aco_opcode::p_dot4x2_i8_viola, Format::PSEUDO, 4, 1)};
+   dot->operands[0] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[1].ssa)));
+   dot->operands[1] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[2].ssa)));
+   dot->operands[2] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[0].ssa)));
+   dot->operands[3] = Operand(weights);
+   dot->definitions[0] = Definition(get_ssa_temp(ctx, &instr->def));
+   ctx->block->instructions.emplace_back(std::move(dot));
+}
+
+void
+visit_dot4x2t_i8_viola(isel_context* ctx, nir_intrinsic_instr* instr)
+{
+   /* The weights stay in the registers they were loaded to; the op reads them from an offset. */
+   Temp weights = get_ssa_temp(ctx, instr->src[3].ssa);
+   if (weights.type() != RegType::sgpr) {
+      isel_err(&instr->instr, "dot4x2t_i8_viola_amd weights must be uniform");
+      return;
+   }
+
+   aco_ptr<Instruction> dot{create_instruction(aco_opcode::p_dot4x2_i8_viola, Format::PSEUDO, 5, 1)};
+   dot->operands[0] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[1].ssa)));
+   dot->operands[1] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[2].ssa)));
+   dot->operands[2] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[0].ssa)));
+   dot->operands[3] = Operand(weights);
+   /* The offset, and bit 8 for the high halves (op 0x24). */
+   bool hi = instr->intrinsic == nir_intrinsic_dot4x2t_hi_i8_viola_amd;
+   dot->operands[4] = Operand::c32(nir_intrinsic_base(instr) | (hi << 8));
+   dot->definitions[0] = Definition(get_ssa_temp(ctx, &instr->def));
+   ctx->block->instructions.emplace_back(std::move(dot));
+}
+
+void
+visit_quant8x4_viola(isel_context* ctx, nir_intrinsic_instr* instr)
+{
+   aco_ptr<Instruction> quant{create_instruction(aco_opcode::p_quant8x4_viola, Format::PSEUDO, 3, 1)};
+   quant->operands[0] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[0].ssa)));
+   quant->operands[1] = Operand(as_vgpr(ctx, get_ssa_temp(ctx, instr->src[1].ssa)));
+   quant->operands[2] = Operand::c32(nir_intrinsic_base(instr));
+   quant->definitions[0] = Definition(get_ssa_temp(ctx, &instr->def));
+   ctx->block->instructions.emplace_back(std::move(quant));
+}
