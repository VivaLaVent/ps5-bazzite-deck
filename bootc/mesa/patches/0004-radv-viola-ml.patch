+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "util/hash_table.h"
+#include "util/u_debug.h"
+#include "nir_builder.h"
+#include "radv_nir.h"
+
+/* Viola has no working v_dot4_i32_i8, but it has an int8 matrix instruction (op 0x23) that
+ * takes its weights from SGPRs and a literal and accumulates into fp16 (scaled by 2^-14).
+ *
+ * This pass finds chains of sdot_4x8_iadd whose weights are constant or uniform:
+ *
+ *    acc1 = sdot(x0, W0, acc0); acc2 = sdot(x1, W1, acc1); ...
+ *
+ * Integer adds inside a chain (nir_opt_algebraic moves the running sum of other blocks there)
+ * are taken out and added back at the end.
+ *
+ * Chains in a block that read the same inputs form a group. With constant weights, the chains of
+ * a group are paired and each pair is rewritten to dot8x2_i8_viola_amd, which does two inputs for
+ * both chains at once. Groups with the same constant weights and different inputs, such as one
+ * layer computed for several pixels, are rewritten together, alternating between them, so that
+ * consecutive ops have the same weights and ACO loads them once for all of them. Uniform weights
+ * can't go in the literal. When they come from a vector load with the weights of two chains two
+ * components apart, the pair uses dot4x2t_i8_viola_amd, which does one input for both chains and
+ * reads the weights where they were loaded. Other chains do two inputs for one chain per op, with
+ * dot4x2t_i8_viola_amd when the two weights are next to each other in a load and
+ * dot4x2_i8_viola_amd otherwise.
+ *
+ * The fp16 sums are converted back to int32 at the end of a chain, unless the result feeds another
+ * chain, which then continues the fp16 sum up to MAX_TERMS terms. This is not exact: the sums are
+ * rounded to fp16 precision (11 bits). The pairs add one input per op, so they alternate between the
+ * low and the high half (op 0x24) to keep the same number of terms per rounded sum.
+ *
+ * Results that are requantized to int8, x / 2^s rounded to even (or x itself), clamped to
+ * [-128, 127] or [0, 127] (optionally after max(x, 0)) and packed four to a dword, go through the
+ * quantize op (op 0x28) from the fp16 sums instead of int32. x can also be a sum plus another value,
+ * such as a bias or a second sum. The rounding is half up instead of half to even. Results that are
+ * converted to float are computed in float from the fp16 sums.
+ *
+ * Everything else, including all sdot when use_ml is false, is lowered here to byte extracts and
+ * multiplies, since has_sdot_4x8 is set for this chip.
+ */
+
+#define MAX_TERMS 64
+
+/* Groups rewritten together, and the most chains in them, which are all live at once. */
+#define MAX_TWINS       4
+#define MAX_TWIN_CHAINS 128
+
+struct dot_stats {
+   unsigned chains, ops, lowered, quant;
+};
+
+struct dot_term {
+   nir_scalar x; /* packed int8 inputs */
+   nir_scalar w; /* packed int8 weights, constant or uniform */
+};
+
+/* An integer add between two terms of a chain: src[src] is added to the result. */
+struct dot_addend {
+   nir_alu_instr *iadd;
+   unsigned src;
+};
+
+struct dot_chain {
+   nir_alu_instr *first; /* src[2] is the accumulator input */
+   nir_alu_instr *last;  /* defines the chain result: the last term or an add after it */
+   unsigned num_terms, num_addends;
+   bool const_w;
+   bool add_at_end; /* last is an add of the result into a running sum, the last addend */
+   struct dot_term terms[MAX_TERMS];
+   struct dot_addend addends[MAX_TERMS];
+};
+
+/* A chain result written by this pass: rest + fp16 * 2^14. */
+struct dot_sum {
+   nir_def *fp16; /* in the low half, or the sum of both halves */
+   nir_def *rest;
+   unsigned terms; /* in the fp16 sum */
+   bool hi;        /* the high half is used */
+};
+
+struct dot_ctx {
+   nir_builder b;
+   struct hash_table *sums;    /* nir_def * -> struct dot_sum */
+   struct hash_table *reloads; /* load nir_def * -> the same load at the current group */
+   struct dot_stats stats;
+};
+
+static bool
+get_term(nir_alu_instr *alu, struct dot_term *t)
+{
+   if (alu->op != nir_op_sdot_4x8_iadd || alu->def.num_components != 1)
+      return false;
+
+   for (unsigned i = 0; i < 2; i++) {
+      t->w = nir_get_scalar(alu->src[i].src.ssa, alu->src[i].swizzle[0]);
+      t->x = nir_get_scalar(alu->src[!i].src.ssa, alu->src[!i].swizzle[0]);
+      if (nir_scalar_is_const(t->w) && !nir_scalar_is_const(t->x))
+         return true;
+   }
+   for (unsigned i = 0; i < 2; i++) {
+      t->w = nir_get_scalar(alu->src[i].src.ssa, alu->src[i].swizzle[0]);
+      t->x = nir_get_scalar(alu->src[!i].src.ssa, alu->src[!i].swizzle[0]);
+      if (!nir_src_is_divergent(&alu->src[i].src) && nir_src_is_divergent(&alu->src[!i].src))
+         return true;
+   }
+   return false;
+}
+
+static nir_instr *
+single_use_in_block(nir_def *def, nir_block *block)
+{
+   if (!list_is_singular(&def->uses))
+      return NULL;
+
+   nir_src *use = list_first_entry(&def->uses, nir_src, use_link);
+   if (nir_src_is_if(use) || nir_src_use_instr(use)->block != block)
+      return NULL;
+   return nir_src_use_instr(use);
+}
+
+/* The term that consumes alu as its accumulator, directly or through one integer add, if that is
+ * alu's only use. The add, if any, is returned in addend.
+ */
+static nir_alu_instr *
+next_term(nir_alu_instr *alu, struct dot_addend *addend)
+{
+   nir_def *def = &alu->def;
+   addend->iadd = NULL;
+
+   nir_instr *instr = single_use_in_block(def, alu->instr.block);
+   if (!instr || instr->type != nir_instr_type_alu)
+      return NULL;
+
+   nir_alu_instr *next = nir_instr_as_alu(instr);
+   if (next->op == nir_op_iadd && next->def.num_components == 1) {
+      unsigned src = next->src[0].src.ssa == def ? 1 : 0;
+      if (next->src[src].src.ssa == def)
+         return NULL;
+      addend->iadd = next;
+      addend->src = src;
+      def = &next->def;
+
+      instr = single_use_in_block(def, alu->instr.block);
+      if (!instr || instr->type != nir_instr_type_alu)
+         return NULL;
+      next = nir_instr_as_alu(instr);
+   }
+
+   struct dot_term t;
+   if (!get_term(next, &t) || next->src[2].src.ssa != def)
+      return NULL;
+   return next;
+}
+
+static int
+cmp_scalar(nir_scalar a, nir_scalar b)
+{
+   if (a.def->index != b.def->index)
+      return a.def->index < b.def->index ? -1 : 1;
+   return (int)a.comp - (int)b.comp;
+}
+
+static int
+cmp_term(const void *a, const void *b)
+{
+   return cmp_scalar(((const struct dot_term *)a)->x, ((const struct dot_term *)b)->x);
+}
+
+static bool
+same_inputs(const struct dot_chain *a, const struct dot_chain *b)
+{
+   if (a->num_terms != b->num_terms)
+      return false;
+   for (unsigned i = 0; i < a->num_terms; i++) {
+      if (cmp_scalar(a->terms[i].x, b->terms[i].x))
+         return false;
+   }
+   return true;
+}
+
+/* The chain of a group that ends last, after which the group is rewritten. */
+static struct dot_chain *
+last_chain(struct dot_chain **chains, unsigned count)
+{
+   struct dot_chain *last = chains[0];
+   for (unsigned k = 1; k < count; k++) {
+      if (chains[k]->last->instr.index > last->last->instr.index)
+         last = chains[k];
+   }
+   return last;
+}
+
+/* Ends a chain at its last term instead of the add after it, which is left as it is. */
+static void
+drop_add_at_end(struct dot_chain *chain)
+{
+   const struct dot_addend *add = &chain->addends[--chain->num_addends];
+   chain->last = nir_def_as_alu(add->iadd->src[!add->src].src.ssa);
+   chain->add_at_end = false;
+}
+
+/* All uses of the chain result must come after the instruction with index "after". */
+static bool
+uses_after(const struct dot_chain *chain, unsigned after)
+{
+   nir_foreach_use_including_if (use, &chain->last->def) {
+      if (nir_src_is_if(use))
+         continue;
+      nir_instr *instr = nir_src_use_instr(use);
+      if (instr->block == chain->last->instr.block && instr->index <= after)
+         return false;
+   }
+   return true;
+}
+
+static nir_def *
+fp16_sum_to_int(nir_builder *b, nir_def *acc, bool hi)
+{
+   nir_def *sum = nir_f2f32(b, nir_unpack_32_2x16_split_x(b, acc));
+   if (hi)
+      sum = nir_fadd(b, sum, nir_f2f32(b, nir_unpack_32_2x16_split_y(b, acc)));
+   return nir_f2i32(b, nir_fmul_imm(b, sum, 16384.0));
+}
+
+/* An int32 input of a chain: the accumulator (k = 0) or an addend. */
+static nir_scalar
+chain_part(const struct dot_chain *chain, unsigned k)
+{
+   const nir_alu_instr *alu = k ? chain->addends[k - 1].iadd : chain->first;
+   unsigned src = k ? chain->addends[k - 1].src : 2;
+   return nir_get_scalar(alu->src[src].src.ssa, alu->src[src].swizzle[0]);
+}
+
+/* The fp16 sum of a chain starts at 0 and its int32 inputs are added at the end. If one of them is
+ * the result of an earlier chain, continue that chain's fp16 sum instead, unless the sum would get
+ * too long to be accurate, or uses the high half and the chain doesn't. Returns the index of that
+ * input, or -1.
+ */
+static int
+start_chain(struct dot_ctx *ctx, const struct dot_chain *chain, bool hi, nir_def **acc, nir_def **rest,
+            unsigned *terms)
+{
+   for (unsigned k = 0; k <= chain->num_addends; k++) {
+      struct hash_entry *he = _mesa_hash_table_search(ctx->sums, chain_part(chain, k).def);
+      const struct dot_sum *sum = he ? he->data : NULL;
+      if (sum && sum->terms + chain->num_terms <= MAX_TERMS && (hi || !sum->hi)) {
+         *acc = sum->fp16;
+         *rest = sum->rest;
+         *terms = sum->terms + chain->num_terms;
+         return k;
+      }
+   }
+   *acc = nir_imm_int(&ctx->b, 0);
+   *rest = NULL;
+   *terms = chain->num_terms;
+   return -1;
+}
+
+/* An SSBO, UBO or global memory load. */
+static bool
+is_buffer_load(nir_def *def)
+{
+   if (nir_def_instr(def)->type != nir_instr_type_intrinsic)
+      return false;
+   switch (nir_def_as_intrinsic(def)->intrinsic) {
+   case nir_intrinsic_load_ssbo:
+   case nir_intrinsic_load_ubo:
+   case nir_intrinsic_load_global_amd:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* A uniform value that comes from memory is loaded again where it is used. Otherwise all weights
+ * of a group would be live at once, which doesn't fit in SGPRs. The copy can't be reordered, so that
+ * CSE doesn't merge the copies of different groups again.
+ */
+static nir_scalar
+reload(struct dot_ctx *ctx, nir_scalar v)
+{
+   v = nir_scalar_chase_movs(v);
+   if (!is_buffer_load(v.def) || nir_def_block(v.def) != nir_cursor_current_block(ctx->b.cursor))
+      return v;
+
+   nir_intrinsic_instr *load = nir_def_as_intrinsic(v.def);
+   if (!nir_intrinsic_can_reorder(load))
+      return v;
+
+   struct hash_entry *he = _mesa_hash_table_search(ctx->reloads, v.def);
+   if (!he) {
+      nir_instr *clone = nir_instr_clone(ctx->b.shader, &load->instr);
+      nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(clone);
+      if (nir_intrinsic_has_access(intrin))
+         nir_intrinsic_set_access(intrin, nir_intrinsic_access(intrin) & ~ACCESS_CAN_REORDER);
+      nir_builder_instr_insert(&ctx->b, clone);
+      he = _mesa_hash_table_insert(ctx->reloads, v.def, nir_instr_def(clone));
+   }
+   return nir_get_scalar(he->data, v.comp);
+}
+
+/* A uniform weight that is a component of a vector load, which the op can read in place. */
+static bool
+tuple_weight(nir_scalar w)
+{
+   return w.def->num_components >= 3 && is_buffer_load(w.def);
+}
+
+/* Whether, for every input, the weight of chain b is two components after that of chain a in the
+ * same load.
+ */
+static bool
+tuple_pair(const struct dot_chain *a, const struct dot_chain *b)
+{
+   for (unsigned i = 0; i < a->num_terms; i++) {
+      nir_scalar wa = nir_scalar_chase_movs(a->terms[i].w);
+      nir_scalar wb = nir_scalar_chase_movs(b->terms[i].w);
+      if (!tuple_weight(wa) || wa.def != wb.def || wb.comp != wa.comp + 2)
+         return false;
+   }
+   return true;
+}
+
+static uint32_t
+const_w(const struct dot_chain *chain, unsigned i)
+{
+   return i < chain->num_terms ? nir_scalar_as_uint(chain->terms[i].w) : 0;
+}
+
+static bool
+same_weights(const struct dot_chain *a, const struct dot_chain *b)
+{
+   if (a->num_terms != b->num_terms)
+      return false;
+   for (unsigned i = 0; i < a->num_terms; i++) {
+      if (const_w(a, i) != const_w(b, i))
+         return false;
+   }
+   return true;
+}
+
+/* Rewrite a group of chains with the same inputs. With constant weights, the group can have twins:
+ * num_twins - 1 more groups of count chains each, after it in chains, whose chain k has the same
+ * weights as chain k of the group.
+ */
+static void
+emit_group(struct dot_ctx *ctx, struct dot_chain **chains, unsigned count, unsigned num_twins)
+{
+   nir_builder *b = &ctx->b;
+   const unsigned total = count * num_twins;
+   bool all_const = true;
+   for (unsigned i = 0; i < total; i++)
+      all_const &= chains[i]->const_w;
+   b->cursor = nir_after_instr(&last_chain(chains, total)->last->instr);
+
+   nir_def **acc = malloc(total * sizeof(*acc));
+   nir_def **rest = malloc(total * sizeof(*rest));
+   int *carried = malloc(total * sizeof(*carried));
+   unsigned *terms = malloc(total * sizeof(*terms));
+
+   /* With uniform weights, pair the chains that can share dot4x2t ops, lowest component first so
+    * that it gets the partner two components up.
+    */
+   bool *paired = calloc(total, sizeof(*paired));
+   unsigned *lo = NULL, *hi = NULL, *single = NULL;
+   unsigned num_pairs = 0, num_single = 0;
+   if (!all_const) {
+      lo = malloc(count * sizeof(*lo));
+      hi = malloc(count * sizeof(*hi));
+      single = malloc(count * sizeof(*single));
+      unsigned *order = malloc(count * sizeof(*order));
+      for (unsigned i = 0; i < count; i++)
+         order[i] = i;
+      for (unsigned i = 1; i < count; i++) {
+         for (unsigned k = i; k > 0 && cmp_scalar(nir_scalar_chase_movs(chains[order[k]]->terms[0].w),
+                                                  nir_scalar_chase_movs(chains[order[k - 1]]->terms[0].w)) < 0;
+              k--) {
+            unsigned t = order[k];
+            order[k] = order[k - 1];
+            order[k - 1] = t;
+         }
+      }
+      for (unsigned oi = 0; oi < count; oi++) {
+         const unsigned i = order[oi];
+         for (unsigned oj = 0; oj < count && !paired[i]; oj++) {
+            const unsigned j = order[oj];
+            if (j != i && !paired[j] && tuple_pair(chains[i], chains[j])) {
+               lo[num_pairs] = i;
+               hi[num_pairs++] = j;
+               paired[i] = paired[j] = true;
+            }
+         }
+      }
+      for (unsigned i = 0; i < count; i++) {
+         if (!paired[i])
+            single[num_single++] = i;
+      }
+      free(order);
+   }
+
+   for (unsigned i = 0; i < total; i++)
+      carried[i] = start_chain(ctx, chains[i], paired[i], &acc[i], &rest[i], &terms[i]);
+   _mesa_hash_table_clear(ctx->reloads, NULL);
+
+   /* Step through the inputs two at a time for several chains, so that dependent instructions are
+    * apart.
+    */
+   const unsigned num_terms = chains[0]->num_terms;
+   if (all_const) {
+      const unsigned num_const_pairs = DIV_ROUND_UP(count, 2);
+      nir_def **pair = malloc(num_twins * num_const_pairs * sizeof(*pair));
+      for (unsigned t = 0; t < num_twins; t++) {
+         nir_def **twin_acc = acc + t * count;
+         for (unsigned p = 0; p < num_const_pairs; p++) {
+            pair[t * num_const_pairs + p] =
+               nir_vec2(b, twin_acc[2 * p], 2 * p + 1 < count ? twin_acc[2 * p + 1] : nir_imm_int(b, 0));
+         }
+      }
+
+      for (unsigned s = 0; s < num_terms; s += 2) {
+         bool odd = s + 1 == num_terms;
+         nir_def *x0[MAX_TWINS], *x1[MAX_TWINS];
+         for (unsigned t = 0; t < num_twins; t++) {
+            x0[t] = nir_mov_scalar(b, chains[t * count]->terms[s].x);
+            x1[t] = odd ? x0[t] : nir_mov_scalar(b, chains[t * count]->terms[s + 1].x);
+         }
+
+         for (unsigned p = 0; p < num_const_pairs; p++) {
+            const struct dot_chain *ca = chains[2 * p];
+            const struct dot_chain *cb = 2 * p + 1 < count ? chains[2 * p + 1] : NULL;
+            uint32_t w[4] = {
+               const_w(ca, s),
+               odd ? 0 : const_w(ca, s + 1),
+               cb ? const_w(cb, s) : 0,
+               cb && !odd ? const_w(cb, s + 1) : 0,
+            };
+            for (unsigned t = 0; t < num_twins; t++) {
+               nir_def **twin_pair = &pair[t * num_const_pairs + p];
+               *twin_pair =
+                  nir_dot8x2_i8_viola_amd(b, *twin_pair, x0[t], x1[t], nir_imm_ivec4(b, w[0], w[1], w[2], w[3]));
+               ctx->stats.ops++;
+            }
+         }
+      }
+
+      for (unsigned i = 0; i < total; i++)
+         acc[i] = nir_channel(b, pair[(i / count) * num_const_pairs + (i % count) / 2], (i % count) % 2);
+      free(pair);
+   } else {
+      if (num_pairs) {
+         nir_def *zero = nir_imm_int(b, 0);
+         nir_def **pair = malloc(num_pairs * sizeof(*pair));
+         for (unsigned p = 0; p < num_pairs; p++)
+            pair[p] = nir_vec2(b, acc[lo[p]], acc[hi[p]]);
+
+         for (unsigned s = 0; s < num_terms; s++) {
+            nir_def *x = nir_mov_scalar(b, chains[0]->terms[s].x);
+            for (unsigned p = 0; p < num_pairs; p++) {
+               nir_scalar w = reload(ctx, chains[lo[p]]->terms[s].w);
+               if (s % 2)
+                  pair[p] = nir_dot4x2t_hi_i8_viola_amd(b, pair[p], x, zero, w.def, .base = w.comp);
+               else
+                  pair[p] = nir_dot4x2t_i8_viola_amd(b, pair[p], x, zero, w.def, .base = w.comp);
+               ctx->stats.ops++;
+            }
+         }
+
+         for (unsigned p = 0; p < num_pairs; p++) {
+            acc[lo[p]] = nir_channel(b, pair[p], 0);
+            acc[hi[p]] = nir_channel(b, pair[p], 1);
+         }
+         free(pair);
+      }
+
+      /* The other chains four at a time: enough to hide the latency of the op, and few enough that
+       * their weights fit in SGPRs. The op also writes the register after the accumulator, so the
+       * accumulators are pairs while they are in use.
+       */
+      for (unsigned t = 0; t < num_single; t += 4) {
+         const unsigned end = MIN2(t + 4, num_single);
+         for (unsigned k = t; k < end; k++)
+            acc[single[k]] = nir_vec2(b, acc[single[k]], nir_undef(b, 1, 32));
+
+         for (unsigned s = 0; s < num_terms; s += 2) {
+            bool odd = s + 1 == num_terms;
+            nir_def *x0 = nir_mov_scalar(b, chains[0]->terms[s].x);
+            nir_def *x1 = odd ? x0 : nir_mov_scalar(b, chains[0]->terms[s + 1].x);
+
+            for (unsigned k = t; k < end; k++) {
+               const unsigned i = single[k];
+               nir_scalar w[2] = {
+                  reload(ctx, chains[i]->terms[s].w),
+                  odd ? nir_get_scalar(nir_imm_int(b, 0), 0) : reload(ctx, chains[i]->terms[s + 1].w),
+               };
+               if (!odd && w[1].def == w[0].def && w[1].comp == w[0].comp + 1 && tuple_weight(w[0]))
+                  acc[i] = nir_dot4x2t_i8_viola_amd(b, acc[i], x0, x1, w[0].def, .base = w[0].comp);
+               else
+                  acc[i] = nir_dot4x2_i8_viola_amd(b, acc[i], x0, x1, nir_vec_scalars(b, w, 2));
+               ctx->stats.ops++;
+            }
+         }
+
+         for (unsigned k = t; k < end; k++)
+            acc[single[k]] = nir_channel(b, acc[single[k]], 0);
+      }
+   }
+
+   for (unsigned i = 0; i < total; i++) {
+      for (unsigned k = 0; k <= chains[i]->num_addends; k++) {
+         if ((int)k == carried[i])
+            continue;
+         nir_def *part = nir_mov_scalar(b, reload(ctx, chain_part(chains[i], k)));
+         rest[i] = rest[i] ? nir_iadd(b, rest[i], part) : part;
+      }
+
+      nir_def *sum = nir_iadd(b, rest[i], fp16_sum_to_int(b, acc[i], paired[i]));
+      struct dot_sum *info = ralloc(ctx->sums, struct dot_sum);
+      info->fp16 = acc[i];
+      info->rest = rest[i];
+      info->terms = terms[i];
+      info->hi = paired[i];
+      _mesa_hash_table_insert(ctx->sums, sum, info);
+      nir_def_rewrite_uses(&chains[i]->last->def, sum);
+   }
+   free(paired);
+   free(single);
+   free(hi);
+   free(lo);
+   free(terms);
+   free(carried);
+   free(rest);
+   free(acc);
+}
+
+/* Whether the results of all the chains are used after the last of them ends, where they are
+ * rewritten.
+ */
+static bool
+all_uses_after(struct dot_chain **chains, unsigned count)
+{
+   const unsigned end = last_chain(chains, count)->last->instr.index;
+   for (unsigned k = 0; k < count; k++) {
+      if (!uses_after(chains[k], end))
+         return false;
+   }
+   return true;
+}
+
+/* Finds a twin of group among the chains with the same inputs as chains[start]: for each chain of
+ * group, one with the same constant weights.
+ */
+static bool
+find_twin(struct dot_chain *chains, unsigned num_chains, const bool *done, unsigned start,
+          struct dot_chain **group, unsigned count, struct dot_chain **twin)
+{
+   for (unsigned k = 0; k < count; k++) {
+      twin[k] = NULL;
+      for (unsigned j = start; j < num_chains && !twin[k]; j++) {
+         if (done[j] || !chains[j].const_w || !same_weights(group[k], &chains[j]) ||
+             !same_inputs(&chains[start], &chains[j]))
+            continue;
+         bool taken = false;
+         for (unsigned m = 0; m < k; m++)
+            taken |= twin[m] == &chains[j];
+         if (!taken)
+            twin[k] = &chains[j];
+      }
+      if (!twin[k])
+         return false;
+   }
+   return true;
+}
+
+static bool
+opt_block(struct dot_ctx *ctx, nir_block *block)
+{
+   struct dot_chain *chains = NULL;
+   unsigned num_chains = 0, cap = 0;
+
+   /* pass_flags marks the terms that continue a chain, and below the adds that belong to one. */
+   nir_foreach_instr (instr, block)
+      instr->pass_flags = 0;
+   nir_foreach_instr (instr, block) {
+      struct dot_term t;
+      struct dot_addend addend;
+      if (instr->type == nir_instr_type_alu && get_term(nir_instr_as_alu(instr), &t)) {
+         nir_alu_instr *next = next_term(nir_instr_as_alu(instr), &addend);
+         if (next)
+            next->instr.pass_flags = 1;
+      }
+   }
+
+   nir_foreach_instr (instr, block) {
+      if (instr->type != nir_instr_type_alu || instr->pass_flags)
+         continue;
+
+      nir_alu_instr *alu = nir_instr_as_alu(instr);
+      struct dot_term t;
+      if (!get_term(alu, &t))
+         continue;
+
+      if (num_chains == cap) {
+         cap = MAX2(16, cap * 2);
+         chains = realloc(chains, cap * sizeof(*chains));
+      }
+      struct dot_chain *chain = &chains[num_chains];
+      chain->first = alu;
+      chain->num_terms = 0;
+      chain->num_addends = 0;
+      chain->const_w = true;
+      chain->add_at_end = false;
+
+      for (nir_alu_instr *cur = alu; cur;) {
+         struct dot_term *term = &chain->terms[chain->num_terms++];
+         get_term(cur, term);
+         chain->const_w &= nir_scalar_is_const(term->w);
+         chain->last = cur;
+
+         struct dot_addend addend;
+         nir_alu_instr *next = next_term(cur, &addend);
+         /* An add belongs to the first chain that reaches it. Where two chains meet at one, the
+          * other chain ends before it and becomes an input of the add.
+          */
+         if (next && addend.iadd && addend.iadd->instr.pass_flags)
+            break;
+         if (next && chain->num_terms == MAX_TERMS) {
+            /* The rest is another chain, which continues this one. */
+            next->instr.pass_flags = 0;
+            break;
+         }
+         cur = next;
+         if (cur && addend.iadd) {
+            addend.iadd->instr.pass_flags = 1;
+            chain->addends[chain->num_addends++] = addend;
+         }
+      }
+
+      /* An add of the result into a running sum usually follows, before the other chains end. */
+      nir_instr *use = single_use_in_block(&chain->last->def, block);
+      if (use && !use->pass_flags && use->type == nir_instr_type_alu &&
+          nir_instr_as_alu(use)->op == nir_op_iadd && nir_instr_as_alu(use)->def.num_components == 1) {
+         nir_alu_instr *iadd = nir_instr_as_alu(use);
+         unsigned src = iadd->src[0].src.ssa == &chain->last->def ? 1 : 0;
+         if (iadd->src[src].src.ssa != &chain->last->def) {
+            chain->addends[chain->num_addends++] = (struct dot_addend){iadd, src};
+            chain->last = iadd;
+            chain->add_at_end = true;
+            iadd->instr.pass_flags = 1;
+         }
+      }
+      qsort(chain->terms, chain->num_terms, sizeof(chain->terms[0]), cmp_term);
+      num_chains++;
+   }
+
+   bool progress = false;
+   bool *done = calloc(num_chains, sizeof(bool));
+   struct dot_chain **group = malloc(MAX2(num_chains, 1) * sizeof(*group));
+
+   for (unsigned i = 0; i < num_chains; i++) {
+      while (!done[i]) {
+         unsigned count = 0;
+         for (unsigned j = i; j < num_chains; j++) {
+            if (!done[j] && same_inputs(&chains[i], &chains[j])) {
+               group[count++] = &chains[j];
+               done[j] = true;
+            }
+         }
+
+         /* Leave chains whose result is used before the end of the group for a later group, until
+          * stable. A single chain always fits. If the group ends at an add after a chain, that
+          * chain first ends at its last term instead: each chain's add can be followed by a use, as
+          * in a running sum per output, which would otherwise split the group into single chains.
+          */
+         bool changed = true;
+         while (changed && count) {
+            changed = false;
+            struct dot_chain *last = last_chain(group, count);
+            for (unsigned k = 0; k < count; k++) {
+               if (!uses_after(group[k], last->last->instr.index)) {
+                  if (last->add_at_end) {
+                     drop_add_at_end(last);
+                  } else {
+                     done[group[k] - chains] = false;
+                     group[k] = group[--count];
+                  }
+                  changed = true;
+                  break;
+               }
+            }
+         }
+         if (!count)
+            break;
+
+         /* Groups with the same constant weights, rewritten with this one. */
+         unsigned num_twins = 1;
+         bool all_const = true;
+         for (unsigned k = 0; k < count; k++)
+            all_const &= group[k]->const_w;
+         for (unsigned j = i + 1; all_const && j < num_chains && num_twins < MAX_TWINS &&
+                                  (num_twins + 1) * count <= MIN2(num_chains, MAX_TWIN_CHAINS);
+              j++) {
+            struct dot_chain **twin = group + num_twins * count;
+            if (done[j] || !chains[j].const_w || !same_weights(group[0], &chains[j]) ||
+                !find_twin(chains, num_chains, done, j, group, count, twin) ||
+                !all_uses_after(group, (num_twins + 1) * count))
+               continue;
+            for (unsigned k = 0; k < count; k++)
+               done[twin[k] - chains] = true;
+            num_twins++;
+         }
+
+         emit_group(ctx, group, count, num_twins);
+         ctx->stats.chains += count * num_twins;
+         progress = true;
+
+         /* For uses_after() of the next groups. */
+         nir_index_instrs(ctx->b.impl);
+      }
+   }
+
+   free(group);
+   free(done);
+   free(chains);
+   return progress;
+}
+
+static bool
+is_alu_op(nir_scalar s, nir_op op)
+{
+   return nir_scalar_is_alu(s) && nir_scalar_alu_op(s) == op;
+}
+
+static bool
+is_const_val(nir_scalar s, uint32_t v)
+{
+   return nir_scalar_is_const(s) && nir_scalar_as_uint(s) == v;
+}
+
+/* (x >> s) & 1, as ubfe or as a shift and an and. */
+static bool
+match_bit(nir_scalar odd, unsigned s, nir_scalar *x)
+{
+   if (is_alu_op(odd, nir_op_ubfe)) {
+      if (!is_const_val(nir_scalar_chase_alu_src(odd, 1), s) || !is_const_val(nir_scalar_chase_alu_src(odd, 2), 1))
+         return false;
+      *x = nir_scalar_chase_alu_src(odd, 0);
+      return true;
+   }
+   if (!is_alu_op(odd, nir_op_iand))
+      return false;
+   for (unsigned i = 0; i < 2; i++) {
+      nir_scalar sh = nir_scalar_chase_alu_src(odd, !i);
+      if (is_const_val(nir_scalar_chase_alu_src(odd, i), 1) &&
+          (is_alu_op(sh, nir_op_ishr) || is_alu_op(sh, nir_op_ushr)) &&
+          is_const_val(nir_scalar_chase_alu_src(sh, 1), s)) {
+         *x = nir_scalar_chase_alu_src(sh, 0);
+         return true;
+      }
+   }
+   return false;
+}
+
+/* (x + (1 << (s - 1)) - 1 + ((x >> s) & 1)) >> s, which is x / 2^s rounded to even. */
+static bool
+match_rne_shift(nir_scalar q, nir_scalar *x, unsigned *shift)
+{
+   q = nir_scalar_chase_movs(q);
+   if (!is_alu_op(q, nir_op_ishr) || !nir_scalar_is_const(nir_scalar_chase_alu_src(q, 1)))
+      return false;
+   unsigned s = nir_scalar_as_uint(nir_scalar_chase_alu_src(q, 1)) & 31;
+   nir_scalar t = nir_scalar_chase_alu_src(q, 0);
+   if (s == 0 || s > 14 || !is_alu_op(t, nir_op_iadd))
+      return false;
+
+   for (unsigned i = 0; i < 2; i++) {
+      nir_scalar round = nir_scalar_chase_alu_src(t, i), odd = nir_scalar_chase_alu_src(t, !i);
+      nir_scalar v;
+      if (!is_alu_op(round, nir_op_iadd) || !match_bit(odd, s, &v))
+         continue;
+      for (unsigned j = 0; j < 2; j++) {
+         if (is_const_val(nir_scalar_chase_alu_src(round, !j), (1u << (s - 1)) - 1) &&
+             nir_scalar_equal(nir_scalar_chase_alu_src(round, j), v)) {
+            *x = v;
+            *shift = s;
+            return true;
+         }
+      }
+   }
+   return false;
+}
+
+/* The input of a requantization: one or two sums of this pass and possibly another int32 value. */
+struct requant {
+   const struct dot_sum *sum[2];
+   nir_scalar extra; /* extra.def is NULL without one */
+   unsigned shift;
+   bool relu;
+};
+
+/* The sum of this pass that s is, if any. */
+static const struct dot_sum *
+find_sum(struct dot_ctx *ctx, nir_scalar s)
+{
+   struct hash_entry *he = _mesa_hash_table_search(ctx->sums, s.def);
+   return he && s.comp == 0 ? he->data : NULL;
+}
+
+/* u2u8 or i2i8 of clamp(rne(x, s) or x, -128 or 0, 127), with x a sum of this pass, the sum of one
+ * and another value (which can be a second sum), or max of one of those and 0.
+ */
+static bool
+match_requant(struct dot_ctx *ctx, nir_scalar byte, struct requant *r)
+{
+   byte = nir_scalar_chase_movs(byte);
+   if (!is_alu_op(byte, nir_op_u2u8) && !is_alu_op(byte, nir_op_i2i8))
+      return false;
+
+   /* imin(imax(q, -128 or 0), 127) in either order. */
+   nir_scalar q = nir_scalar_chase_alu_src(byte, 0);
+   bool lo = false, hi = false;
+   r->relu = false;
+   for (unsigned n = 0; n < 2; n++) {
+      bool max = is_alu_op(q, nir_op_imax);
+      if (!max && !is_alu_op(q, nir_op_imin))
+         return false;
+      unsigned i;
+      for (i = 0; i < 2; i++) {
+         nir_scalar c = nir_scalar_chase_alu_src(q, i);
+         if (max && (is_const_val(c, 0xffffff80) || is_const_val(c, 0))) {
+            lo = true;
+            r->relu |= is_const_val(c, 0);
+            break;
+         }
+         if (!max && is_const_val(c, 127)) {
+            hi = true;
+            break;
+         }
+      }
+      if (i == 2)
+         return false;
+      q = nir_scalar_chase_alu_src(q, !i);
+   }
+   if (!lo || !hi)
+      return false;
+
+   nir_scalar x;
+   if (!match_rne_shift(q, &x, &r->shift)) {
+      x = q;
+      r->shift = 0;
+   }
+   if (is_alu_op(x, nir_op_imax)) {
+      for (unsigned i = 0; i < 2; i++) {
+         if (is_const_val(nir_scalar_chase_alu_src(x, i), 0)) {
+            x = nir_scalar_chase_alu_src(x, !i);
+            r->relu = true;
+            break;
+         }
+      }
+   }
+
+   r->sum[1] = NULL;
+   r->extra.def = NULL;
+   r->sum[0] = find_sum(ctx, x);
+   if (r->sum[0])
+      return true;
+   if (!is_alu_op(x, nir_op_iadd))
+      return false;
+   for (unsigned i = 0; i < 2; i++) {
+      r->sum[0] = find_sum(ctx, nir_scalar_chase_alu_src(x, i));
+      if (r->sum[0]) {
+         nir_scalar other = nir_scalar_chase_alu_src(x, !i);
+         r->sum[1] = find_sum(ctx, other);
+         if (!r->sum[1])
+            r->extra = other;
+         return true;
+      }
+   }
+   return false;
+}
+
+/* fp16 sum * scale + bias in float. */
+static nir_def *
+sum_to_float(nir_builder *b, const struct dot_sum *sum, double scale, nir_def *bias)
+{
+   nir_def *v = nir_ffma(b, nir_f2f32(b, nir_unpack_32_2x16_split_x(b, sum->fp16)), nir_imm_float(b, scale), bias);
+   if (sum->hi)
+      v = nir_ffma(b, nir_f2f32(b, nir_unpack_32_2x16_split_y(b, sum->fp16)), nir_imm_float(b, scale), v);
+   return v;
+}
+
+/* (fp16 sums * 2^14 + rest) / 2^s + 0.5 in fp16, which the quantize op rounds down. An fp16 sum
+ * (at most MAX_TERMS terms) is below 2^22, so with a shift of 8 or more the value stays in the
+ * fp16 range unless the int32 part is very large. With a smaller shift it can exceed the range,
+ * and the op turns -inf into -128 even with ReLU, so it is clamped first.
+ */
+static nir_def *
+requant_input(nir_builder *b, const struct requant *r)
+{
+   const unsigned s = r->shift;
+   nir_def *rest = r->sum[0]->rest;
+   if (r->sum[1])
+      rest = nir_iadd(b, rest, r->sum[1]->rest);
+   if (r->extra.def)
+      rest = nir_iadd(b, rest, nir_mov_scalar(b, r->extra));
+   nir_def *v = nir_fadd_imm(b, nir_fmul_imm(b, nir_i2f32(b, rest), 1.0 / (1u << s)), 0.5);
+   for (unsigned i = 0; i < 2 && r->sum[i]; i++)
+      v = sum_to_float(b, r->sum[i], 16384.0 / (1u << s), v);
+   if (s < 8)
+      v = nir_fmin(b, nir_fmax(b, v, nir_imm_float(b, -256.0)), nir_imm_float(b, 256.0));
+   return nir_f2f16_rtne(b, v);
+}
+
+/* i2f32 of a sum of this pass: fp16 sum * 2^14 + rest in float. */
+static bool
+fuse_i2f(nir_builder *b, nir_alu_instr *cvt, struct dot_ctx *ctx)
+{
+   if (cvt->op != nir_op_i2f32 || cvt->def.num_components != 1)
+      return false;
+   const struct dot_sum *sum = find_sum(ctx, nir_get_scalar(cvt->src[0].src.ssa, cvt->src[0].swizzle[0]));
+   if (!sum)
+      return false;
+
+   b->cursor = nir_before_instr(&cvt->instr);
+   nir_def_replace(&cvt->def, sum_to_float(b, sum, 16384.0, nir_i2f32(b, sum->rest)));
+   return true;
+}
+
+static bool
+fuse_requant(nir_builder *b, nir_alu_instr *pack, struct dot_ctx *ctx)
+{
+   if (fuse_i2f(b, pack, ctx))
+      return true;
+   if (pack->op != nir_op_pack_32_4x8)
+      return false;
+
+   struct requant r[4];
+   for (unsigned i = 0; i < 4; i++) {
+      nir_scalar byte = nir_get_scalar(pack->src[0].src.ssa, pack->src[0].swizzle[i]);
+      if (!match_requant(ctx, byte, &r[i]) || r[i].shift != r[0].shift || r[i].relu != r[0].relu)
+         return false;
+   }
+
+   b->cursor = nir_before_instr(&pack->instr);
+   nir_def *in[4];
+   for (unsigned i = 0; i < 4; i++)
+      in[i] = requant_input(b, &r[i]);
+   nir_def *q = nir_quant8x4_viola_amd(b, nir_pack_32_2x16_split(b, in[0], in[1]),
+                                     nir_pack_32_2x16_split(b, in[2], in[3]), .base = r[0].relu << 4);
+   nir_def_replace(&pack->def, q);
+   ctx->stats.quant++;
+   return true;
+}
+
+static bool
+is_store(nir_instr *instr)
+{
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+   switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+   case nir_intrinsic_store_ssbo:
+   case nir_intrinsic_store_global:
+   case nir_intrinsic_store_global_amd:
+   case nir_intrinsic_store_buffer_amd:
+   case nir_intrinsic_image_store:
+   case nir_intrinsic_image_deref_store:
+   case nir_intrinsic_bindless_image_store:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* The stores of quantize results would end up between the quantize ops. Keeping them together after
+ * the last one is about 6% faster in a 1x1 layer limited by memory and 0.2% slower in a 3x3 layer
+ * limited by arithmetic. Move the stores before the last quantize op of a block below it, in their
+ * order, as long as only arithmetic and reorderable intrinsics are in between.
+ */
+static void
+move_stores_after_quantize(nir_block *block)
+{
+   nir_instr *last = NULL;
+   nir_foreach_instr_reverse (instr, block) {
+      if (instr->type == nir_instr_type_intrinsic &&
+          nir_instr_as_intrinsic(instr)->intrinsic == nir_intrinsic_quant8x4_viola_amd) {
+         last = instr;
+         break;
+      }
+   }
+   if (!last)
+      return;
+
+   nir_cursor cursor = nir_after_instr(last);
+   for (nir_instr *instr = nir_instr_prev(last), *prev; instr; instr = prev) {
+      prev = nir_instr_prev(instr);
+      if (is_store(instr)) {
+         nir_instr_move(cursor, instr);
+         cursor = nir_before_instr(instr);
+      } else if (instr->type == nir_instr_type_intrinsic) {
+         if (!nir_intrinsic_can_reorder(nir_instr_as_intrinsic(instr)))
+            break;
+      } else if (instr->type != nir_instr_type_alu && instr->type != nir_instr_type_load_const &&
+                 instr->type != nir_instr_type_undef) {
+         break;
+      }
+   }
+}
+
+static nir_def *
+lower_sdot(nir_builder *b, nir_alu_instr *alu)
+{
+   nir_def *a = nir_ssa_for_alu_src(b, alu, 0);
+   nir_def *c = nir_ssa_for_alu_src(b, alu, 1);
+   nir_def *acc = nir_ssa_for_alu_src(b, alu, 2);
+   bool sat = alu->op == nir_op_sdot_4x8_iadd_sat;
+
+   /* Add each product to the running sum so that ACO can use v_mad_i32_i24 for all four. */
+   nir_def *sum = sat ? NULL : acc;
+   for (unsigned i = 0; i < 4; i++) {
+      nir_def *prod = nir_imul24_relaxed(b, nir_extract_i8_imm(b, a, i), nir_extract_i8_imm(b, c, i));
+      sum = sum ? nir_iadd(b, sum, prod) : prod;
+   }
+   return sat ? nir_iadd_sat(b, sum, acc) : sum;
+}
+
+static bool
+lower_remaining(nir_builder *b, nir_instr *instr, void *data)
+{
+   struct dot_stats *stats = data;
+   if (instr->type != nir_instr_type_alu)
+      return false;
+
+   nir_alu_instr *alu = nir_instr_as_alu(instr);
+   if (alu->op != nir_op_sdot_4x8_iadd && alu->op != nir_op_sdot_4x8_iadd_sat)
+      return false;
+
+   b->cursor = nir_before_instr(instr);
+   nir_def_replace(&alu->def, lower_sdot(b, alu));
+   stats->lowered++;
+   return true;
+}
+
+bool
+radv_nir_opt_viola_int8_dot(nir_shader *shader, bool use_ml, bool *has_ml_ops)
+{
+   struct dot_ctx ctx = {0};
+   bool progress = false;
+
+   if (use_ml) {
+      ctx.sums = _mesa_pointer_hash_table_create(NULL);
+      ctx.reloads = _mesa_pointer_hash_table_create(NULL);
+
+      nir_foreach_function_impl (impl, shader) {
+         nir_metadata_require(impl, nir_metadata_instr_index | nir_metadata_divergence);
+         ctx.b = nir_builder_create(impl);
+         bool impl_progress = false;
+
+         nir_foreach_block (block, impl)
+            impl_progress |= opt_block(&ctx, block);
+
+         if (impl_progress) {
+            nir_foreach_block (block, impl) {
+               nir_foreach_instr_safe (instr, block) {
+                  if (instr->type == nir_instr_type_alu)
+                     fuse_requant(&ctx.b, nir_instr_as_alu(instr), &ctx);
+               }
+               move_stores_after_quantize(block);
+            }
+         }
+
+         progress |= nir_progress(impl_progress, impl, nir_metadata_control_flow);
+      }
+      ralloc_free(ctx.sums);
+      ralloc_free(ctx.reloads);
+
+      if (progress)
+         NIR_PASS(_, shader, nir_opt_dce);
+   }
+
+   progress |= nir_shader_instructions_pass(shader, lower_remaining, nir_metadata_control_flow, &ctx.stats);
+
+   if (progress && debug_get_bool_option("RADV_VIOLA_ML_DEBUG", false))
+      fprintf(stderr, "radv viola int8: %s: %u dot chains -> %u int8 matrix ops, %u dot4 emulated, %u quantize ops\n",
+              _mesa_shader_stage_to_abbrev(shader->info.stage), ctx.stats.chains, ctx.stats.ops,
+              ctx.stats.lowered, ctx.stats.quant);
+   *has_ml_ops = ctx.stats.ops > 0;
+   return progress;
+}
