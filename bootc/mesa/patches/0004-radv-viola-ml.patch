+/* Viola ops 0x23 and 0x24, encoding class 111001:
+ *   dword0: op[25:19] | literal[18] | pair[17] | sgpr[15:8] | vdst[7:0]
+ *   dword1: s0[7:0] | s1[15:8] | accumulator[23:16] | second vdst[31:24]
+ *   dword2: literal (weights for s1 into the second destination); without the literal bit there
+ *           is no dword2 and these weights are zero
+ * The pair bit stays 0: a set pair bit must be followed by a second op of this class.
+ */
+void
+emit_dot8x2_i8_viola(asm_context& ctx, std::vector<uint32_t>& out, const Instruction* instr)
+{
+   bool literal = instr->opcode == aco_opcode::p_dot8x2_i8_viola;
+   uint32_t vdst = reg(ctx, instr->definitions[0], 8);
+   uint32_t acc = reg(ctx, instr->operands[2], 8);
+   assert(acc == vdst);
+
+   /* The weights can start at an offset into a larger tuple: operand 5 of p_dot8x2, or bits 7:0 of
+    * operand 4 of p_dot4x2, whose bit 8 selects the high halves (op 0x24).
+    */
+   uint32_t sgpr = reg(ctx, instr->operands[3], 8), op = 0x23;
+   if (literal) {
+      sgpr += instr->operands[5].constantValue();
+   } else if (instr->operands.size() > 4) {
+      sgpr += instr->operands[4].constantValue() & 0xff;
+      op += (instr->operands[4].constantValue() >> 8) & 1;
+   }
+   out.push_back(0xe4000000u | (op << 19) | (literal << 18) | (sgpr << 8) | vdst);
+   out.push_back(reg(ctx, instr->operands[0], 8) | (reg(ctx, instr->operands[1], 8) << 8) |
+                 (acc << 16) | (((vdst + 1) & 0xff) << 24));
+   if (literal)
+      out.push_back(instr->operands[4].constantValue());
+}
+
+/* Viola quantize op 0x28 in the same class, with the literal and no SGPR operand. Its
+ * accumulator and second destination fields are unused.
+ */
+void
+emit_quant8x4_viola(asm_context& ctx, std::vector<uint32_t>& out, const Instruction* instr)
+{
+   out.push_back(0xe4000000u | (0x28u << 19) | (1u << 18) | (0x7du << 8) | reg(ctx, instr->definitions[0], 8));
+   out.push_back(reg(ctx, instr->operands[0], 8) | (reg(ctx, instr->operands[1], 8) << 8));
+   out.push_back(instr->operands[2].constantValue() << 8);
+}
