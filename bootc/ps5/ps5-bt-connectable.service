[Unit]
Description=Bluetooth adapter accepts incoming connections (controllers reconnect by themselves)
After=bluetooth.service ps5-bt-addr.service ps5-bt-pro-addr.service

[Service]
Type=oneshot
# bluetoothd sets the adapter's modes when it starts: wait for it, then switch "connectable" on
ExecStart=/bin/sh -c 'for i in $(seq 30); do systemctl is-active -q bluetooth.service && break; sleep 1; done; sleep 3; for h in /sys/class/bluetooth/hci*; do /usr/bin/btmgmt --index $${h##*hci} connectable on; done'

[Install]
WantedBy=bluetooth.target
