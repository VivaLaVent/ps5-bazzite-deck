[Unit]
Description=Reboot: warm reboot into Linux when a kernel is loaded, normal reboot otherwise
DefaultDependencies=no
Requires=shutdown.target umount.target final.target
After=shutdown.target umount.target final.target
# The reboot itself is done by systemd (PID 1), not by systemctl: at this point D-Bus is gone
# ("Transport endpoint is not connected" in v1.4.0). kexec when ps5-kexec-prepare loaded a
# kernel, a normal reboot otherwise.
SuccessAction=kexec-force
FailureAction=reboot-force

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'test "$(cat /sys/kernel/kexec_loaded 2>/dev/null)" = 1'
