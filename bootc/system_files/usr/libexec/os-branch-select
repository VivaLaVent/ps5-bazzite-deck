#!/usr/bin/bash
# Steam's OS update channel: Stable (:stable) and Beta (:beta) of this image. Replaces Bazzite's script, which rebases
# to Bazzite's own images; those have no PS5 kernel and wouldn't start.
set -e
IMG=ghcr.io/vivalavent/ps5-bazzite-bootc

current() {
    local ref
    ref=$(bootc status --format=json 2>/dev/null | jq -r '.spec.image.image // .status.booted.image.image.image // empty')
    [ "${ref##*:}" = beta ] && echo beta || echo rel   # a release tag such as v2.5 counts as Stable
}

case "${1-}" in
    -c) current ;;
    -l) echo rel; echo beta ;;
    rel|latest|stable) runcon system_u:unconfined_r:unconfined_t:s0 bootc switch "$IMG:stable" ;;
    beta|rc|testing) runcon system_u:unconfined_r:unconfined_t:s0 bootc switch "$IMG:beta" ;;
    *) echo "Usage: steamos-select-branch <stable|beta>" >&2; exit 1 ;;
esac
