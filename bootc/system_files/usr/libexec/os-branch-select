#!/usr/bin/bash
# Steam's OS Update Channel: Stable (:stable, the stable release's kernel) and Beta (:beta, the newest pre-release's
# kernel), both of this image. Every other channel Steam may offer maps to Beta.
set -e
IMG=ghcr.io/vivalavent/ps5-bazzite-bootc

current() {
    local ref
    ref=$(bootc status --format=json 2>/dev/null | jq -r '.spec.image.image // .status.booted.image.image.image // empty')
    [ "${ref##*:}" = beta ] && echo beta || echo rel
}
switch() { runcon system_u:unconfined_r:unconfined_t:s0 bootc switch "$IMG:$1"; }

case "${1-}" in
    -c) current ;;
    -l) echo rel; echo beta ;;
    rel|latest|stable) switch stable ;;
    rc|beta|bc|main|testing|unstable|prerelease|preview) switch beta ;;
    *) echo "Usage: steamos-select-branch <stable|beta>" >&2; exit 1 ;;
esac
