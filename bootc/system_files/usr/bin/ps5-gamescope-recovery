#!/bin/bash
# First boot: fall back to Plasma if neither the desktop nor gamescope has a display after 60 s (from ps5-linux-image)
for _ in $(seq 1 60); do
    sleep 1
    pgrep -x gamescope >/dev/null || pgrep -x plasmashell >/dev/null && exit 0
done
logger -t ps5-gamescope-recovery "no session started within 60s, switching to plasma"
runuser -u ps5 -- steamos-session-select plasma 2>/dev/null \
    || sed -i 's/^Session=.*/Session=plasma/' /etc/sddm.conf.d/autologin.conf
systemctl restart sddm
