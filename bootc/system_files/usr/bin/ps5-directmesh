#!/bin/sh
# DirectMesh: the second RADV, with Mesh shaders, for the original PS5 and Slim. From v3.0 it is the Vulkan driver of
# the whole session there (gamescope, Steam, games), set at login by a user environment generator.
#   ps5-directmesh on | off | status      the default for the session (applies from the next restart)
#   ps5-directmesh %command%              this program on DirectMesh, also with the default off
#   ps5-directmesh --system %command%     this program on the system driver
# 32-bit programs keep the system driver. On a PS5 Pro, whose GPU DirectMesh doesn't cover, nothing changes.
ICD=/usr/share/directmesh/icd.d/radeon_icd.x86_64.json
OFF=/etc/ps5-bazzite-deck/directmesh-off
usable() { [ -f "$ICD" ] && grep -qsiE '^0x13(fb|db)$' /sys/bus/pci/devices/0000:20:00.0/device; }
case "$1" in
    on)     sudo rm -f "$OFF" && echo "DirectMesh on for the whole session: restart to apply"; exit ;;
    off)    sudo mkdir -p "${OFF%/*}" && sudo touch "$OFF" && echo "DirectMesh off, the system driver everywhere: restart to apply"; exit ;;
    status) if ! usable; then echo "DirectMesh: not used (not an original PS5 or Slim, or not in this image)"
            elif [ -e "$OFF" ]; then echo "DirectMesh: off (ps5-directmesh on)"
            else echo "DirectMesh: on for the whole session (ps5-directmesh off)"; fi; exit ;;
    --system) shift; unset VK_DRIVER_FILES; [ $# -gt 0 ] || exit 0; exec "$@" ;;
esac
[ $# -gt 0 ] || { echo "usage: ps5-directmesh on|off|status, or as a launch option: ps5-directmesh [--system] %command%"; exit 1; }
if usable; then
    export VK_DRIVER_FILES="$ICD:/usr/share/vulkan/icd.d/radeon_icd.i686.json"
else
    echo "ps5-directmesh: not an original PS5 or Slim, or DirectMesh isn't in this image: system driver" >&2
fi
exec "$@"
