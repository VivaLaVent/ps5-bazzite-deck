+ */
+static DEFINE_MUTEX(ps5_busy_lock);
+static ktime_t ps5_busy_last_t;
+static u64 ps5_busy_last_ns;
+static int ps5_busy_pct;
+
+static ssize_t ps5_gpu_busy_percent_show(struct device *d, struct device_attribute *attr,
+					 char *buf)
+{
+	ktime_t now = ktime_get();
+	int pct;
+
+	mutex_lock(&ps5_busy_lock);
+	if (!ps5_busy_last_t || ktime_ms_delta(now, ps5_busy_last_t) >= 500) {
+		/* GFX busy time from amdgpu's fdinfo accounting */
+		u64 busy = ktime_to_ns(amdgpu_ps5_get_gfx_busy_ns(to_pci_dev(d)));
+
+		if (ps5_busy_last_t) {
+			s64 dt = ktime_to_ns(ktime_sub(now, ps5_busy_last_t));
+			u64 db = busy > ps5_busy_last_ns ? busy - ps5_busy_last_ns : 0;
+
+			ps5_busy_pct = dt > 0 ? (int)min_t(u64, div64_u64(db * 100, dt), 100) : 0;
+		}
+		ps5_busy_last_t = now;
+		ps5_busy_last_ns = busy;
+	}
+	pct = ps5_busy_pct;
+	mutex_unlock(&ps5_busy_lock);
+
+	return sysfs_emit(buf, "%d\n", pct);
+}
+static struct device_attribute ps5_dev_attr_gpu_busy =
+	__ATTR(gpu_busy_percent, 0444, ps5_gpu_busy_percent_show, NULL);
+
+/* No SMU sensors here either: report the die's one sensor (Tctl, as k10temp) as GPU edge temperature. */
+
+static umode_t ps5_hwmon_is_visible(const void *data, enum hwmon_sensor_types type,
+				    u32 attr, int channel)
+{
+	return type == hwmon_temp && (attr == hwmon_temp_input || attr == hwmon_temp_label) ?
+	       0444 : 0;
+}
+
+static int ps5_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
+			  u32 attr, int channel, long *val)
+{
+	int t, ret;
+
+	if (type != hwmon_temp || attr != hwmon_temp_input)
+		return -EOPNOTSUPP;
+	ret = ps5_soc_temp(&t);
+	if (!ret)
+		*val = t;
+	return ret;
+}
+
+static int ps5_hwmon_read_string(struct device *dev, enum hwmon_sensor_types type,
+				 u32 attr, int channel, const char **str)
+{
+	*str = "edge";
+	return 0;
+}
+
+static const struct hwmon_channel_info * const ps5_hwmon_info[] = {
+	HWMON_CHANNEL_INFO(temp, HWMON_T_INPUT | HWMON_T_LABEL),
+	NULL
+};
+
+static const struct hwmon_ops ps5_hwmon_ops = {
+	.is_visible = ps5_hwmon_is_visible,
+	.read = ps5_hwmon_read,
+	.read_string = ps5_hwmon_read_string,
+};
+
