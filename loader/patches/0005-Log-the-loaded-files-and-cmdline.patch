From 2aef71d3ad2f0f3bb66c50f9929e42c160fd0b87 Mon Sep 17 00:00:00 2001
From: Gilles <62951130+VivaLaVent@users.noreply.github.com>
Date: Tue, 3 Nov 2026 17:15:16 +0100
Subject: [PATCH 5/8] Log the loaded files and cmdline

Print the BLS entry, the resolved kernel and initrd paths with their sizes, and the full cmdline, so a bug report shows which deployment was booted.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 source/loader.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/source/loader.c b/source/loader.c
index 3ffee8b..3f8cc44 100644
--- a/source/loader.c
+++ b/source/loader.c
@@ -256,6 +256,12 @@ int fetch_linux(struct linux_info *info) {
     trim_newline(cmdline);
   }
 
+  if (bls)
+    printf("BLS entry %sloader/entries/%s\n", bls_root, entry.id);
+  printf("Kernel %s (%ld bytes)\n", bzimage_path, bzimage_size);
+  printf("Initrd %s (%ld bytes)\n", initrd_path, initrd_size);
+  printf("Cmdline %s\n", cmdline);
+
   info->linux_info = kernel_cave_linux_info;
   info->bzimage = kernel_cave_bzImage;
   info->bzimage_size = bzimage_size;
-- 
