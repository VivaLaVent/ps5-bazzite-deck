 #endif
diff --git a/source/bls.c b/source/bls.c
index 601f698..94486bf 100644
--- a/source/bls.c
+++ b/source/bls.c
@@ -112,7 +112,53 @@ static int set_field(char *dst, size_t size, const char *value) {
   return 0;
 }
 
+static int has_conf_suffix(const char *name) {
+  size_t len = strlen(name);
+  return len > 5 && !strcmp(name + len - 5, ".conf");
+}
+
+struct counter {
+  size_t start;
+  unsigned long left, done;
+  int left_width, done_width;
+};
+
+// Finds the "+LEFT[-DONE]" boot counter right before ".conf".
+static int find_counter(const char *id, struct counter *c) {
+  if (!has_conf_suffix(id))
+    return 0;
+  size_t end = strlen(id) - 5, digits = end;
+  while (digits > 0 && is_digit(id[digits - 1]))
+    digits--;
+  if (digits == end || digits == 0)
+    return 0;
+
+  memset(c, 0, sizeof(*c));
+  if (id[digits - 1] == '+') {
+    c->start = digits - 1;
+    c->left_width = end - digits;
+  } else if (id[digits - 1] == '-') {
+    size_t left = digits - 1;
+    while (left > 0 && is_digit(id[left - 1]))
+      left--;
+    if (left == digits - 1 || left == 0 || id[left - 1] != '+')
+      return 0;
+    c->start = left - 1;
+    c->left_width = digits - 1 - left;
+    c->done_width = end - digits;
+    c->done = strtoul(id + digits, NULL, 10);
+  } else {
+    return 0;
+  }
+  // Nine digits keep both counters within int range.
+  if (c->left_width > 9 || c->done_width > 9)
+    return 0;
+  c->left = strtoul(id + c->start + 1, NULL, 10);
+  return 1;
+}
+
 int bls_parse_entry(const char *id, char *text, struct bls_entry *e) {
+  struct counter c;
   char *key, *value;
   int initrds = 0;
 
@@ -121,6 +167,7 @@ int bls_parse_entry(const char *id, char *text, struct bls_entry *e) {
     printf("BLS entry %s: file name too long\n", id);
     return -1;
   }
+  e->tries_left = find_counter(id, &c) ? (int)c.left : -1;
 
   while (next_key(&text, &key, &value)) {
     int r = 0;
@@ -160,14 +207,12 @@ int bls_parse_entry(const char *id, char *text, struct bls_entry *e) {
   return 0;
 }
 
-static int has_conf_suffix(const char *name) {
-  size_t len = strlen(name);
-  return len > 5 && !strcmp(name + len - 5, ".conf");
-}
-
-static void strip_conf_suffix(char *dst, const char *id) {
+static void entry_name(char *dst, const char *id) {
+  struct counter c;
   size_t len = strlen(id);
-  if (has_conf_suffix(id))
+  if (find_counter(id, &c))
+    len = c.start;
+  else if (has_conf_suffix(id))
     len -= 5;
   memcpy(dst, id, len);
   dst[len] = '\0';
@@ -188,8 +233,8 @@ int bls_compare(const struct bls_entry *a, const struct bls_entry *b) {
     return a->sort_key[0] ? -1 : 1;
   }
 
-  strip_conf_suffix(name_a, a->id);
-  strip_conf_suffix(name_b, b->id);
+  entry_name(name_a, a->id);
+  entry_name(name_b, b->id);
   return bls_vercmp(name_b, name_a);
 }
 
@@ -223,11 +268,12 @@ static int read_default(const char *root, char *pattern, size_t size) {
 }
 
 static int matches_default(const char *pattern, const char *id) {
-  char name[256];
+  char name[256 + 5];
 
-  if (fnmatch(pattern, id, 0) == 0)
+  entry_name(name, id);
+  if (fnmatch(pattern, name, 0) == 0)
     return 1;
-  strip_conf_suffix(name, id);
+  strcat(name, ".conf");
   return fnmatch(pattern, name, 0) == 0;
 }
 
@@ -264,8 +310,13 @@ int bls_select(const char *root, struct bls_entry *out) {
       printf("BLS entry %s: could not read\n", de->d_name);
       continue;
     }
-    if (bls_parse_entry(de->d_name, text, &entries[n]) == 0)
-      n++;
+    if (bls_parse_entry(de->d_name, text, &entries[n]) < 0)
+      continue;
+    if (entries[n].tries_left == 0) {
+      printf("BLS entry %s: no boot tries left, skipped\n", de->d_name);
+      continue;
+    }
+    n++;
   }
   closedir(dir);
 
@@ -288,3 +339,31 @@ int bls_select(const char *root, struct bls_entry *out) {
   free(entries);
   return 1;
 }
+
+// Renames +LEFT-DONE to +(LEFT-1)-(DONE+1), keeping the digit widths.
+int bls_count_boot(const char *root, struct bls_entry *e) {
+  char id[sizeof(e->id)], from[512], to[512];
+  struct counter c;
+
+  if (!find_counter(e->id, &c))
+    return 0;
+
+  int done_width = c.done_width ? c.done_width : 1;
+  unsigned long done_max = 9;
+  for (int i = 1; i < done_width; i++)
+    done_max = done_max * 10 + 9;
+  unsigned long done = c.done < done_max ? c.done + 1 : done_max;
+
+  int ret = snprintf(id, sizeof(id), "%.*s+%0*lu-%0*lu.conf", (int)c.start,
+                     e->id, c.left_width, c.left - 1, done_width, done);
+  if (ret < 0 || (size_t)ret >= sizeof(id))
+    return -1;
+  snprintf(from, sizeof(from), "%sloader/entries/%s", root, e->id);
+  snprintf(to, sizeof(to), "%sloader/entries/%s", root, id);
+  if (rename(from, to) != 0)
+    return -1;
+
+  strcpy(e->id, id);
+  e->tries_left--;
+  return 0;
+}
