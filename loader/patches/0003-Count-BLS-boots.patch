@@ -100,6 +104,20 @@ static void test_parse(void) {
   snprintf(text, sizeof(text), "linux /a\ninitrd /b\noptions %s\n", opts);
   CHECK(bls_parse_entry("maxopts.conf", text, &e) == 0);
   CHECK(strlen(e.options) == 2047);
+
+  static const struct {
+    const char *id;
+    int tries_left;
+  } counters[] = {
+      {"a.conf", -1},     {"a+3.conf", 3},   {"a+3-1.conf", 3},
+      {"a+03-0.conf", 3}, {"a+0-5.conf", 0}, {"a-3.conf", -1},
+      {"a+-3.conf", -1},  {"a+3-.conf", -1}, {"a-1+2.conf", 2},
+  };
+  for (size_t i = 0; i < sizeof(counters) / sizeof(counters[0]); i++) {
+    strcpy(text, "linux /a\ninitrd /b\n");
+    CHECK(bls_parse_entry(counters[i].id, text, &e) == 0);
+    CHECK(e.tries_left == counters[i].tries_left);
+  }
 }
 
 static void test_compare(void) {
@@ -138,6 +156,56 @@ static void test_select(void) {
 
   CHECK(bls_select("bls/sortkey/", &e) == 1);
   CHECK(!strcmp(e.id, "a.conf"));
+
+  CHECK(bls_select("bls/counting/", &e) == 1);
+  CHECK(!strcmp(e.id, "deck-1+2-1.conf"));
+  CHECK(bls_select("bls/allbad/", &e) == -1);
+}
+
+static int entry_exists(const char *root, const char *id) {
+  char path[512];
+  snprintf(path, sizeof(path), "%sloader/entries/%s", root, id);
+  return access(path, F_OK) == 0;
+}
+
+static void test_count_boot(void) {
+  static const struct {
+    const char *from, *to;
+  } cases[] = {
+      {"a+3.conf", "a+2-1.conf"},   {"b+10-0.conf", "b+09-1.conf"},
+      {"c+1-9.conf", "c+0-9.conf"}, {"d+2-099.conf", "d+1-100.conf"},
+      {"e.conf", "e.conf"},
+  };
+  char root[64] = "/tmp/bls_test.XXXXXX", path[512];
+  struct bls_entry e = {};
+
+  CHECK(mkdtemp(root) != NULL);
+  strcat(root, "/");
+  snprintf(path, sizeof(path), "%sloader", root);
+  mkdir(path, 0755);
+  strcat(path, "/entries");
+  mkdir(path, 0755);
+
+  for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+    snprintf(path, sizeof(path), "%sloader/entries/%s", root, cases[i].from);
+    fclose(fopen(path, "w"));
+    strcpy(e.id, cases[i].from);
+    CHECK(bls_count_boot(root, &e) == 0);
+    CHECK(!strcmp(e.id, cases[i].to));
+    CHECK(entry_exists(root, cases[i].to));
+    snprintf(path, sizeof(path), "%sloader/entries/%s", root, cases[i].to);
+    unlink(path);
+  }
+
+  strcpy(e.id, "missing+3.conf");
+  CHECK(bls_count_boot(root, &e) < 0);
+  CHECK(!strcmp(e.id, "missing+3.conf"));
+
+  snprintf(path, sizeof(path), "%sloader/entries", root);
+  rmdir(path);
+  snprintf(path, sizeof(path), "%sloader", root);
+  rmdir(path);
+  rmdir(root);
 }
 
 int main(void) {
@@ -145,6 +213,7 @@ int main(void) {
   test_parse();
   test_compare();
   test_select();
+  test_count_boot();
   printf("%s\n", failures ? "FAIL" : "PASS");
   return failures != 0;
 }
