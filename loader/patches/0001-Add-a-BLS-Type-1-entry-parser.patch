+#ifndef BLS_H
+#define BLS_H
+
+#define BLS_MAX_ENTRIES 64
+
+struct bls_entry {
+  char id[256];
+  char title[128];
+  char version[128];
+  char sort_key[128];
+  char machine_id[64];
+  char kernel[256];
+  char initrd[256];
+  char options[2048];
+};
+
+int bls_vercmp(const char *a, const char *b);
+int bls_parse_entry(const char *id, char *text, struct bls_entry *e);
+int bls_compare(const struct bls_entry *a, const struct bls_entry *b);
+int bls_select(const char *root, struct bls_entry *out);
+
+#endif
diff --git a/source/bls.c b/source/bls.c
new file mode 100644
index 0000000..601f698
--- /dev/null
+++ b/source/bls.c
@@ -0,0 +1,290 @@
+#include "bls.h"
+#include <dirent.h>
+#include <fcntl.h>
+#include <fnmatch.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_digit(char c) { return c >= '0' && c <= '9'; }
+
+static int is_alpha(char c) {
+  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+}
+
+static int is_version_char(char c) {
+  return is_digit(c) || is_alpha(c) || c == '~' || c == '-' || c == '^' ||
+         c == '.';
+}
+
+// Skips one separator on both sides, or orders the side that lacks it higher.
+static int skip_separator(const char **a, const char **b, char sep) {
+  if (**a != sep && **b != sep)
+    return 0;
+  if (**a != sep)
+    return 1;
+  if (**b != sep)
+    return -1;
+  (*a)++;
+  (*b)++;
+  return 0;
+}
+
+// Mirrors systemd's strverscmp_improved() so the loader orders entries the
+// same way bootctl and systemd-analyze compare-versions do.
+int bls_vercmp(const char *a, const char *b) {
+  for (;;) {
+    const char *end_a, *end_b;
+    int r;
+
+    while (*a && !is_version_char(*a))
+      a++;
+    while (*b && !is_version_char(*b))
+      b++;
+
+    if ((r = skip_separator(&a, &b, '~')))
+      return r;
+    if (!*a || !*b)
+      return (*a != '\0') - (*b != '\0');
+    if ((r = skip_separator(&a, &b, '-')) ||
+        (r = skip_separator(&a, &b, '^')) || (r = skip_separator(&a, &b, '.')))
+      return r;
+
+    if (is_digit(*a) || is_digit(*b)) {
+      for (end_a = a; is_digit(*end_a); end_a++)
+        ;
+      for (end_b = b; is_digit(*end_b); end_b++)
+        ;
+      // Unlike the UAPI.10 text, systemd orders a missing number below 0.
+      if ((a != end_a) != (b != end_b))
+        return a != end_a ? 1 : -1;
+      while (*a == '0')
+        a++;
+      while (*b == '0')
+        b++;
+      if (end_a - a != end_b - b)
+        return end_a - a < end_b - b ? -1 : 1;
+      if ((r = memcmp(a, b, end_a - a)))
+        return r < 0 ? -1 : 1;
+    } else {
+      for (end_a = a; is_alpha(*end_a); end_a++)
+        ;
+      for (end_b = b; is_alpha(*end_b); end_b++)
+        ;
+      size_t len_a = end_a - a, len_b = end_b - b;
+      if ((r = memcmp(a, b, len_a < len_b ? len_a : len_b)))
+        return r < 0 ? -1 : 1;
+      if (len_a != len_b)
+        return len_a < len_b ? -1 : 1;
+    }
+    a = end_a;
+    b = end_b;
+  }
+}
+
+// Entries are edited on Windows too, so trailing CR and blanks are dropped.
+static int next_key(char **cursor, char **key, char **value) {
+  while (**cursor) {
+    char *line = *cursor;
+    size_t len = strcspn(line, "\n");
+    *cursor = line + len + (line[len] == '\n');
+    line[len] = '\0';
+    while (len > 0 && strchr(" \t\r", line[len - 1]))
+      line[--len] = '\0';
+    line += strspn(line, " \t");
+    if (*line == '\0' || *line == '#')
+      continue;
+    *key = line;
+    line += strcspn(line, " \t");
+    if (*line)
+      *line++ = '\0';
+    *value = line + strspn(line, " \t");
+    return 1;
+  }
+  return 0;
+}
+
+static int set_field(char *dst, size_t size, const char *value) {
+  if (strlen(value) >= size)
+    return -1;
+  strcpy(dst, value);
+  return 0;
+}
+
+int bls_parse_entry(const char *id, char *text, struct bls_entry *e) {
+  char *key, *value;
+  int initrds = 0;
+
+  memset(e, 0, sizeof(*e));
+  if (set_field(e->id, sizeof(e->id), id) < 0) {
+    printf("BLS entry %s: file name too long\n", id);
+    return -1;
+  }
+
+  while (next_key(&text, &key, &value)) {
+    int r = 0;
+    if (!strcmp(key, "title"))
+      r = set_field(e->title, sizeof(e->title), value);
+    else if (!strcmp(key, "version"))
+      r = set_field(e->version, sizeof(e->version), value);
+    else if (!strcmp(key, "sort-key"))
+      r = set_field(e->sort_key, sizeof(e->sort_key), value);
+    else if (!strcmp(key, "machine-id"))
+      r = set_field(e->machine_id, sizeof(e->machine_id), value);
+    else if (!strcmp(key, "linux"))
+      r = set_field(e->kernel, sizeof(e->kernel), value);
+    else if (!strcmp(key, "initrd")) {
+      if (++initrds > 1) {
+        printf("BLS entry %s: only one initrd is supported\n", id);
+        return -1;
+      }
+      r = set_field(e->initrd, sizeof(e->initrd), value);
+    } else if (!strcmp(key, "options") && *value) {
+      size_t len = strlen(e->options);
+      if (len + (len > 0) + strlen(value) >= sizeof(e->options))
+        r = -1;
+      else
+        sprintf(e->options + len, "%s%s", len > 0 ? " " : "", value);
+    }
+    if (r < 0) {
+      printf("BLS entry %s: %s is too long\n", id, key);
+      return -1;
+    }
+  }
+
+  if (!e->kernel[0] || !e->initrd[0]) {
+    printf("BLS entry %s: needs both linux and initrd\n", id);
+    return -1;
+  }
+  return 0;
+}
+
+static int has_conf_suffix(const char *name) {
+  size_t len = strlen(name);
+  return len > 5 && !strcmp(name + len - 5, ".conf");
+}
+
+static void strip_conf_suffix(char *dst, const char *id) {
+  size_t len = strlen(id);
+  if (has_conf_suffix(id))
+    len -= 5;
+  memcpy(dst, id, len);
+  dst[len] = '\0';
+}
+
+int bls_compare(const struct bls_entry *a, const struct bls_entry *b) {
+  char name_a[sizeof(a->id)], name_b[sizeof(b->id)];
+  int r;
+
+  if (a->sort_key[0] && b->sort_key[0]) {
+    if ((r = strcmp(a->sort_key, b->sort_key)))
+      return r;
+    if ((r = strcmp(a->machine_id, b->machine_id)))
+      return r;
+    if ((r = bls_vercmp(b->version, a->version)))
+      return r;
+  } else if (a->sort_key[0] || b->sort_key[0]) {
+    return a->sort_key[0] ? -1 : 1;
+  }
+
+  strip_conf_suffix(name_a, a->id);
+  strip_conf_suffix(name_b, b->id);
+  return bls_vercmp(name_b, name_a);
+}
+
+static int compare_entries(const void *a, const void *b) {
+  return bls_compare(a, b);
+}
+
+static int read_text(const char *path, char *buf, size_t size) {
+  int fd = open(path, O_RDONLY);
+  if (fd < 0)
+    return -1;
+  ssize_t r = read(fd, buf, size);
+  close(fd);
+  if (r < 0 || (size_t)r == size)
+    return -1;
+  buf[r] = '\0';
+  return 0;
+}
+
+static int read_default(const char *root, char *pattern, size_t size) {
+  char path[512], buf[4096];
+  char *cursor = buf, *key, *value;
+
+  snprintf(path, sizeof(path), "%sloader/loader.conf", root);
+  if (read_text(path, buf, sizeof(buf)) < 0)
+    return 0;
+  while (next_key(&cursor, &key, &value))
+    if (!strcmp(key, "default") && *value)
+      return set_field(pattern, size, value) == 0;
+  return 0;
+}
+
+static int matches_default(const char *pattern, const char *id) {
+  char name[256];
+
+  if (fnmatch(pattern, id, 0) == 0)
+    return 1;
+  strip_conf_suffix(name, id);
+  return fnmatch(pattern, name, 0) == 0;
+}
+
+// Returns 1 with *out set, 0 when there are no entries, -1 when none is valid.
+int bls_select(const char *root, struct bls_entry *out) {
+  char path[512], pattern[256], text[8192];
+  struct dirent *de;
+  int found = 0, n = 0, chosen = 0;
+
+  snprintf(path, sizeof(path), "%sloader/entries", root);
+  DIR *dir = opendir(path);
+  if (dir == NULL)
+    return 0;
+
+  struct bls_entry *entries = malloc(BLS_MAX_ENTRIES * sizeof(*entries));
+  if (entries == NULL) {
+    closedir(dir);
+    printf("Could not allocate BLS entries\n");
+    return -1;
+  }
+
+  while ((de = readdir(dir)) != NULL) {
+    // macOS leaves ._name.conf AppleDouble files on FAT.
+    if (de->d_name[0] == '.' || !has_conf_suffix(de->d_name))
+      continue;
+    found = 1;
+    if (n == BLS_MAX_ENTRIES) {
+      printf("BLS entry %s: more than %d entries, skipped\n", de->d_name,
+             BLS_MAX_ENTRIES);
+      continue;
+    }
+    snprintf(path, sizeof(path), "%sloader/entries/%s", root, de->d_name);
+    if (read_text(path, text, sizeof(text)) < 0) {
+      printf("BLS entry %s: could not read\n", de->d_name);
+      continue;
+    }
+    if (bls_parse_entry(de->d_name, text, &entries[n]) == 0)
+      n++;
+  }
+  closedir(dir);
+
+  if (n == 0) {
+    free(entries);
+    return found ? -1 : 0;
+  }
+
+  qsort(entries, n, sizeof(*entries), compare_entries);
+  if (read_default(root, pattern, sizeof(pattern))) {
+    for (int i = 0; i < n; i++) {
+      if (matches_default(pattern, entries[i].id)) {
+        chosen = i;
+        break;
+      }
+    }
+  }
+
+  *out = entries[chosen];
+  free(entries);
+  return 1;
+}
