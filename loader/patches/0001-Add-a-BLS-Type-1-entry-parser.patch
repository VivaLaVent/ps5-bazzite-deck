diff --git a/tests/bls_test.c b/tests/bls_test.c
new file mode 100644
index 0000000..5715e9c
--- /dev/null
+++ b/tests/bls_test.c
@@ -0,0 +1,150 @@
+#include "bls.h"
+#include <stdio.h>
+#include <string.h>
+
+static int failures;
+
+#define CHECK(cond)                                                            \
+  do {                                                                         \
+    if (!(cond)) {                                                             \
+      printf("%s:%d: CHECK(%s) failed\n", __FILE__, __LINE__, #cond);          \
+      failures++;                                                              \
+    }                                                                          \
+  } while (0)
+
+static int sign(int r) { return (r > 0) - (r < 0); }
+
+static void test_vercmp(void) {
+  static const struct {
+    const char *a, *b;
+    int expect;
+  } cases[] = {
+      {"11", "11", 0},
+      {"systemd-123", "systemd-123", 0},
+      {"bar-123", "foo-123", -1},
+      {"123a", "123", 1},
+      {"123.a", "123", 1},
+      {"123.a", "123.b", -1},
+      {"123a", "123.a", 1},
+      {"11\xce\xb1", "11\xce\xb2", 0},
+      {"B", "a", -1},
+      {"", "0", -1},
+      {"0.", "0", 1},
+      {"0.0", "0", 1},
+      {"0", "~", 1},
+      {"", "~", 1},
+      {"1_", "1", 0},
+      {"_1", "1", 0},
+      {"1_", "1.2", -1},
+      {"1_2_3", "1.3.3", 1},
+      {"1+", "1", 0},
+      {"+1", "1", 0},
+      {"1+", "1.2", -1},
+      {"1+2+3", "1.3.3", 1},
+      {"010", "10", 0},
+      {"ostree-10", "ostree-9", 1},
+  };
+  static const char *chain[] = {
+      "122.1",   "123~rc1-1", "123",     "123-a",   "123-a.1", "123-1",
+      "123-1.1", "123^post1", "123.a-1", "123.1-1", "123a-1",  "124-1",
+  };
+
+  for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+    int r = sign(bls_vercmp(cases[i].a, cases[i].b));
+    if (r != cases[i].expect)
+      printf("vercmp('%s', '%s') = %d, want %d\n", cases[i].a, cases[i].b, r,
+             cases[i].expect);
+    CHECK(r == cases[i].expect);
+    CHECK(sign(bls_vercmp(cases[i].b, cases[i].a)) == -cases[i].expect);
+  }
+
+  size_t n = sizeof(chain) / sizeof(chain[0]);
+  for (size_t i = 0; i < n; i++)
+    for (size_t j = 0; j < n; j++)
+      CHECK(sign(bls_vercmp(chain[i], chain[j])) == sign((int)i - (int)j));
+}
+
+static void test_parse(void) {
+  struct bls_entry e;
+  char text[4096];
+
+  strcpy(text, "# comment\r\n"
+               "title  Bazzite Deck \r\n"
+               "\r\n"
+               "options root=UUID=1234 rw\r\n"
+               "options   quiet\r\n"
+               "options\r\n"
+               "devicetree ignored.dtb\r\n"
+               "linux /ostree/a/vmlinuz\r\n"
+               "initrd /ostree/a/initramfs.img");
+  CHECK(bls_parse_entry("a.conf", text, &e) == 0);
+  CHECK(!strcmp(e.id, "a.conf"));
+  CHECK(!strcmp(e.title, "Bazzite Deck"));
+  CHECK(!strcmp(e.options, "root=UUID=1234 rw quiet"));
+  CHECK(!strcmp(e.kernel, "/ostree/a/vmlinuz"));
+  CHECK(!strcmp(e.initrd, "/ostree/a/initramfs.img"));
+
+  strcpy(text, "linux /a\n");
+  CHECK(bls_parse_entry("noinitrd.conf", text, &e) < 0);
+
+  strcpy(text, "linux /a\ninitrd /b\ninitrd /c\n");
+  CHECK(bls_parse_entry("twoinitrd.conf", text, &e) < 0);
+
+  char opts[2100];
+  memset(opts, 'x', sizeof(opts) - 1);
+  opts[sizeof(opts) - 1] = '\0';
+  snprintf(text, sizeof(text), "linux /a\ninitrd /b\noptions %s\n", opts);
+  CHECK(bls_parse_entry("longopts.conf", text, &e) < 0);
+
+  opts[2047] = '\0';
+  snprintf(text, sizeof(text), "linux /a\ninitrd /b\noptions %s\n", opts);
+  CHECK(bls_parse_entry("maxopts.conf", text, &e) == 0);
+  CHECK(strlen(e.options) == 2047);
+}
+
+static void test_compare(void) {
+  struct bls_entry a = {}, b = {};
+
+  strcpy(a.id, "z.conf");
+  strcpy(a.sort_key, "fedora");
+  strcpy(b.id, "a-99.conf");
+  CHECK(bls_compare(&a, &b) < 0);
+
+  strcpy(b.sort_key, "fedora");
+  strcpy(a.version, "6.1");
+  strcpy(b.version, "6.10");
+  CHECK(bls_compare(&a, &b) > 0);
+
+  strcpy(a.machine_id, "aaaa");
+  CHECK(bls_compare(&a, &b) > 0);
+}
+
+static void test_select(void) {
+  struct bls_entry e;
+
+  CHECK(bls_select("bls/missing/", &e) == 0);
+  CHECK(bls_select("bls/noconf/", &e) == 0);
+  CHECK(bls_select("bls/invalid/", &e) == -1);
+
+  CHECK(bls_select("bls/ostree/", &e) == 1);
+  CHECK(!strcmp(e.id, "ostree-2.conf"));
+  CHECK(!strcmp(e.title, "Bazzite Deck 43.20261102.0 (ostree:0)"));
+
+  CHECK(bls_select("bls/default/", &e) == 1);
+  CHECK(!strcmp(e.id, "ostree-1.conf"));
+
+  CHECK(bls_select("bls/nomatch/", &e) == 1);
+  CHECK(!strcmp(e.id, "ostree-2.conf"));
+
+  CHECK(bls_select("bls/sortkey/", &e) == 1);
+  CHECK(!strcmp(e.id, "a.conf"));
+}
+
+int main(void) {
+  test_vercmp();
+  test_parse();
+  test_compare();
+  test_select();
+  printf("%s\n", failures ? "FAIL" : "PASS");
+  return failures != 0;
+}
