# the FAT partition the PS5 loader reads: an EFI system partition, or labelled "boot"
SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="vfat", ENV{ID_PART_ENTRY_TYPE}=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b", SYMLINK+="ps5-boot"
SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="vfat", ENV{ID_FS_LABEL}=="boot", SYMLINK+="ps5-boot"
