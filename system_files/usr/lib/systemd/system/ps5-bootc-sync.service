[Unit]
Description=Point the PS5 loader's boot partition at the current bootc deployment
Documentation=file:///usr/bin/ps5-bootc-sync
# Start: after a rollback or a fresh install. Stop: after ostree-finalize-staged.service
# has written the boot entry for an update staged with `bootc upgrade` (units stop in
# reverse start order, so Before= here means our ExecStop runs after its ExecStop).
DefaultDependencies=no
RequiresMountsFor=/boot /boot/efi
After=local-fs.target
Before=ostree-finalize-staged.service sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ps5-bootc-sync
ExecStop=/usr/bin/ps5-bootc-sync
TimeoutStopSec=5min

[Install]
WantedBy=sysinit.target
