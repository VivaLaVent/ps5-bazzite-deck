#!/bin/bash
# ps5-linux-image's grow-rootfs, except that on bootc the root partition is /sysroot
set -eu
DEV=$(findmnt -no SOURCE /sysroot)
DISK=/dev/$(lsblk -ndo PKNAME "$DEV")
PART=$(cat "/sys/class/block/$(basename "$DEV")/partition")
growpart "$DISK" "$PART" || true   # exits 1 when there is nothing to grow
resize2fs "$DEV"
